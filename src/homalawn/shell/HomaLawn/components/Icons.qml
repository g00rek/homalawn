  readonly property int menu: 0xF035C
  readonly property int phone: 0xF011C
  readonly property int add: 0xF0415
  readonly property int overview: 0xF02FD      // information-outline
  readonly property int home: 0xF02DC
  readonly property int look: 0xF027C          // format_paint (paint roller)
  readonly property int search: 0xF0349        // magnify
  readonly property int history: 0xF02DA
  readonly property int agents: 0xF06A9        // robot
  readonly property int settings: 0xF0493      // cog
  readonly property int check: 0xF012C
  readonly property int close: 0xF0156
  readonly property int chevronDown: 0xF0140
  readonly property int chevronUp: 0xF0143
}
