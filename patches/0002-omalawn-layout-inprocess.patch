+++ b/lawnchair/src/com/android/launcher3/model/OmalawnDbAccess.java
@@ -0,0 +1,29 @@
+package com.android.launcher3.model;
+
+import android.content.ContentValues;
+
+import com.android.launcher3.LauncherSettings.Favorites;
+
+/**
+ * omalawn: reaches {@link ModelDbController#mOpenHelper} (protected, so only from this package)
+ * after {@code app.lawnchair.omalawn.LayoutIo} has replaced every favorites row in one transaction.
+ */
+public final class OmalawnDbAccess {
+    private OmalawnDbAccess() {
+    }
+
+    /**
+     * Runs on the model thread right after the replace commits. Does what
+     * {@link DatabaseHelper#dbInsertAndCheck} and {@link ModelDbController#insert} do for every
+     * single insert: raises the cached max item id (so ids handed out later never collide with an
+     * imported row; it only ever raises) and drops the hybrid-hotseat restore table.
+     */
+    public static void afterBulkReplace(ModelDbController controller, int maxId) {
+        controller.getDb(); // opens mOpenHelper if this process has not touched the DB yet
+        DatabaseHelper helper = controller.mOpenHelper;
+        helper.onAddOrDeleteOp(helper.getWritableDatabase());
+        ContentValues v = new ContentValues();
+        v.put(Favorites._ID, maxId);
+        helper.checkId(v);
+    }
+}
