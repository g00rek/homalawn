+    /** The keyguard shows or the screen is off: a silent install now may not finish. */
+    fun locked(ctx: Context): Boolean {
+        val km = ctx.getSystemService(KeyguardManager::class.java)
+        val pm = ctx.getSystemService(PowerManager::class.java)
+        return km?.isKeyguardLocked == true || pm?.isInteractive == false
+    }
+
+    /**
+     * The phone was unlocked (or its screen came on without a keyguard): commits a deferred
+     * session. After a restart of this process the session is gone from memory; then the kept
+     * checked APK is checked again and goes into a new session. Off the main thread.
+     */
+    fun onUnlock(ctx: Context) {
+        val app = ctx.applicationContext
+        if (locked(app)) return
+        // taken under the lock, so a second unlock signal (USER_PRESENT after SCREEN_ON) finds nothing
+        val (p, saved) = synchronized(lock) {
+            val p = pendingCommit?.takeIf { it.deferred }?.also { pendingCommit = null }
+            val saved = deferredRecord(app)
+            if (p == null && saved == null) return
+            clearDeferred(app)
+            p to saved
+        }
+        Thread({
+            try {
+                if (p != null) {
+                    p.deferred = false
+                    Log.i(TAG, "phone unlocked: committing install session ${p.id} (${p.version})")
+                    commit(app, p)
+                    return@Thread
+                }
+                val (sha, version, computer) = saved!!
+                val apk = pending(app, sha)
+                if (apk == null) {
+                    Log.w(TAG, "phone unlocked: the deferred update $version is no longer on the phone")
+                    record(app, FAILED, version, sha, "the update waiting for the unlock was lost; send it again")
+                    return@Thread
+                }
+                Log.i(TAG, "phone unlocked: installing the deferred update $version again (new session)")
+                val info = check(app, apk)
+                prepareSession(app, apk, sha, info, computer)
+                commitPending(app)
+            } catch (e: Throwable) {
+                Log.w(TAG, "the deferred update could not be installed", e)
+                val (sha, version, computer) = saved ?: Triple(p!!.sha, p.version, p.computer)
+                failed(app, sha, version, computer, "${e.javaClass.simpleName}: ${e.message}")
+            }
+        }, "omalawn-update-unlock").start()
+    }
+
+    private fun statusPrefs(ctx: Context) = ctx.getSharedPreferences(STATUS_PREFS, Context.MODE_PRIVATE)
+
+    private fun saveDeferred(ctx: Context, sha: String, version: String, computer: String) {
+        statusPrefs(ctx).edit().putString("deferred_sha", sha).putString("deferred_version", version)
+            .putString("deferred_computer", computer).commit()
+    }
+
+    private fun clearDeferred(ctx: Context) {
+        statusPrefs(ctx).edit().remove("deferred_sha").remove("deferred_version").remove("deferred_computer").commit()
+    }
+
+    private fun deferredRecord(ctx: Context): Triple<String, String, String>? {
+        val p = statusPrefs(ctx)
+        val sha = p.getString("deferred_sha", null) ?: return null
+        return Triple(sha, p.getString("deferred_version", "") ?: "", p.getString("deferred_computer", "") ?: "")
+    }
+
+    /** Keeps the newest outcome of an offered update for `launcher.update_status`. */
+    fun record(ctx: Context, outcome: String, version: String, sha: String, reason: String?) {
+        runCatching {
+            statusPrefs(ctx).edit()
+                .putString("outcome", outcome)
+                .putString("version", version)
+                .putString("sha256", sha)
+                .putString("reason", reason)
+                .putLong("at", System.currentTimeMillis())
+                .commit()
+        }
+    }
+
+    /** This app was replaced: a session that was installing (its status may never arrive) installed. */
+    fun replaced(ctx: Context) {
+        val p = statusPrefs(ctx)
+        if (p.getString("outcome", null) == INSTALLING) {
+            val pi = ctx.packageManager.getPackageInfo(ctx.packageName, 0)
+            record(ctx, INSTALLED, pi.versionName ?: "", p.getString("sha256", "") ?: "", null)
+        }
+        clearDeferred(ctx)
+    }
+
+    /** Debug hook: forgets the last outcome. */
+    fun clearStatus(ctx: Context) {
+        statusPrefs(ctx).edit().clear().commit()
+    }
+
+    /**
+     * `launcher.update_status`: the last outcome of an offered update — `none`, `deferred` (waits
+     * for the unlock), `installing` (committed, Android has not answered), `installed`,
+     * `pending_user_action` (the notification waits for a tap) or `failed` with a reason.
+     */
+    fun status(ctx: Context): JSONObject {
+        val p = statusPrefs(ctx)
+        val o = JSONObject()
+            .put("outcome", p.getString("outcome", null) ?: "none")
+            .put("version", p.getString("version", "") ?: "")
+            .put("sha256", p.getString("sha256", "") ?: "")
+            .put("at", p.getLong("at", 0L))
+            .put("locked", locked(ctx))
+        p.getString("reason", null)?.let { o.put("reason", it) }
+        return o
+    }
+
     private fun giveUpIfStuck(ctx: Context, p: PendingCommit) {
         val installer = ctx.packageManager.packageInstaller
         // Android answered (a pending user action included: that session waits for the tap)
@@ -307,12 +470,14 @@ object OmalawnUpdate {
 
