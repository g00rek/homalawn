diff --git a/lawnchair/src/app/lawnchair/omalawn/LookBook.kt b/lawnchair/src/app/lawnchair/omalawn/LookBook.kt
new file mode 100644
index 0000000000..fe35b85a22
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/LookBook.kt
@@ -0,0 +1,389 @@
+// Adapted from Flux (https://github.com/bjarneo/flux), MIT License, Copyright (c) 2026 Bjarne Oeverli
+// (android/.../theme/ThemeBook.kt and core/ComputerThemes.kt): one look per computer, the last
+// change, the scope. Differences: a look's time is the computer's changed_at (clamped to now), not
+// its arrival; looks carry the colour settings and pictures, and show() puts one on the screen.
+package app.lawnchair.omalawn
+
+import android.app.WallpaperManager
+import android.content.Context
+import app.lawnchair.omalawn.link.LinkServer
+import app.lawnchair.omalawn.link.Pins
+import java.io.File
+import java.util.UUID
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * The look of every paired computer (spec section 6). files/omalawn/looks/book.json holds
+ * {scope, last, applied, computers: {fp: {key, changed_at, theme, prefs, parts, sent}}};
+ * looks/<fp>/<part>.img the pictures. Source = scope, else last. No book.json is an empty book; one
+ * that cannot be read is an error every caller sees (look_book_unreadable), never an empty book.
+ */
+object LookBook {
+    /**
+     * [parts] are the pictures held for this computer, a subset of [PARTS]; [sent] those its last
+     * put brought, which are all a `look_show` sets (a local show sets every part).
+     */
+    data class Entry(
+        val fp: String,
+        val key: String,
+        val changedAt: Long,
+        val theme: String,
+        val prefs: JSONArray,
+        val parts: Set<String>,
+        val sent: Set<String> = parts,
+    )
+
+    data class Applied(val fp: String, val key: String, val at: Long, val systemId: Int, val lockId: Int)
+
+    val PARTS = setOf("home", "lock")
+    private val SENT_PARTS = PARTS + "both" // look_put's pictures: "both" is one picture for home and lock
+    private const val BOOK = "book.json"
+    const val UNREADABLE = "look_book_unreadable"
+    private val KEY = Regex("[0-9a-f]{16}")
+
+    private val lock = Any()
+    private var loaded = false
+    private var listening = false
+    private val entries = LinkedHashMap<String, Entry>()
+    private var last: String? = null
+    private var scope: String? = null
+    private var applied: Applied? = null
+    private val _changes = MutableStateFlow(0)
+    val changes: StateFlow<Int> = _changes.asStateFlow()
+
+    fun dir(ctx: Context) = File(OmalawnCommands.privateDir(ctx), "looks").apply { mkdirs() }
+
+    /** Where [fp]'s [part] picture lives. Loads the book first, so its clean-up of unknown folders never meets a picture written for the put that follows. */
+    fun picture(ctx: Context, fp: String, part: String): File = synchronized(lock) {
+        load(ctx)
+        File(File(dir(ctx), fp), "$part.img")
+    }
+
+    /** Runs [body] and keeps its changes only if it returns normally (it ends with [save]); otherwise memory goes back to what the disk holds. */
+    private inline fun <T> change(ctx: Context, body: () -> T): T {
+        load(ctx)
+        val before = Triple(LinkedHashMap(entries), last, scope)
+        val was = applied
+        val result = try {
+            body()
+        } catch (t: Throwable) {
+            entries.clear()
+            entries.putAll(before.first)
+            last = before.second
+            scope = before.third
+            applied = was
+            throw t
+        }
+        // the look now comes from another computer: what the old one's wallpaper choice waits for is void (spec 6.5)
+        val from = before.third ?: before.second
+        if (from != null && from != (scope ?: last)) ThemeWallpapers.drop(ctx, from)
+        return result
+    }
+
+    /**
+     * Stores [e] as the look of its computer; true when the book changed. A put naming only some
+     * parts keeps the stored pictures of the parts it does not name (the entry's parts are the union).
+     */
+    fun put(ctx: Context, e: Entry, now: Long = System.currentTimeMillis()): Boolean = synchronized(lock) {
+        change(ctx) { putLocked(ctx, e, now) }
+    }
+
+    private fun putLocked(ctx: Context, e: Entry, now: Long): Boolean {
+        val old = entries[e.fp]
+        if (old?.key == e.key) {
+            val parts = e.parts + old.parts
+            if (last != null && parts == old.parts && e.sent == old.sent) return false
+            entries[e.fp] = old.copy(parts = parts, sent = e.sent)
+            if (last == null) last = e.fp
+            save(ctx)
+            return true
+        }
+        val entry = e.copy(changedAt = e.changedAt.coerceAtMost(now), parts = e.parts + (old?.parts ?: emptySet()))
+        entries.remove(e.fp)
+        entries[e.fp] = entry
+        val cur = last?.let { entries[it] }
+        val takes = when {
+            last == null || last == e.fp -> true
+            old == null -> false // a new computer does not take over
+            else -> entry.changedAt >= (cur?.changedAt ?: Long.MIN_VALUE)
+        }
+        if (takes) last = e.fp
+        save(ctx)
+        return true
+    }
+
+    /** The computer is no longer paired (forgotten or unpaired itself): its look and pictures go. */
+    fun forget(ctx: Context, fp: String) = synchronized(lock) {
+        change(ctx) { forgetLocked(ctx, fp) }
+    }
+
+    private fun forgetLocked(ctx: Context, fp: String) {
+        if (entries.remove(fp) == null) {
+            if (scope == fp) {
+                scope = null
+                save(ctx)
+            }
+            return
+        }
+        File(dir(ctx), fp).deleteRecursively()
+        if (last == fp) last = entries.values.maxByOrNull { it.changedAt }?.fp
+        if (scope == fp) scope = null
+        // `applied` stays even when it names fp: the screen still shows that look until the next show
+        save(ctx)
+    }
+
+    /** [fp] must be a paired computer (or null = latest change). */
+    fun setScope(ctx: Context, fp: String?) = synchronized(lock) {
+        change(ctx) {
+            require(fp == null || Pins.isPinned(ctx, fp)) { "not a paired computer" }
+            scope = fp
+            save(ctx)
+        }
+    }
+
+    fun scope(ctx: Context) = synchronized(lock) { load(ctx); scope }
+    fun last(ctx: Context) = synchronized(lock) { load(ctx); last }
+    fun source(ctx: Context) = synchronized(lock) { load(ctx); scope ?: last }
+    fun entry(ctx: Context, fp: String) = synchronized(lock) { load(ctx); entries[fp] }
+    fun applied(ctx: Context) = synchronized(lock) { load(ctx); applied }
+
+    internal fun setApplied(ctx: Context, a: Applied?) = synchronized(lock) {
+        change(ctx) {
+            applied = a
+            save(ctx)
+        }
+    }
+
+    /**
+     * The screen was written by something other than [show] (a link or adb wallpaper_set,
+     * pref_set, prefs_set_many or wallpaper_lock_reset; undo uses them): `applied` means "the screen
+     * holds exactly this look", so it goes, and the next put of that look is shown again. An
+     * unreadable book has no `applied` to clear (only reset leaves that state, and reset clears
+     * everything), so the write goes ahead; the look commands still report it.
+     */
+    fun screenWritten(ctx: Context) = synchronized(lock) {
+        try {
+            load(ctx)
+        } catch (e: OmalawnError) {
+            if (e.code == UNREADABLE) return@synchronized
+            throw e
+        }
+        if (applied != null) setApplied(ctx, null)
+    }
+
+    /** An empty book, no pictures (also out of an unreadable one, so it does not load it): "Forget all computers" and the tests. */
+    internal fun reset(ctx: Context) = synchronized(lock) {
+        listen(ctx)
+        entries.clear()
+        last = null
+        scope = null
+        applied = null
+        dir(ctx).listFiles()?.forEach { it.deleteRecursively() }
+        loaded = true
+        save(ctx)
+    }
+
+    /** Test hook: book.json becomes unreadable and memory forgets it, as a new process would; open screens are told. */
+    internal fun corrupt(ctx: Context) = synchronized(lock) {
+        File(dir(ctx), BOOK).writeText("{not json")
+        entries.clear()
+        last = null
+        scope = null
+        applied = null
+        loaded = false
+        _changes.value++ // screens that are open read the book again
+    }
+
+    /**
+     * `launcher.look_put` from the paired computer [fp] (spec 6.2): moves the staged pictures into
+     * looks/<fp>/ and stores the look; never touches the screen. `show` is true when [fp] is the
+     * source and this look is not the one on the screen.
+     */
+    fun putFromLink(ctx: Context, fp: String, p: JSONObject): JSONObject {
+        val key = p.optString("key").takeIf { KEY.matches(it) }
+            ?: throw OmalawnError(LinkServer.BAD_PARAMS, "${LinkServer.BAD_PARAMS}: key must be 16 lowercase hex characters")
+        val prefs = p.optJSONArray("prefs") ?: JSONArray()
+        try {
+            OmalawnCommands.checkPrefWrites(prefs)
+        } catch (e: Exception) {
+            throw OmalawnError(LinkServer.BAD_PARAMS, "${LinkServer.BAD_PARAMS}: prefs: ${e.message}")
+        }
+        val pics = p.optJSONObject("pictures") ?: JSONObject()
+        val staged = pics.keys().asSequence().toList().associateWith { part ->
+            if (part !in SENT_PARTS) throw OmalawnError(LinkServer.BAD_PARAMS, "${LinkServer.BAD_PARAMS}: pictures.$part")
+            File(pics.optString(part)).canonicalFile.also {
+                if (it.parentFile != OmalawnCommands.privateDir(ctx).canonicalFile || !it.isFile) {
+                    throw OmalawnError(LinkServer.BAD_PATH, "${LinkServer.BAD_PATH}: stage pictures with launcher.stage_file")
+                }
+            }
+        }
+        val parts = mutableSetOf<String>()
+        for ((part, src) in staged) {
+            val targets = if (part == "both") PARTS else setOf(part)
+            targets.forEach { t -> src.copyTo(picture(ctx, fp, t).apply { parentFile?.mkdirs() }, overwrite = true) }
+            src.delete()
+            parts += targets
+        }
+        put(ctx, Entry(fp, key, p.optLong("changed_at"), p.optString("theme").take(120), prefs, parts))
+        val src = source(ctx)
+        val show = src == fp && applied(ctx)?.let { it.fp == fp && it.key == key } != true
+        return JSONObject().put("stored", true).put("show", show)
+            .put("source", src?.let { who(ctx, it) } ?: JSONObject.NULL)
+            .put("scope", if (scope(ctx) == null) "latest" else "chosen")
+    }
+
+    /** `launcher.look_show`: [fp]'s look goes on the screen, if [fp] is still the source and its key the stored one. */
+    fun showFromLink(ctx: Context, fp: String, p: JSONObject): JSONObject {
+        if (source(ctx) != fp) throw OmalawnError("not_source", "not_source: the phone shows another computer's look now")
+        val e = entry(ctx, fp)
+        if (e?.key != p.optString("key")) throw OmalawnError("stale_key", "stale_key: send look_put again")
+        show(ctx, fp, e.sent)
+        return JSONObject().put("shown", true)
+    }
+
+    /**
+     * The one way a look reaches the screen (spec 6.3): its settings in one commit, then the home
+     * picture, then the lock one; [parts] limits the pictures (a `look_show` sets those its put sent).
+     */
+    fun show(ctx: Context, fp: String, parts: Set<String>? = null): Applied {
+        val e = entry(ctx, fp) ?: throw OmalawnError("no_look", "no_look: this computer has sent no look")
+        val set = parts ?: e.parts
+        if (e.prefs.length() > 0) OmalawnCommands.applyPrefWrites(ctx, e.prefs) // one commit, one reload
+        val wm = WallpaperManager.getInstance(ctx)
+        var sys = wm.getWallpaperId(WallpaperManager.FLAG_SYSTEM)
+        var lockId = wm.getWallpaperId(WallpaperManager.FLAG_LOCK)
+        if ("home" in set) sys = OmalawnCommands.setWallpaper(ctx, picture(ctx, fp, "home"), WallpaperManager.FLAG_SYSTEM)
+        if ("lock" in set) lockId = OmalawnCommands.setWallpaper(ctx, picture(ctx, fp, "lock"), WallpaperManager.FLAG_LOCK)
+        val a = Applied(fp, e.key, System.currentTimeMillis(), sys, lockId)
+        setApplied(ctx, a)
+        return a
+    }
+
+    /** A local show of [fp]'s look would replace a picture set by something else since the book last showed one. */
+    fun needsReplace(ctx: Context, fp: String): Boolean {
+        val e = entry(ctx, fp) ?: return false
+        val a = applied(ctx) ?: return e.parts.isNotEmpty()
+        val wm = WallpaperManager.getInstance(ctx)
+        return ("home" in e.parts && wm.getWallpaperId(WallpaperManager.FLAG_SYSTEM) != a.systemId) ||
+            ("lock" in e.parts && wm.getWallpaperId(WallpaperManager.FLAG_LOCK) != a.lockId)
+    }
+
+    /** `launcher.look_state` for the calling computer [fp]. */
+    fun state(ctx: Context, fp: String): JSONObject {
+        val a = applied(ctx)
+        val e = entry(ctx, fp)
+        return JSONObject()
+            .put("source", source(ctx)?.let { who(ctx, it) } ?: JSONObject.NULL)
+            .put("scope", if (scope(ctx) == null) "latest" else "chosen")
+            .put("you", JSONObject().put("key", e?.key ?: JSONObject.NULL).put("shown", e != null && a?.fp == fp && a.key == e.key))
+            .put("applied", a?.let { who(ctx, it.fp).put("at", it.at) } ?: JSONObject.NULL)
+    }
+
+    private fun who(ctx: Context, fp: String) = JSONObject().put("fp", fp).put("name", Pins.name(ctx, fp) ?: "")
+
+    fun toJson(ctx: Context): JSONObject = synchronized(lock) {
+        load(ctx)
+        JSONObject().apply {
+            put("scope", scope ?: JSONObject.NULL)
+            put("last", last ?: JSONObject.NULL)
+            put("source", (scope ?: last) ?: JSONObject.NULL)
+            put("now", System.currentTimeMillis())
+            put("applied", applied?.let(::appliedJson) ?: JSONObject.NULL)
+            put(
+                "computers",
+                JSONObject().also { c ->
+                    entries.values.forEach { e ->
+                        c.put(
+                            e.fp,
+                            JSONObject().put("key", e.key).put("changed_at", e.changedAt).put("theme", e.theme)
+                                .put("parts", JSONArray(e.parts.sorted())).put("sent", JSONArray(e.sent.sorted())),
+                        )
+                    }
+                },
+            )
+        }
+    }
+
+    private fun appliedJson(a: Applied) =
+        JSONObject().put("fp", a.fp).put("key", a.key).put("at", a.at).put("system_id", a.systemId).put("lock_id", a.lockId)
+
+    private fun text(o: JSONObject, k: String): String? = if (o.isNull(k)) null else o.optString(k).ifEmpty { null }
+
+    /** The book hears of every removal itself: the Computers screen forgets without the link server. */
+    private fun listen(ctx: Context) {
+        if (listening) return
+        listening = true
+        val app = ctx.applicationContext
+        Pins.onRemoved { fp -> forget(app, fp) }
+    }
+
+    /**
+     * Reads the book once per process; only computers that are still paired are kept, the rest lose
+     * their folders. A book.json that cannot be read throws [UNREADABLE] and stays unloaded, so every
+     * later call says so too.
+     */
+    private fun load(ctx: Context) {
+        if (loaded) return
+        listen(ctx)
+        val f = File(dir(ctx), BOOK)
+        if (!f.exists()) {
+            loaded = true
+            return
+        }
+        val o = try {
+            JSONObject(f.readText())
+        } catch (e: Exception) {
+            throw OmalawnError(UNREADABLE, "$UNREADABLE: the phone's record of computer looks cannot be read (${e.javaClass.simpleName}: ${e.message})")
+        }
+        loaded = true
+        val cs = o.optJSONObject("computers") ?: JSONObject()
+        for (fp in cs.keys().asSequence().toList()) {
+            val c = cs.optJSONObject(fp) ?: continue
+            if (!Pins.isPinned(ctx, fp)) continue
+            fun held(k: String) = c.optJSONArray(k)?.let { a -> (0 until a.length()).map { a.optString(it) } }.orEmpty()
+                .filter { it in PARTS && picture(ctx, fp, it).isFile }.toSet()
+            entries[fp] = Entry(fp, c.optString("key"), c.optLong("changed_at"), c.optString("theme"), c.optJSONArray("prefs") ?: JSONArray(), held("parts"), held("sent"))
+        }
+        dir(ctx).listFiles()?.forEach { if (it.isDirectory && it.name !in entries) it.deleteRecursively() }
+        // the remaining look that changed most recently takes over, as when a computer is forgotten
+        last = text(o, "last")?.takeIf { it in entries } ?: entries.values.maxByOrNull { it.changedAt }?.fp
+        scope = text(o, "scope")?.takeIf { Pins.isPinned(ctx, it) }
+        applied = o.optJSONObject("applied")?.let {
+            Applied(it.optString("fp"), it.optString("key"), it.optLong("at"), it.optInt("system_id"), it.optInt("lock_id"))
+        }
+    }
+
+    private fun save(ctx: Context) {
+        val o = JSONObject().apply {
+            put("scope", scope ?: JSONObject.NULL)
+            put("last", last ?: JSONObject.NULL)
+            put("applied", applied?.let(::appliedJson) ?: JSONObject.NULL)
+            put(
+                "computers",
+                JSONObject().also { c ->
+                    entries.values.forEach { e ->
+                        c.put(
+                            e.fp,
+                            JSONObject().put("key", e.key).put("changed_at", e.changedAt).put("theme", e.theme)
+                                .put("prefs", e.prefs).put("parts", JSONArray(e.parts.sorted()))
+                                .put("sent", JSONArray(e.sent.sorted())),
+                        )
+                    }
+                },
+            )
+        }
+        val f = File(dir(ctx), BOOK)
+        val tmp = File(f.parentFile, ".book-${UUID.randomUUID()}")
+        try {
+            tmp.writeText(o.toString())
+            if (!tmp.renameTo(f)) error("cannot write $BOOK")
+        } finally {
+            tmp.delete()
+        }
+        _changes.value++
+    }
+}
