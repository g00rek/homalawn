diff --git a/lawnchair/src/app/lawnchair/omalawn/SettingsIcon.kt b/lawnchair/src/app/lawnchair/omalawn/SettingsIcon.kt
new file mode 100644
index 0000000000..aa451a83a0
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/SettingsIcon.kt
@@ -0,0 +1,32 @@
+package app.lawnchair.omalawn
+
+import android.content.ComponentName
+import app.lawnchair.LawnchairLauncher
+import app.lawnchair.search.adapter.SearchTargetCompat
+import com.android.launcher3.BuildConfig
+
+/**
+ * The "Homa Lawn" icon in the app drawer (patch 0018): an activity-alias of Lawnchair's settings
+ * screen with the app's own icon and name, like Nova's "Nova Settings". It is only MAIN/LAUNCHER,
+ * never HOME, so the default home app stays the launcher itself.
+ *
+ * Lawnchair drops every search result from its own package (it never wanted itself in search);
+ * [shownInSearch] lets this one alias through.
+ *
+ * The launcher's own home entry (also MAIN/LAUNCHER, so other launchers can start it) is meant to be
+ * hidden from the drawer by `filtered_components`, but that list names `app.lawnchair/...` without
+ * the debug build's `.debug` suffix, so on our build it showed as a second "Homa Lawn" that only
+ * went home. [isHomeEntry] hides it by the real package name.
+ */
+object SettingsIcon {
+    /** The alias in AndroidManifest.xml; also what a home-screen item for it points at. */
+    const val ALIAS = "app.lawnchair.omalawn.HomaLawnSettings"
+
+    @JvmStatic
+    fun isHomeEntry(cn: ComponentName): Boolean =
+        cn.packageName == BuildConfig.APPLICATION_ID && cn.className == LawnchairLauncher::class.java.name
+
+    fun shownInSearch(target: SearchTargetCompat): Boolean =
+        target.resultType == SearchTargetCompat.RESULT_TYPE_APPLICATION &&
+            target.extras.getString("class") == ALIAS
+}
diff --git a/lawnchair/src/app/lawnchair/search/algorithms/LawnchairSearchAlgorithm.kt b/lawnchair/src/app/lawnchair/search/algorithms/LawnchairSearchAlgorithm.kt
index 1212437cc0..dd4d83f92c 100644
--- a/lawnchair/src/app/lawnchair/search/algorithms/LawnchairSearchAlgorithm.kt
+++ b/lawnchair/src/app/lawnchair/search/algorithms/LawnchairSearchAlgorithm.kt
@@ -77,7 +77,7 @@ sealed class LawnchairSearchAlgorithm(
     protected fun transformSearchResults(results: List<SearchTargetCompat>): List<SearchAdapterItem> {
         val filtered = results
             .asSequence()
-            .filter { it.packageName != BuildConfig.APPLICATION_ID }
+            .filter { it.packageName != BuildConfig.APPLICATION_ID || app.lawnchair.omalawn.SettingsIcon.shownInSearch(it) } // patch 0018
             .filter { LawnchairSearchAdapterProvider.viewTypeMap[it.layoutType] != null }
             .removeDuplicateDividers()
             .toList()
diff --git a/src/com/android/launcher3/AppFilter.java b/src/com/android/launcher3/AppFilter.java
index b0b21837fa..8bab757d50 100644
--- a/src/com/android/launcher3/AppFilter.java
+++ b/src/com/android/launcher3/AppFilter.java
@@ -15,6 +15,7 @@ import java.util.stream.Collectors;
 
 import javax.inject.Inject;
 
+import app.lawnchair.omalawn.SettingsIcon;
 import app.lawnchair.preferences2.PreferenceManager2;
 
 /**
@@ -33,6 +34,6 @@ public class AppFilter {
     }
 
     public boolean shouldShowApp(ComponentName app) {
-        return !mFilteredComponents.contains(app);
+        return !mFilteredComponents.contains(app) && !SettingsIcon.isHomeEntry(app); // patch 0018
     }
 }
