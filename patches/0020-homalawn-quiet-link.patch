+package app.lawnchair.omalawn.link
+
+import android.content.Intent
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import app.lawnchair.ui.preferences.components.controls.PreferenceCategory
+import com.android.launcher3.R
+
+/**
+ * "Computers" in Homa Lawn's settings: opens the pairing screen ([PairConfirmActivity.ACTION_WAIT]:
+ * "Waiting for a computer…", pairing open while it shows, and "Forget all computers"). The way in
+ * when the home screen cannot be showing; it was the status notification's "Pair a computer"
+ * until that notification went (2026-10-17).
+ */
+@Composable
+fun HomarComputersEntry() {
+    val ctx = LocalContext.current
+    PreferenceCategory(
+        label = stringResource(R.string.homar_computers_label),
+        description = stringResource(R.string.homar_computers_description),
+        iconResource = R.drawable.homar_ic_computer,
+        onNavigate = {
+            ctx.startActivity(
+                Intent(ctx, PairConfirmActivity::class.java)
+                    .setAction(PairConfirmActivity.ACTION_WAIT)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP),
+            )
+        },
+    )
+}
diff --git a/lawnchair/src/app/lawnchair/omalawn/link/LinkAsks.kt b/lawnchair/src/app/lawnchair/omalawn/link/LinkAsks.kt
new file mode 100644
index 0000000000..16bcff4087
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/link/LinkAsks.kt
@@ -0,0 +1,112 @@
+package app.lawnchair.omalawn.link
+
+import android.annotation.SuppressLint
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.PowerManager
+import android.provider.Settings
+import android.util.Log
+import androidx.core.app.NotificationCompat
+import app.lawnchair.omalawn.HomeRole
+import com.android.launcher3.R
+
+/**
+ * What the person has to do so computers can reach the phone, as one notification that only
+ * exists while something is missing (there is no status notification):
+ * - **Set as home**: Homa Lawn is not the default home app, so Android does not keep its process
+ *   (and the link in it) at home-app priority;
+ * - **Keep connected**: Homa Lawn is under battery optimisation, so the link has no network while
+ *   the phone sleeps (Doze) and Android stops its service once the app is idle.
+ *
+ * Each need is asked once: dismissed, it stays away until that need goes and comes back (or a
+ * new one appears). When nothing is missing any more the notification is removed. Checked when
+ * the link starts in a process and every time the home screen comes to the front.
+ */
+object LinkAsks {
+    private const val TAG = "OmalawnLink"
+    private const val CHANNEL = "omalawn_requests" // the channel of MediaPermission's requests
+    private const val NOTIFICATION_ID = 47103
+    private const val PREFS = "omalawn_link"
+    private const val KEY_ASKED = "asks_posted"
+    const val HOME = "home"
+    const val KEEP = "keep_connected"
+
+    /** The needs right now, in the order they are shown. */
+    fun needs(ctx: Context): List<String> = buildList {
+        if (HomeRole.missing(ctx)) add(HOME)
+        val pm = ctx.getSystemService(PowerManager::class.java)
+        if (pm != null && !pm.isIgnoringBatteryOptimizations(ctx.packageName)) add(KEEP)
+    }
+
+    fun refresh(ctx: Context) {
+        val nm = ctx.getSystemService(NotificationManager::class.java) ?: return
+        val needs = needs(ctx)
+        val prefs = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val asked = prefs.getStringSet(KEY_ASKED, emptySet()).orEmpty()
+        if (needs.isEmpty()) {
+            nm.cancel(NOTIFICATION_ID)
+            if (asked.isNotEmpty()) prefs.edit().remove(KEY_ASKED).apply()
+            return
+        }
+        // a need that went away may be asked again when it comes back
+        val still = asked.intersect(needs.toSet())
+        if (still != asked) prefs.edit().putStringSet(KEY_ASKED, still).apply()
+        if (still.containsAll(needs)) return // asked already (shown, or dismissed by the person)
+        if (NotifyPermission.missing(ctx) || !nm.areNotificationsEnabled()) return // asked once it can show
+        nm.createNotificationChannel(
+            NotificationChannel(CHANNEL, "Homa Lawn requests", NotificationManager.IMPORTANCE_DEFAULT).apply {
+                description = "Permissions Homa Lawn on your computer needs from you"
+            },
+        )
+        nm.notify(NOTIFICATION_ID, build(ctx, needs))
+        prefs.edit().putStringSet(KEY_ASKED, needs.toSet()).apply()
+        Log.i(TAG, "asked for: ${needs.joinToString()}")
+    }
+
+    private fun build(ctx: Context, needs: List<String>): android.app.Notification {
+        val lines = needs.map {
+            when (it) {
+                HOME -> "Make Homa Lawn your home screen: your computer reaches the phone through it."
+                else -> "Let Homa Lawn run in the background, so your computer can reach the phone while it sleeps."
+            }
+        }
+        val title = if (needs.size > 1) {
+            "Homa Lawn needs two settings"
+        } else if (needs[0] == HOME) {
+            "Make Homa Lawn your home screen"
+        } else {
+            "Keep Homa Lawn connected"
+        }
+        val intents = needs.map { intentFor(ctx, it) }
+        val b = NotificationCompat.Builder(ctx, CHANNEL)
+            .setSmallIcon(R.drawable.ic_home_screen)
+            .setContentTitle(title)
+            .setContentText(lines.first())
+            .setStyle(NotificationCompat.BigTextStyle().bigText(lines.joinToString("\n")))
+            .setContentIntent(intents.first())
+            .setAutoCancel(true)
+            .setOnlyAlertOnce(true)
+        needs.forEachIndexed { i, need ->
+            b.addAction(0, if (need == HOME) "Set as home" else "Keep connected", intents[i])
+        }
+        return b.build()
+    }
+
+    private fun intentFor(ctx: Context, need: String): PendingIntent = when (need) {
+        HOME -> PendingIntent.getActivity(
+            ctx,
+            4,
+            HomeRole.requestIntent(ctx),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+        else -> {
+            @SuppressLint("BatteryLife") // sideloaded build; the link must survive Doze
+            val ask = Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, Uri.parse("package:${ctx.packageName}"))
+            PendingIntent.getActivity(ctx, 2, ask, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+        }
+    }
+}
