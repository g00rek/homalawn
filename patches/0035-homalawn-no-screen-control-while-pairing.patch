@@ -0,0 +1,51 @@
+package app.lawnchair.omalawn.link
+
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import androidx.lifecycle.LifecycleOwner
+import app.lawnchair.omalawn.OmalawnError
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * Pairing needs a person's finger, so Screen control stands still while pairing is on screen.
+ *
+ * Screen control's gestures are injected by the accessibility service and reach the pairing
+ * screen as real, unobscured touches: without this, a paired computer with Screen control on could
+ * send a pair request from a new key and tap Accept itself. While [showing] is true, every
+ * `screen.*` call except `screen.status` is refused with [PAIRING_OPEN] (actions, and the tree and
+ * screenshot too, so the words cannot be read remotely either). [ScreenCommands] asks at its one
+ * dispatch point, after it holds the screen lock.
+ *
+ * [showing] is true while
+ * - a [PairConfirmActivity] is started (visible: resumed, or paused under something translucent);
+ *   counted from its own lifecycle events, which Android always balances (a screen destroyed while
+ *   resumed still passes ON_PAUSE and ON_STOP), and a killed process takes the count with it, so it
+ *   cannot stick; or
+ * - a pair request is open at all ([Pairing.requestOpen]: from `link.pair_request` until it is
+ *   accepted, rejected, dismissed, withdrawn or timed out), which covers the notification's Review
+ *   and Reject in the shade before the pairing screen is even open.
+ */
+object PairingOnScreen {
+    const val PAIRING_OPEN = "pairing_open"
+    const val MESSAGE = "Screen control is paused while the phone shows a pairing request; a person answers it on the phone."
+
+    private val started = AtomicInteger(0)
+
+    private val observer = LifecycleEventObserver { _, event ->
+        when (event) {
+            Lifecycle.Event.ON_START -> started.incrementAndGet()
+            Lifecycle.Event.ON_STOP -> started.updateAndGet { (it - 1).coerceAtLeast(0) }
+            else -> Unit
+        }
+    }
+
+    /** From [PairConfirmActivity.onCreate]: follow this screen's lifecycle. */
+    fun watch(owner: LifecycleOwner) = owner.lifecycle.addObserver(observer)
+
+    fun showing(): Boolean = started.get() > 0 || Pairing.requestOpen()
+
+    /** Refuses with [PAIRING_OPEN] while [showing]. */
+    fun refuseWhileShowing() {
+        if (showing()) throw OmalawnError(PAIRING_OPEN, MESSAGE)
+    }
+}
