--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/HomaLawnDashboard.kt
@@ -0,0 +1,136 @@
+package app.lawnchair.omalawn
+
+import android.content.Context
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.lifecycle.compose.LifecycleResumeEffect
+import app.lawnchair.omalawn.link.Computer
+import app.lawnchair.omalawn.link.HomarComputers
+import app.lawnchair.omalawn.link.LinkServer
+import app.lawnchair.omalawn.link.Pins
+import app.lawnchair.ui.preferences.LocalNavController
+import app.lawnchair.ui.preferences.components.controls.PreferenceCategory
+import app.lawnchair.ui.preferences.components.layout.PreferenceGroup
+import com.android.launcher3.BuildConfig
+import com.android.launcher3.R
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * The settings dashboard's labelled groups (patch 0033): Homa Lawn's own layer first, under
+ * "Your computer" (Computers, Wallpaper & style, Permissions, each with a summary of its state);
+ * Lawnchair's rows follow under "Launcher" in upstream's order, and About under "About". The
+ * headings are [YOUR_COMPUTER], [LAUNCHER] and [ABOUT]; PreferencesDashboard has one hook each.
+ */
+object HomaLawnDashboard {
+    const val YOUR_COMPUTER = "Your computer"
+    const val LAUNCHER = "Launcher"
+    const val ABOUT = "About"
+
+    /** The About row's summary: "Homa Lawn 16 · build 325". */
+    fun aboutSummary(ctx: Context): String =
+        "${ctx.getString(R.string.derived_app_name)} ${BuildConfig.MAJOR_VERSION} · build ${BuildConfig.HOMALAWN_BUILD}"
+}
+
+@Composable
+fun HomaLawnDashboardGroup() {
+    val ctx = LocalContext.current
+    val nav = LocalNavController.current
+    // computers and their connections change while the dashboard shows; permissions change in Android's pages
+    var tick by remember { mutableIntStateOf(0) }
+    DisposableEffect(Unit) {
+        val l: () -> Unit = { tick++ }
+        Pins.onChange(l)
+        LinkServer.onChange(l)
+        onDispose {
+            Pins.removeListener(l)
+            LinkServer.removeListener(l)
+        }
+    }
+    LifecycleResumeEffect(Unit) {
+        tick++
+        onPauseOrDispose { }
+    }
+    val book by LookBook.changes.collectAsState()
+    var computers by remember { mutableStateOf<String?>(null) }
+    var look by remember { mutableStateOf<String?>(null) }
+    LaunchedEffect(tick, book) {
+        withContext(Dispatchers.IO) {
+            val paired = Pins.list(ctx)
+            computers = computersSummary(paired, LinkServer.connectedFps())
+            look = lookSummary(ctx, paired)
+        }
+    }
+    val attention = remember(tick) { HomaLawnPermissions.needAttention(ctx) }
+
+    PreferenceGroup(heading = HomaLawnDashboard.YOUR_COMPUTER) {
+        PreferenceCategory(
+            label = stringResource(R.string.homar_computers_label),
+            description = computers ?: " ",
+            iconResource = R.drawable.homar_ic_computer,
+            onNavigate = { nav.navigate(HomarComputers) },
+        )
+        PreferenceCategory(
+            label = stringResource(R.string.homar_wallpapers_label),
+            description = look ?: " ",
+            iconResource = R.drawable.ic_wallpaper,
+            onNavigate = { nav.navigate(HomarWallpapers) },
+        )
+        PreferenceCategory(
+            label = "Permissions",
+            description = when (attention) {
+                0 -> "All set"
+                1 -> "1 needs attention"
+                else -> "$attention need attention"
+            },
+            iconResource = R.drawable.homalawn_ic_permissions,
+            onNavigate = { nav.navigate(HomaLawnPermissions.Route) },
+        )
+    }
+}
+
+/** "Laptop · online now" / "Laptop · last seen 5 min ago" / "2 paired" / "None paired yet". */
+private fun computersSummary(paired: List<Computer>, online: Set<String>): String = when (paired.size) {
+    0 -> "None paired yet"
+    1 -> paired[0].let { c ->
+        val name = c.name.ifEmpty { "Computer" }
+        when {
+            c.fp in online -> "$name · online now"
+            c.seen == 0L -> "$name · not seen yet"
+            else -> "$name · last seen ${ago(c.seen)}"
+        }
+    }
+    else -> "${paired.size} paired"
+}
+
+/** "From <computer>'s Omarchy theme", or "From your computer's Omarchy theme" when no computer is the source yet. */
+private fun lookSummary(ctx: Context, paired: List<Computer>): String {
+    val source = try {
+        LookBook.source(ctx)
+    } catch (_: OmalawnError) {
+        null // an unreadable look book: the screen itself says so
+    }
+    val name = paired.firstOrNull { it.fp == source }?.name?.ifEmpty { null }
+        ?: paired.singleOrNull()?.name?.ifEmpty { null }
+    return if (name != null) "From $name's Omarchy theme" else "From your computer's Omarchy theme"
+}
+
+// English whatever the phone's language is, as on the Computers screen
+private fun ago(ms: Long): String {
+    val m = (System.currentTimeMillis() - ms) / 60_000
+    return when {
+        m < 1 -> "just now"
+        m < 60 -> "$m min ago"
+        m < 1440 -> "${m / 60} h ago"
+        else -> "${m / 1440} days ago"
+    }
+}
diff --git a/lawnchair/src/app/lawnchair/omalawn/HomaLawnNotifications.kt b/lawnchair/src/app/lawnchair/omalawn/HomaLawnNotifications.kt
new file mode 100644
index 0000000000..cc6b99cbb6
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/HomaLawnNotifications.kt
@@ -0,0 +1,57 @@
+package app.lawnchair.omalawn
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationChannelGroup
+import android.app.NotificationManager
+import android.content.Context
+import android.os.Build
+import com.android.launcher3.R
+
+/**
+ * Homa Lawn's notification channels, in one channel group "From your computer" on Android's
+ * notification page for the app (patch 0033), apart from Lawnchair's own:
+ * - "Pairing requests" ([PAIRING]): asks before a computer is paired;
+ * - "Setup reminders" ([REMINDERS]): what Homa Lawn still needs from Android (home app, run in
+ *   background, photo access); a tap opens Settings › Permissions;
+ * - "App updates" ([UPDATES]): a new Homa Lawn sent from a paired computer.
+ * The ids are the ones phones already have, so a person's choices per channel stay. All three are
+ * created together whenever one is needed, so the page always shows the whole group. Every Homa
+ * Lawn notification uses one small icon, the phone mark ([ICON]).
+ */
+object HomaLawnNotifications {
+    const val PAIRING = "omalawn_pair"
+    const val REMINDERS = "omalawn_requests"
+    const val UPDATES = "omalawn_update"
+    private const val GROUP = "homalawn_from_computer"
+
+    val ICON = R.drawable.homalawn_ic_notification
+
+    /** Creates (or renames) the group and the three channels; returns the notification manager. */
+    fun ensure(ctx: Context): NotificationManager? {
+        val nm = ctx.getSystemService(NotificationManager::class.java) ?: return null
+        nm.createNotificationChannelGroup(NotificationChannelGroup(GROUP, "From your computer"))
+        // below Android 12 notification actions cannot demand an unlock: pairing stays off the lock screen
+        val pairingLock = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) Notification.VISIBILITY_PRIVATE else Notification.VISIBILITY_SECRET
+        nm.createNotificationChannels(
+            listOf(
+                NotificationChannel(PAIRING, "Pairing requests", NotificationManager.IMPORTANCE_HIGH).apply {
+                    description = "Asks before a computer is paired with this phone"
+                    lockscreenVisibility = pairingLock
+                    setShowBadge(false)
+                    group = GROUP
+                },
+                NotificationChannel(REMINDERS, "Setup reminders", NotificationManager.IMPORTANCE_DEFAULT).apply {
+                    description = "What Homa Lawn still needs from Android: the home app, running in the background, access to photos"
+                    group = GROUP
+                },
+                NotificationChannel(UPDATES, "App updates", NotificationManager.IMPORTANCE_HIGH).apply {
+                    description = "A new Homa Lawn sent from your paired computer, ready to install"
+                    setShowBadge(false)
+                    group = GROUP
+                },
+            ),
+        )
+        return nm
+    }
+}
diff --git a/lawnchair/src/app/lawnchair/omalawn/HomaLawnPermissions.kt b/lawnchair/src/app/lawnchair/omalawn/HomaLawnPermissions.kt
new file mode 100644
index 0000000000..bf3946d415
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/HomaLawnPermissions.kt
@@ -0,0 +1,194 @@
+package app.lawnchair.omalawn
+
+import android.annotation.SuppressLint
+import android.app.Activity
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.ContextWrapper
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.PowerManager
+import android.provider.Settings
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.core.app.NotificationManagerCompat
+import androidx.lifecycle.compose.LifecycleResumeEffect
+import androidx.navigation.NavGraphBuilder
+import androidx.navigation.compose.composable
+import androidx.navigation.navDeepLink
+import app.lawnchair.LawnchairAccessibilityService
+import app.lawnchair.omalawn.screen.ScreenCommands
+import app.lawnchair.ui.preferences.LocalIsExpandedScreen
+import app.lawnchair.ui.preferences.PreferenceActivity
+import app.lawnchair.ui.preferences.components.layout.PreferenceGroup
+import app.lawnchair.ui.preferences.components.layout.PreferenceLayout
+import app.lawnchair.ui.preferences.components.layout.PreferenceTemplate
+import com.android.launcher3.R
+import kotlinx.serialization.Serializable
+import org.json.JSONObject
+
+/**
+ * Settings › Permissions (patch 0033): the one place that shows everything Homa Lawn needs from
+ * Android, each with its state, one line why, and a tap that opens the exact Android page. Three
+ * are needed for a computer to reach the phone (home app, run in background, notifications), two
+ * are optional (screen control, install updates). The dashboard row counts only the needed ones;
+ * the "Setup reminders" notification opens this screen; `launcher.ping` reports the same states
+ * as `permissions`, so the computer shows what the phone shows.
+ */
+object HomaLawnPermissions {
+    enum class Perm(val key: String, val required: Boolean) {
+        HOME("home", true),
+        BACKGROUND("background", true),
+        NOTIFICATIONS("notifications", true),
+        SCREEN_CONTROL("screen_control", false),
+        INSTALL_UPDATES("install_updates", false),
+    }
+
+    private const val DEEP_LINK = "lawnchair://settings/homalawn-permissions"
+
+    /**
+     * Homa Lawn is the home app Android opens: the HOME intent resolves to it (not to the chooser);
+     * also `launcher.ping`'s `default_home`. Not the HOME role: after an install the role can still
+     * name Homa Lawn while Home shows the chooser (seen on the test AVD).
+     */
+    fun isHome(ctx: Context): Boolean = ctx.packageManager.resolveActivity(
+        Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME),
+        0,
+    )?.activityInfo?.packageName == ctx.packageName
+
+    fun allowed(ctx: Context, p: Perm): Boolean = when (p) {
+        Perm.HOME -> isHome(ctx)
+        Perm.BACKGROUND -> ctx.getSystemService(PowerManager::class.java)?.isIgnoringBatteryOptimizations(ctx.packageName) == true
+        Perm.NOTIFICATIONS -> NotificationManagerCompat.from(ctx).areNotificationsEnabled()
+        Perm.SCREEN_CONTROL -> LawnchairAccessibilityService.current != null
+        Perm.INSTALL_UPDATES -> ctx.packageManager.canRequestPackageInstalls()
+    }
+
+    /** How many of the needed ones are not allowed. */
+    fun needAttention(ctx: Context): Int = Perm.entries.count { it.required && !allowed(ctx, it) }
+
+    /** `launcher.ping`'s `permissions`: {home, background, notifications, screen_control, install_updates}. */
+    fun toJson(ctx: Context): JSONObject = JSONObject().apply { Perm.entries.forEach { put(it.key, allowed(ctx, it)) } }
+
+    /** Opens this screen over a fresh settings task (the "Setup reminders" notification's tap). */
+    fun openIntent(ctx: Context): Intent = Intent(Intent.ACTION_VIEW, Uri.parse(DEEP_LINK))
+        .setClass(ctx, PreferenceActivity::class.java)
+        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK)
+
+    /** The exact Android page for [p] (a dialog where Android asks the question itself). */
+    @SuppressLint("BatteryLife") // sideloaded build; the link must survive Doze
+    fun androidPage(ctx: Context, p: Perm): Intent {
+        val pkg = Uri.fromParts("package", ctx.packageName, null)
+        return when (p) {
+            Perm.HOME -> Intent(Settings.ACTION_HOME_SETTINGS)
+            // not allowed: Android's own question; allowed: App info, where App battery usage lives
+            Perm.BACKGROUND -> if (allowed(ctx, p)) {
+                Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, pkg)
+            } else {
+                Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, pkg)
+            }
+            Perm.NOTIFICATIONS -> Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS)
+                .putExtra(Settings.EXTRA_APP_PACKAGE, ctx.packageName)
+            // the service's own page needs a permission only system apps get; Homa Lawn is listed here
+            Perm.SCREEN_CONTROL -> Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)
+            Perm.INSTALL_UPDATES -> Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, pkg)
+        }
+    }
+
+    /** The settings route, reachable by its deep link from the notification. */
+    @Serializable
+    data object Route
+
+    fun register(graph: NavGraphBuilder) {
+        graph.composable<Route>(deepLinks = listOf(navDeepLink<Route>(basePath = DEEP_LINK))) { PermissionsScreen() }
+    }
+}
+
+/** Registers the screen in Lawnchair's settings graph (one line in PreferenceNavigation). */
+fun NavGraphBuilder.homaLawnPermissions() = HomaLawnPermissions.register(this)
+
+@Composable
+fun PermissionsScreen() {
+    val ctx = LocalContext.current
+    // the states change in Android's pages; read again whenever the screen comes back
+    var tick by remember { mutableIntStateOf(0) }
+    LifecycleResumeEffect(Unit) {
+        tick++
+        onPauseOrDispose { }
+    }
+    val states = remember(tick) { HomaLawnPermissions.Perm.entries.associateWith { HomaLawnPermissions.allowed(ctx, it) } }
+    // Android 13+ may block turning on an accessibility service of a sideloaded app
+    val restricted = remember(tick) { Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU && ScreenCommands.restricted(ctx) != false }
+    val samsung = Build.MANUFACTURER.equals("samsung", ignoreCase = true)
+    val name = stringResource(R.string.derived_app_name) // as Android lists it ("Homa Lawn Test" for the test build)
+
+    PreferenceLayout(label = "Permissions", backArrowVisible = !LocalIsExpandedScreen.current) {
+        PreferenceGroup(heading = "Needed") {
+            PermissionRow(HomaLawnPermissions.Perm.HOME, "Home app", states, "Your computer reaches the phone through the home screen.")
+            PermissionRow(
+                HomaLawnPermissions.Perm.BACKGROUND,
+                "Run in background",
+                states,
+                "Lets your computer reach the phone while it sleeps.",
+                hint = "In Android: App battery usage › Allow background usage." +
+                    if (samsung) " On Samsung also add Homa Lawn to Never auto sleeping apps." else "",
+            )
+            PermissionRow(HomaLawnPermissions.Perm.NOTIFICATIONS, "Notifications", states, "For pairing requests and updates that need a tap.")
+        }
+        PreferenceGroup(heading = "Optional") {
+            PermissionRow(
+                HomaLawnPermissions.Perm.SCREEN_CONTROL,
+                "Screen control",
+                states,
+                "Lets a paired computer or its AI assistant see and operate the screen.",
+                hint = listOfNotNull(
+                    "In Android: Downloaded apps › $name › Use $name.",
+                    "If Android says “Restricted setting”: App info › ⋮ › Allow restricted settings, then try again.".takeIf { restricted },
+                ).joinToString("\n"),
+            )
+            PermissionRow(HomaLawnPermissions.Perm.INSTALL_UPDATES, "Install updates", states, "Lets updates from your computer install.")
+        }
+    }
+}
+
+@Composable
+private fun PermissionRow(
+    perm: HomaLawnPermissions.Perm,
+    title: String,
+    states: Map<HomaLawnPermissions.Perm, Boolean>,
+    why: String,
+    hint: String? = null,
+) {
+    val ctx = LocalContext.current
+    val allowed = states[perm] == true
+    PreferenceTemplate(
+        title = { Text(title) },
+        description = { Text(listOfNotNull(why, hint.takeIf { !allowed }).joinToString("\n")) },
+        endWidget = {
+            Text(
+                if (allowed) "Allowed" else "Not allowed",
+                style = MaterialTheme.typography.labelLarge,
+                color = if (!allowed && perm.required) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        },
+        onClick = {
+            // in the settings' own task, so Back from Android's page comes back here
+            val activity = generateSequence(ctx) { (it as? ContextWrapper)?.baseContext }.firstOrNull { it is Activity }
+            fun open(i: Intent) = (activity ?: ctx).startActivity(if (activity == null) i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK) else i)
+            try {
+                open(HomaLawnPermissions.androidPage(ctx, perm))
+            } catch (_: ActivityNotFoundException) {
+                // a phone whose Settings lacks that page: App info leads to every one of them
+                open(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.fromParts("package", ctx.packageName, null)))
+            }
+        },
+    )
+}
