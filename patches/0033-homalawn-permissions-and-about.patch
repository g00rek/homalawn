diff --git a/homalawn.gradle b/homalawn.gradle
index c390a4649b..92554e3423 100644
--- a/homalawn.gradle
+++ b/homalawn.gradle
@@ -15,6 +15,9 @@
 //   (BRAND_KEYS); credits, the About screen and upstream's own statements stay as they are.
 // - Homa Lawn's own defaults for upstream settings, in homalawn/res (patch 0026): no Lawnchair
 //   announcements at the top of the settings.
+// - The test build is called "Homa Lawn Test" wherever Android lists it (launcher label, the
+//   settings icon, the accessibility service), so it can be told from the release next to it
+//   (patch 0033); BuildConfig.HOMALAWN_BUILD is the build number the settings show.
 //
 // Upstream's flavors, build types and signing are left untouched.
 
@@ -78,6 +81,17 @@ file("lawnchair/res").eachDirMatch(~/values(-.+)?/) { dir ->
 }
 
 android {
+    defaultConfig {
+        buildConfigField "int", "HOMALAWN_BUILD", "0" // upstream's own flavors
+    }
+
+    buildTypes {
+        // the test build's name (patch 0033); the release build stays "Homa Lawn" (build.gradle)
+        debug {
+            resValue("string", "derived_app_name", "Homa Lawn Test")
+        }
+    }
+
     if (hlHaveKey) {
         signingConfigs {
             homalawnRelease {
@@ -96,6 +110,7 @@ android {
             versionCode hlVersionCode
             versionName hlVersionName
             buildConfigField "String", "VERSION_DISPLAY_NAME", "\"${hlVersionName}\""
+            buildConfigField "int", "HOMALAWN_BUILD", "${hlBuild}"
             // the launcher's Recents integration on every Android version, as in the debug builds
             // our phones ran before (upstream limits its own release builds to the versions it tests)
             manifestPlaceholders.quickstepMinSdk = "0"
