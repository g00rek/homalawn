index 0000000000..30f7a2eed0
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/link/LinkServer.kt
@@ -0,0 +1,532 @@
+package app.lawnchair.omalawn.link
+
+import android.content.Context
+import android.os.Build
+import android.os.SystemClock
+import android.provider.Settings
+import android.util.Log
+import app.lawnchair.omalawn.OmalawnCommands
+import app.lawnchair.omalawn.OmalawnError
+import java.io.File
+import java.io.IOException
+import java.net.InetSocketAddress
+import java.net.Socket
+import java.net.SocketException
+import java.net.SocketTimeoutException
+import java.security.cert.CertificateException
+import java.security.cert.X509Certificate
+import java.util.Collections
+import java.util.UUID
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.ScheduledFuture
+import java.util.concurrent.ScheduledThreadPoolExecutor
+import java.util.concurrent.TimeUnit
+import javax.net.ssl.SSLContext
+import javax.net.ssl.SSLServerSocket
+import javax.net.ssl.SSLSocket
+import javax.net.ssl.X509TrustManager
+import org.json.JSONObject
+
+/**
+ * The link: mutual TLS 1.3 on TCP 47100 (all interfaces), one thread per connection, at most
+ * [MAX_CONNECTIONS]. Any client certificate passes the handshake; what it may call is decided per
+ * request from [Pins]: a pinned computer gets every method below, an unpinned one only [OPEN].
+ *
+ * Slots: handshaking sockets (max [MAX_PENDING], oldest dropped), paired computers (max
+ * [MAX_CONNECTIONS]), unpaired ones (max [MAX_UNPAIRED], oldest evicted, each closed after
+ * [UNPAIRED_LIFETIME_MS]) and ONE pairing slot: an unpaired connection whose `link.pair_request`
+ * was accepted leaves the evictable unpaired queue, its 30 s close is replaced by the 120 s
+ * pairing deadline, and on Accept it is promoted to the paired set and stays open (on Reject,
+ * dismissal or timeout it is closed after answering `link.pair_wait`).
+ *
+ * Before the TLS handshake every new socket passes [PairingGate.admitHandshake] (a per-address
+ * limit; a paired computer's attempt is given back). The status notification reads
+ * [connectedNames] and [screenShownLeftMs]; [onChange] tells it when they change.
+ */
+object LinkServer {
+    const val PORT = 47100
+    const val MAX_CONNECTIONS = 4 // paired computers
+    const val MAX_UNPAIRED = 2
+    private const val MAX_PENDING = 4 // sockets still in the TLS handshake
+    private const val HANDSHAKE_MS = 10_000L
+    private const val UNPAIRED_LIFETIME_MS = 30_000L
+    private const val IDLE_MS = 60_000
+    private const val RETRY_MS = 5_000L
+    private const val PAIR_END_GRACE_MS = 10_000L // after Reject/timeout: time to collect the answer
+    private const val TAG = "OmalawnLink"
+
+    const val NOT_PAIRED = "not_paired"
+    const val BAD_PARAMS = "bad_params"
+    const val BAD_PATH = "bad_path"
+
+    /** Methods an unpinned computer may call. */
+    private val OPEN = setOf("link.hello", "link.pair_request", "link.pair_reveal", "link.pair_wait")
+
+    private enum class Kind { PLAIN, BLOB_OUT, BLOB_IN, STAGE }
+
+    /** Method → (accepted params, how bytes travel). Unknown methods and params are refused. */
+    private class Spec(val params: Set<String>, val kind: Kind = Kind.PLAIN)
+
+    private val METHODS = mapOf(
+        "link.hello" to Spec(emptySet()),
+        "link.ping" to Spec(emptySet()),
+        "link.pair_request" to Spec(setOf("name", "commit")),
+        "link.pair_reveal" to Spec(setOf("nonce_desktop")),
+        "link.pair_wait" to Spec(emptySet()),
+        "link.unpair" to Spec(emptySet()),
+        "launcher.ping" to Spec(emptySet()),
+        "launcher.ensure_loaded" to Spec(emptySet()),
+        "launcher.apps_list" to Spec(emptySet()),
+        "launcher.prefs_list" to Spec(emptySet()),
+        "launcher.pref_set" to Spec(setOf("store", "key", "type", "value")),
+        "launcher.prefs_set_many" to Spec(setOf("writes")),
+        "launcher.wallpaper_info" to Spec(emptySet()),
+        "launcher.wallpaper_backup" to Spec(emptySet(), Kind.BLOB_OUT),
+        "launcher.wallpaper_set" to Spec(setOf("path")),
+        "launcher.widgets_list" to Spec(emptySet()),
+        "launcher.widget_status" to Spec(setOf("id")),
+        "launcher.layout_export" to Spec(setOf("via"), Kind.BLOB_OUT),
+        "launcher.layout_import" to Spec(setOf("db"), Kind.BLOB_IN),
+        "launcher.stage_file" to Spec(setOf("name"), Kind.STAGE),
+    )
+
+    @Volatile private var running = false
+    @Volatile private var generation = 0 // bumped by start() and stop(); an accept thread of an older one exits
+    private var server: SSLServerSocket? = null
+    private val all: MutableSet<Socket> = Collections.synchronizedSet(mutableSetOf())
+
+    /** Slot bookkeeping, all under [slots]. */
+    private val slots = Any()
+    private val pending = ArrayDeque<Socket>() // accepted, TLS not finished; oldest first
+    private val pairedConns = mutableMapOf<Socket, String>() // -> certificate fingerprint
+    private val unpairedConns = ArrayDeque<Socket>() // oldest first
+    private var pairingConn: Socket? = null // the one connection with a pending pair request
+    private val lifetimes = HashMap<Socket, ScheduledFuture<*>>() // unpaired lifetime / pairing deadline
+
+    private val timer = ScheduledThreadPoolExecutor(1) { r ->
+        Thread(r, "omalawn-link-timer").apply { isDaemon = true }
+    }.apply { removeOnCancelPolicy = true } // cancelled 30 s/120 s closes must not pile up
+
+    /** Per-connection state the request handler keeps. */
+    private class ConnState(val s: SSLSocket, val fp: String, val der: ByteArray) {
+        var session: Pairing.Session? = null
+    }
+
+    val connections get() = all.size
+
+    private val listeners = CopyOnWriteArrayList<() -> Unit>()
+    fun onChange(l: () -> Unit) = listeners.add(l)
+    fun removeListener(l: () -> Unit) = listeners.remove(l)
+    private fun changed() = listeners.forEach { runCatching { it() } }
+
+    /** Names of the paired computers connected right now (each once). */
+    fun connectedNames(ctx: Context): List<String> {
+        val fps = synchronized(slots) { pairedConns.values.toSet() }
+        return fps.mapNotNull { Pins.name(ctx, it)?.ifEmpty { null } }.sorted()
+    }
+
+    @Volatile private var lastScreenUse = 0L // elapsedRealtime of the last screen.* call, 0 = never
+
+    /** A paired computer read or operated the screen (patch 0004 calls this for every screen.* but status). */
+    fun noteScreenUse() {
+        val first = lastScreenUse == 0L || SystemClock.elapsedRealtime() - lastScreenUse >= LinkService.SCREEN_SHOWN_MS
+        lastScreenUse = SystemClock.elapsedRealtime()
+        if (first) changed()
+    }
+
+    /** How much longer "screen control in use" stays shown, 0 when not. */
+    fun screenShownLeftMs(showMs: Long): Long =
+        if (lastScreenUse == 0L) 0 else (lastScreenUse + showMs - SystemClock.elapsedRealtime()).coerceAtLeast(0)
+
+    @Synchronized
+    fun start(context: Context) {
+        if (running) return
+        running = true
+        val gen = ++generation
+        val ctx = context.applicationContext
+        Thread({ acceptLoop(ctx, gen) }, "omalawn-link-accept").apply {
+            isDaemon = true
+            start()
+        }
+    }
+
+    @Synchronized
+    fun stop() {
+        running = false
+        generation++
+        runCatching { server?.close() }
+        server = null
+        synchronized(all) { all.toList() }.forEach { runCatching { it.close() } }
+    }
+
+    private fun alive(gen: Int) = running && generation == gen
+
+    private fun open(): SSLServerSocket {
+        val tls = SSLContext.getInstance("TLSv1.3")
+        tls.init(arrayOf(Identity.keyManager()), arrayOf(AnyClientCert), null)
+        val ss = tls.serverSocketFactory.createServerSocket() as SSLServerSocket
+        ss.reuseAddress = true
+        ss.bind(InetSocketAddress(PORT))
+        ss.enabledProtocols = arrayOf("TLSv1.3")
+        ss.needClientAuth = true
+        return ss
+    }
+
+    private fun acceptLoop(ctx: Context, gen: Int) {
+        while (alive(gen)) {
+            val ss = try {
+                open().also { synchronized(this) { if (alive(gen)) server = it else it.close() } }
+            } catch (e: Throwable) {
+                Log.w(TAG, "cannot listen on $PORT, retrying: ${e.javaClass.simpleName}: ${e.message}")
+                try {
+                    Thread.sleep(RETRY_MS)
+                } catch (_: InterruptedException) {
+                }
+                continue
+            }
+            if (!alive(gen)) break
+            Log.i(TAG, "listening on $PORT")
+            try {
+                while (alive(gen)) {
+                    val s = ss.accept() as SSLSocket
+                    acceptFailures = 0
+                    try {
+                        admit(ctx, s)
+                    } catch (e: Throwable) { // e.g. no memory for a thread: drop this one, keep listening
+                        Log.w(TAG, "cannot serve a connection: ${e.javaClass.simpleName}")
+                        drop(s)
+                    }
+                }
+            } catch (e: Throwable) {
+                if (alive(gen)) {
+                    Log.w(TAG, "accept failed, reopening: ${e.javaClass.simpleName}: ${e.message}")
+                    // the first failure reopens at once; repeated ones wait, so a broken socket cannot spin
+                    if (++acceptFailures > 1) {
+                        try {
+                            Thread.sleep(RETRY_MS)
+                        } catch (_: InterruptedException) {
+                        }
+                    }
+                }
+            } finally {
+                runCatching { ss.close() }
+            }
+        }
+    }
+
+    private var acceptFailures = 0 // accept thread only
+
+    /**
+     * Every new socket gets a pending slot; when [MAX_PENDING] are taken the oldest is dropped, so
+     * idle TCP sockets cannot keep a real computer from reaching the TLS handshake.
+     */
+    private fun admit(ctx: Context, s: SSLSocket) {
+        all.add(s)
+        val evict = synchronized(slots) {
+            pending.addLast(s)
+            if (pending.size > MAX_PENDING) pending.removeFirst() else null
+        }
+        evict?.let { drop(it) }
+        Thread({ serve(ctx, s) }, "omalawn-link-conn").apply {
+            isDaemon = true
+            start()
+        }
+    }
+
+    private fun drop(s: Socket, ctx: Context? = null) {
+        var wasPaired = false
+        val wasPairing = synchronized(slots) {
+            pending.remove(s)
+            wasPaired = pairedConns.remove(s) != null
+            unpairedConns.remove(s)
+            lifetimes.remove(s)?.cancel(false)
+            (pairingConn === s).also { if (it) pairingConn = null }
+        }
+        all.remove(s)
+        runCatching { s.close() }
+        if (wasPairing && ctx != null) Pairing.connectionGone(ctx, s) // withdraws the prompt
+        if (wasPaired) changed()
+    }
+
+    /**
+     * Called by [Pairing] when a pair request on [s] is accepted for processing: [s] leaves the
+     * unpaired queue (strangers can no longer evict it), its unpaired lifetime is cancelled and
+     * [onDeadline] runs after [deadlineMs]. False when the slot is taken or [s] is not an
+     * unpaired connection any more.
+     */
+    fun enterPairing(s: Socket, deadlineMs: Long, onDeadline: () -> Unit): Boolean = synchronized(slots) {
+        if (pairingConn != null || !unpairedConns.remove(s)) return@synchronized false
+        lifetimes.remove(s)?.cancel(false)
+        pairingConn = s
+        lifetimes[s] = timer.schedule({ runCatching(onDeadline) }, deadlineMs, TimeUnit.MILLISECONDS)
+        true
+    }
+
+    /**
+     * The pairing on [s] ended. Accepted: [s] joins the paired set and keeps going (closed when the
+     * set is full; the computer then simply dials again). Otherwise [s] is closed once `pair_wait`
+     * has answered, or after [PAIR_END_GRACE_MS] at the latest.
+     */
+    fun leavePairing(s: Socket, accepted: Boolean, fp: String) {
+        val keep = synchronized(slots) {
+            if (pairingConn !== s) return@synchronized false
+            pairingConn = null
+            lifetimes.remove(s)?.cancel(false)
+            if (accepted && pairedConns.size < MAX_CONNECTIONS) {
+                pairedConns[s] = fp
+                true
+            } else {
+                false
+            }
+        }
+        if (keep) changed()
+        if (!keep) {
+            if (accepted) Log.w(TAG, "paired, but $MAX_CONNECTIONS computers are connected; closing so it dials again")
+            closeLater(s, PAIR_END_GRACE_MS)
+        }
+    }
+
+    private fun closeLater(s: Socket, ms: Long): ScheduledFuture<*> =
+        timer.schedule({ runCatching { s.close() } }, ms, TimeUnit.MILLISECONDS)
+
+    /**
+     * After TLS: a paired computer takes one of [MAX_CONNECTIONS] slots (refused when all are
+     * taken); an unpaired one takes one of [MAX_UNPAIRED] (the oldest is dropped when full) and
+     * lives at most [UNPAIRED_LIFETIME_MS], so strangers never use up a paired computer's slot.
+     */
+    private fun seat(s: Socket, paired: Boolean, fp: String): Boolean {
+        var evict: Socket? = null
+        val ok = synchronized(slots) {
+            if (!pending.remove(s)) return@synchronized false // dropped while handshaking
+            if (paired) {
+                if (pairedConns.size >= MAX_CONNECTIONS) return@synchronized false
+                pairedConns[s] = fp
+            } else {
+                unpairedConns.addLast(s)
+                lifetimes[s] = closeLater(s, UNPAIRED_LIFETIME_MS)
+                if (unpairedConns.size > MAX_UNPAIRED) evict = unpairedConns.removeFirst()
+            }
+            true
+        }
+        evict?.let { drop(it) }
+        if (ok && paired) changed()
+        return ok
+    }
+
+    private fun serve(ctx: Context, s: SSLSocket) {
+        try {
+            val remote = s.inetAddress
+            if (!PairingGate.admitHandshake(ctx, remote)) {
+                Log.w(TAG, "refusing a connection: over ${PairingGate.MAX_HANDSHAKES} handshakes a minute from one address")
+                return
+            }
+            s.soTimeout = HANDSHAKE_MS.toInt()
+            val handshakeDeadline = closeLater(s, HANDSHAKE_MS) // also against a byte-by-byte trickle
+            s.startHandshake()
+            handshakeDeadline.cancel(false)
+            val der = s.session.peerCertificates[0].encoded
+            val fp = Identity.sha256Hex(der)
+            val paired = Pins.isPinned(ctx, fp)
+            if (paired) PairingGate.refund(remote) // a paired computer is never limited
+            if (!seat(s, paired, fp)) {
+                Log.w(TAG, "refusing a paired connection: $MAX_CONNECTIONS already open")
+                return
+            }
+            s.soTimeout = IDLE_MS
+            val conn = ConnState(s, fp, der)
+            val reader = FrameReader(s.inputStream)
+            val writer = FrameWriter(s.outputStream)
+            try {
+                while (running) {
+                    val req = reader.readJson() ?: break
+                    if (!handle(ctx, conn, req, reader, writer)) break
+                }
+            } catch (e: FrameError) {
+                runCatching { writer.error(null, e.code, e.message ?: e.code) }
+            }
+        } catch (_: SocketTimeoutException) {
+        } catch (_: SocketException) {
+        } catch (e: IOException) {
+            Log.d(TAG, "connection ended: ${e.javaClass.simpleName}: ${e.message}")
+        } catch (e: Throwable) { // OutOfMemoryError included: lose this connection, never the launcher
+            Log.w(TAG, "connection failed: ${e.javaClass.simpleName}: ${e.message}")
+        } finally {
+            drop(s, ctx)
+        }
+    }
+
+    /** One request; false closes the connection. */
+    private fun handle(ctx: Context, conn: ConnState, req: JSONObject, reader: FrameReader, writer: FrameWriter): Boolean {
+        val fp = conn.fp
+        val id = req.opt("id")
+        val method = req.optString("method")
+        if (req.has("blob")) throw FrameError(FrameReader.BAD_FRAME, "unexpected blob frame")
+        val paired = Pins.isPinned(ctx, fp)
+        if (!paired && method !in OPEN) {
+            // the same answer whether or not the method exists, and the connection ends: any blob
+            // it meant to send is never read
+            writer.error(id, NOT_PAIRED, "this computer is not paired with the phone")
+            return false
+        }
+        val spec = METHODS[method]
+        if (spec == null) {
+            writer.error(id, OmalawnCommands.UNKNOWN_METHOD, "unknown method $method")
+            return true
+        }
+        val needsBlob = spec.kind == Kind.BLOB_IN || spec.kind == Kind.STAGE
+        // a paired computer's blob is read even when the request is then refused, so its
+        // connection stays in step
+        val blob = if (needsBlob) reader.readBlob(id) else null
+        val raw = req.opt("params")
+        if (raw != null && raw != JSONObject.NULL && raw !is JSONObject) {
+            writer.error(id, BAD_PARAMS, "params must be an object")
+            return true
+        }
+        val params = (raw as? JSONObject) ?: JSONObject()
+        val extra = params.keys().asSequence().filter { it !in spec.params }.toList()
+        if (extra.isNotEmpty()) {
+            writer.error(id, BAD_PARAMS, "unknown params for $method: ${extra.sorted().joinToString()}")
+            return true
+        }
+        when (method) {
+            "link.pair_request", "link.pair_reveal", "link.pair_wait", "link.unpair" -> return pairing(ctx, conn, id, method, params, paired, writer)
+        }
+        if (method == "launcher.wallpaper_set" && !insidePrivateDir(ctx, params)) {
+            writer.error(id, BAD_PATH, "$BAD_PATH: over the link the wallpaper must be a file staged with launcher.stage_file")
+            return true
+        }
+        try {
+            when (spec.kind) {
+                Kind.PLAIN -> writer.result(id, OmalawnCommands.dispatch(ctx, method, params, paired))
+                Kind.BLOB_OUT -> {
+                    val r = OmalawnCommands.dispatch(ctx, method, params, paired) as JSONObject
+                    val f = File(r.getString("path"))
+                    val bytes = try {
+                        f.readBytes()
+                    } finally {
+                        f.delete()
+                    }
+                    r.remove("path")
+                    writer.blob(id, bytes, r)
+                }
+                Kind.BLOB_IN -> {
+                    val f = OmalawnCommands.stageFile(ctx, "import-${UUID.randomUUID()}.db", blob!!, internal = true)
+                    params.put("path", f.absolutePath)
+                    val r = try {
+                        OmalawnCommands.dispatch(ctx, method, params, paired)
+                    } finally {
+                        f.delete() // the import deletes it too; this covers a refusal before it ran
+                    }
+                    writer.result(id, r)
+                }
+                Kind.STAGE -> {
+                    val name = if (params.isNull("name")) "" else params.get("name").toString()
+                    val f = OmalawnCommands.stageFile(ctx, name, blob!!)
+                    writer.result(id, JSONObject().put("path", f.absolutePath))
+                }
+            }
+        } catch (e: OmalawnError) {
+            writer.error(id, e.code, e.message ?: e.code)
+        } catch (e: Exception) {
+            writer.error(id, "failed", "${e.javaClass.simpleName}: ${e.message}")
+        }
+        return true
+    }
+
+    /** The pairing methods, which need the connection itself. */
+    private fun pairing(
+        ctx: Context,
+        conn: ConnState,
+        id: Any?,
+        method: String,
+        params: JSONObject,
+        paired: Boolean,
+        writer: FrameWriter,
+    ): Boolean {
+        try {
+            when (method) {
+                "link.pair_request" -> {
+                    if (paired) throw OmalawnError("already_paired", "this computer is already paired")
+                    if (conn.session != null) throw OmalawnError("pair_busy", "this connection already made a pair request")
+                    val (session, res) = Pairing.begin(ctx, conn.s, conn.fp, conn.der, params)
+                    conn.session = session
+                    writer.result(id, res)
+                }
+                "link.pair_reveal" -> {
+                    val session = conn.session ?: throw OmalawnError("no_pairing", "send link.pair_request first")
+                    try {
+                        writer.result(id, Pairing.reveal(ctx, session, params))
+                    } catch (e: OmalawnError) {
+                        if (e.code != Pairing.BAD_COMMIT) throw e
+                        writer.error(id, e.code, e.message ?: e.code)
+                        return false // the request is over; so is this connection
+                    }
+                }
+                "link.pair_wait" -> {
+                    val session = conn.session ?: throw OmalawnError("no_pairing", "send link.pair_request first")
+                    if (session.words == null) throw OmalawnError("no_pairing", "send link.pair_reveal first")
+                    val outcome = Pairing.await(ctx, session) { peerStillThere(conn.s) }
+                    val accepted = outcome == Pairing.ACCEPTED
+                    val res = JSONObject().put("accepted", accepted).put("outcome", outcome)
+                    // the phone's name only once it trusts this computer (an unpaired hello says nothing)
+                    if (accepted) res.put("name", phoneName(ctx)).put("device", Build.MODEL)
+                    writer.result(id, res)
+                    conn.session = null
+                    return accepted // Reject/timeout: the phone hangs up after answering
+                }
+                "link.unpair" -> {
+                    Pins.remove(ctx, conn.fp)
+                    Log.i(TAG, "a computer unpaired itself fp=${conn.fp.take(16)}")
+                    writer.result(id, JSONObject().put("unpaired", true))
+                    return false
+                }
+            }
+        } catch (e: OmalawnError) {
+            writer.error(id, e.code, e.message ?: e.code)
+        }
+        return true
+    }
+
+    /**
+     * During `link.pair_wait` the computer must stay silent; a short read tells whether it is still
+     * there: a timeout means yes, end of stream, a reset or any byte at all means it is gone.
+     */
+    private fun peerStillThere(s: SSLSocket): Boolean {
+        val old = s.soTimeout
+        return try {
+            s.soTimeout = 200
+            s.inputStream.read() // -1 (hung up) or an unexpected byte
+            false
+        } catch (_: SocketTimeoutException) {
+            true
+        } catch (_: IOException) {
+            false
+        } finally {
+            runCatching { s.soTimeout = old }
+        }
+    }
+
+    fun phoneName(ctx: Context): String =
+        Settings.Global.getString(ctx.contentResolver, Settings.Global.DEVICE_NAME) ?: Build.MODEL
+
+    /** Over the link a path may only name a file directly inside files/omalawn/. */
+    private fun insidePrivateDir(ctx: Context, params: JSONObject): Boolean {
+        if (params.isNull("path")) return false
+        return try {
+            val f = File(params.get("path").toString()).canonicalFile
+            f.parentFile == OmalawnCommands.privateDir(ctx).canonicalFile && f.isFile
+        } catch (_: Exception) {
+            false
+        }
+    }
+
+    /** Every client certificate passes TLS; [Pins] decides per request. */
+    private object AnyClientCert : X509TrustManager {
+        override fun checkClientTrusted(chain: Array<out X509Certificate>?, authType: String?) {
+            if (chain.isNullOrEmpty()) throw CertificateException("a client certificate is required")
+        }
+        override fun checkServerTrusted(chain: Array<out X509Certificate>?, authType: String?) =
+            throw CertificateException("server role only")
+        override fun getAcceptedIssuers() = emptyArray<X509Certificate>()
+    }
+}
