+package app.lawnchair.omalawn.link
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import androidx.core.app.NotificationCompat
+import app.lawnchair.omalawn.OmalawnError
+import com.android.launcher3.BuildConfig
+import com.android.launcher3.R
+import java.net.Socket
+import java.security.MessageDigest
+import java.security.SecureRandom
+import java.util.UUID
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * Pairing a computer by comparing four words (spec D5). A computer that is not pinned sends
+ * `link.pair_request {name, commit}` (commit = SHA-256("omalawn-commit-v1" ‖ nonce_desktop)); the
+ * phone answers `{nonce_phone, name, expires_in}`; `link.pair_reveal {nonce_desktop}` is checked
+ * against the commitment and answered `{words}`, and the phone posts "Pair with <name>?" with
+ * Review/Reject. `link.pair_wait {}` then blocks until
+ * the answer, a dismissal, or the [TIMEOUT_MS] deadline. While the pairing screen waits in front
+ * ([screenWaiting]) it shows the request in place and no notification is posted. A request taken
+ * because the home screen was showing ([Session.viaHome]) opens the pairing screen in front with
+ * the request at once; the notification is only the fallback when that screen is left (or cannot
+ * be opened). One request at a time, at most [MAX_PER_WINDOW] per [WINDOW_MS], and only while the
+ * home screen shows (unlocked) or the user has pairing open ([PairingGate]).
+ *
+ * The notification cannot pin anything: any app with notification access can fire its actions.
+ * Review only opens [PairConfirmActivity] (not exported); a real, unobscured tap on its Accept
+ * button is the only thing that pins the computer's certificate.
+ *
+ * words = first 44 bits of SHA-256("omalawn-sas-v1" ‖ phone cert DER ‖ computer cert DER ‖
+ * nonce_phone ‖ nonce_desktop) as four 11-bit indexes into the BIP-39 English list (asset
+ * `omalawn_words.txt`). The desktop derives them on its own; a man in the middle changes them.
+ */
+object Pairing {
+    const val TIMEOUT_MS = 120_000L
+    private const val WINDOW_MS = 10 * 60_000L
+    private const val MAX_PER_WINDOW = 3
+    private const val TAG = "OmalawnLink"
+    private const val CHANNEL = "omalawn_pair"
+    private const val NOTIFICATION_ID = 47101
+    /** The action the notification's Accept used to send to the service; it pins nothing now. */
+    const val LEGACY_ACCEPT = "app.lawnchair.omalawn.link.PAIR_ACCEPT"
+    const val ACTION_REJECT = "app.lawnchair.omalawn.link.PAIR_REJECT"
+    const val ACTION_DISMISS = "app.lawnchair.omalawn.link.PAIR_DISMISS"
+    const val EXTRA_TOKEN = "token"
+
+    const val ACCEPTED = "accepted"
+    const val REJECTED = "rejected"
+    const val DISMISSED = "dismissed"
+    const val TIMEOUT = "timeout"
+    const val GONE = "gone" // the computer's connection ended first
+    const val BAD_COMMIT = "bad_commit"
+
+    private val HEX32 = Regex("[0-9a-f]{32}")
+    private val HEX64 = Regex("[0-9a-f]{64}")
+    private const val COOLDOWN_MS = 3_000L // between one prompt ending and the next appearing
+    private const val WATCH_MS = 500L // how often a waiting pair_wait checks the computer is still there
+    private val main = Handler(Looper.getMainLooper())
+    private val random = SecureRandom()
+
+    class Session(
+        val token: String,
+        val conn: Socket,
+        val fp: String,
+        val name: String,
+        val commit: ByteArray, // SHA-256("omalawn-commit-v1" ‖ nonce_desktop), sent before nonce_phone
+        val noncePhone: ByteArray,
+        val desktopDer: ByteArray,
+        val deadline: Long,
+        val viaHome: Boolean, // taken because the home screen was showing (not the pairing window)
+    ) {
+        val done = CountDownLatch(1)
+        @Volatile var outcome: String? = null
+        @Volatile var words: List<String>? = null // known only after link.pair_reveal
+        val intents = mutableListOf<PendingIntent>() // this session's actions; cancelled when it ends
+        var accept: PendingIntent? = null // the Review action (opens the confirmation screen)
+        @Volatile var visibleFrom = Long.MAX_VALUE // wall clock: when the prompt may be shown (after the cool-down)
+    }
+
+    /**
+     * True while the pairing screen waits in front ([PairConfirmActivity] opened by "Pair a
+     * computer"): it shows the request itself, so no notification is posted. When the screen is
+     * left with a request still open, the notification is posted after all (the fallback).
+     */
+    @Volatile var screenWaiting = false
+
+    private var current: Session? = null
+    private val recent = ArrayDeque<Long>() // start times of accepted requests, oldest first
+    private var lastEnd = 0L
+    private var codeSeq = 100 // PendingIntent request codes, fresh for every session
+
+    /** Debug builds only: the Review action of the last session that ended (for the stale-tap test). */
+    @Volatile private var staleAccept: PendingIntent? = null
+
+    @Volatile private var wordList: List<String>? = null
+
+    fun words(ctx: Context): List<String> = wordList ?: synchronized(this) {
+        wordList ?: ctx.assets.open("omalawn_words.txt").bufferedReader().readLines().also {
+            check(it.size == 2048) { "word list has ${it.size} words" }
+            wordList = it
+        }
+    }
+
+    fun wordsSha256(ctx: Context): String = Identity.sha256Hex(ctx.assets.open("omalawn_words.txt").readBytes())
+
+    fun sas(ctx: Context, phone: ByteArray, desktop: ByteArray, noncePhone: ByteArray, nonceDesktop: ByteArray): List<String> {
+        require(noncePhone.size == 16 && nonceDesktop.size == 16) { "nonces must be 16 bytes" }
+        val md = MessageDigest.getInstance("SHA-256")
+        md.update("omalawn-sas-v1".toByteArray(Charsets.US_ASCII))
+        md.update(phone)
+        md.update(desktop)
+        md.update(noncePhone)
+        md.update(nonceDesktop)
+        val h = md.digest()
+        var top = 0L
+        for (i in 0 until 6) top = (top shl 8) or (h[i].toLong() and 0xff)
+        top = top ushr 4 // the first 44 bits
+        val w = words(ctx)
+        return (0 until 4).map { w[((top ushr (11 * (3 - it))) and 0x7ff).toInt()] }
+    }
+
+    /** SHA-256("omalawn-commit-v1" ‖ nonce_desktop): the desktop's commitment to its nonce. */
+    fun commitment(nonceDesktop: ByteArray): ByteArray = MessageDigest.getInstance("SHA-256").run {
+        update("omalawn-commit-v1".toByteArray(Charsets.US_ASCII))
+        digest(nonceDesktop)
+    }
+
+    /** What the prompt may show of a computer's chosen name: no control or format (bidi) characters. */
+    fun cleanName(raw: String): String {
+        val sb = StringBuilder()
+        raw.codePoints().forEach { cp ->
+            if (!Character.isISOControl(cp) && Character.getType(cp) != Character.FORMAT.toInt()) sb.appendCodePoint(cp)
+        }
+        val t = sb.toString().trim()
+        return if (t.codePointCount(0, t.length) <= 64) t else t.substring(0, t.offsetByCodePoints(0, 64))
+    }
+
+    fun hex(s: String): ByteArray = ByteArray(s.length / 2) { s.substring(2 * it, 2 * it + 2).toInt(16).toByte() }
+
+    private fun toHex(b: ByteArray) = b.joinToString("") { "%02x".format(it) }
+
+    /** Can the user see the prompt? Permission granted (13+), app and our channel not blocked. */
+    private fun canNotify(ctx: Context): Boolean {
+        if (NotifyPermission.missing(ctx)) return false
+        val nm = ctx.getSystemService(NotificationManager::class.java) ?: return false
+        if (!nm.areNotificationsEnabled()) return false
+        val ch = nm.getNotificationChannel(CHANNEL)
+        return ch == null || ch.importance != NotificationManager.IMPORTANCE_NONE
+    }
+
+    /**
+     * `link.pair_request {name, commit}` on [conn] from the computer with certificate [desktopDer].
+     * The computer has committed to its nonce; the phone answers with its own nonce (the words cannot
+     * be known yet, so neither side can steer them). The connection moves into the single pairing
+     * slot (out of reach of other strangers, past the unpaired lifetime) with the 120 s deadline.
+     */
+    fun begin(ctx: Context, conn: Socket, fp: String, desktopDer: ByteArray, params: JSONObject): Pair<Session, JSONObject> {
+        val rawName = if (params.isNull("name")) "" else params.opt("name") as? String ?: ""
+        val name = cleanName(rawName)
+        if (name.isEmpty()) throw OmalawnError(LinkServer.BAD_PARAMS, "name must be a non-empty string")
+        val commit = (if (params.isNull("commit")) "" else params.opt("commit") as? String ?: "").lowercase()
+        if (!HEX64.matches(commit)) throw OmalawnError(LinkServer.BAD_PARAMS, "commit must be SHA-256 as 64 hex characters")
+        // the window ("Pair a computer") keeps its own flow; otherwise the home screen showing opens it
+        val viaHome = !PairingGate.isWindowOpen() && PairingGate.homeShowing(ctx)
+        if (!viaHome && !PairingGate.isWindowOpen()) {
+            Log.i(TAG, "pair request refused: the home screen is not showing and pairing is not open")
+            throw OmalawnError(
+                PairingGate.PAIRING_CLOSED,
+                "pairing is closed; open the home screen on the phone (or Pair a computer)",
+            )
+        }
+        if (PairingGate.isLocal(conn.inetAddress) && !PairingGate.localAllowed(ctx)) {
+            Log.i(TAG, "pair request refused: it came from this phone itself")
+            throw OmalawnError(PairingGate.LOCAL_PAIRING, "pairing requests from this phone itself are refused")
+        }
+        if (!canNotify(ctx)) {
+            NotifyPermission.neededNow(ctx) // the next time the home screen opens, it asks
+            Log.i(TAG, "pair request refused: notifications are off")
+            throw OmalawnError(
+                "notifications_off",
+                "notifications for Homa Lawn are off on the phone, so it cannot ask; open the home screen and allow them",
+            )
+        }
+        val noncePhone = ByteArray(16).also { random.nextBytes(it) }
+        val session = synchronized(this) {
+            if (current != null) throw OmalawnError("pair_busy", "another pairing request is waiting for an answer")
+            val now = System.currentTimeMillis()
+            while (recent.isNotEmpty() && now - recent.first() >= WINDOW_MS) recent.removeFirst()
+            if (recent.size >= MAX_PER_WINDOW) {
+                val wait = (recent.first() + WINDOW_MS - now + 59_999) / 60_000
+                throw OmalawnError("rate_limited", "try again in $wait minute${if (wait == 1L) "" else "s"}")
+            }
+            val s = Session(UUID.randomUUID().toString(), conn, fp, name, hex(commit), noncePhone, desktopDer, now + TIMEOUT_MS, viaHome)
+            if (!LinkServer.enterPairing(conn, TIMEOUT_MS) { finish(ctx, s.token, TIMEOUT) }) {
+                throw OmalawnError("pair_busy", "this connection cannot take the pairing slot")
+            }
+            recent.addLast(now)
+            current = s
+            s
+        }
+        Log.i(TAG, "pair request from \"$name\" fp=${fp.take(16)}${if (viaHome) " (home screen showing)" else ""}")
+        val res = JSONObject()
+            .put("nonce_phone", toHex(noncePhone))
+            .put("name", name)
+            .put("expires_in", TIMEOUT_MS / 1000)
+        return session to res
+    }
+
+    /**
+     * `link.pair_reveal {nonce_desktop}`: checks it against the commitment, derives the words and
+     * posts the prompt (no sooner than [COOLDOWN_MS] after the previous prompt ended). A nonce that
+     * does not match ends the request.
+     */
+    fun reveal(ctx: Context, session: Session, params: JSONObject): JSONObject {
+        if (session.words != null) throw OmalawnError("pair_busy", "the nonce was already revealed")
+        val nd = (if (params.isNull("nonce_desktop")) "" else params.opt("nonce_desktop") as? String ?: "").lowercase()
+        if (!HEX32.matches(nd)) throw OmalawnError(LinkServer.BAD_PARAMS, "nonce_desktop must be 16 bytes as 32 hex characters")
+        val nonceDesktop = hex(nd)
+        if (!MessageDigest.isEqual(commitment(nonceDesktop), session.commit)) {
+            finish(ctx, session.token, BAD_COMMIT)
+            throw OmalawnError(BAD_COMMIT, "nonce_desktop does not match the commitment")
+        }
+        val words = sas(ctx, Identity.certificate().encoded, session.desktopDer, session.noncePhone, nonceDesktop)
+        session.words = words
+        val delay = synchronized(this) { (lastEnd + COOLDOWN_MS - System.currentTimeMillis()).coerceAtLeast(0) }
+        session.visibleFrom = System.currentTimeMillis() + delay
+        main.postDelayed({
+            if (synchronized(this) { current === session } && !screenWaiting) {
+                if (!(session.viaHome && PairingGate.homeShowing(ctx) && openScreen(ctx, session))) notifyPrompt(ctx, session)
+            }
+        }, delay)
+        return JSONObject().put("words", JSONArray(words))
+    }
+
+    /**
+     * `link.pair_wait`: blocks until the session ends; never longer than its deadline (+ a margin).
+     * Every [WATCH_MS] it asks [stillThere] whether the computer is still connected; when it is not
+     * (it hung up, e.g. Ctrl-C), the request ends as [GONE] and an Accept tapped later pins nothing.
+     */
+    fun await(ctx: Context, session: Session, stillThere: () -> Boolean): String {
+        val end = session.deadline + 5_000
+        while (true) {
+            val left = end - System.currentTimeMillis()
+            if (left <= 0) return session.outcome ?: TIMEOUT
+            if (session.done.await(minOf(left, WATCH_MS), TimeUnit.MILLISECONDS)) return session.outcome ?: TIMEOUT
+            if (!stillThere()) {
+                finish(ctx, session.token, GONE)
+                return session.outcome ?: GONE
+            }
+        }
+    }
+
+    /** A prompt left by an earlier process (its session died with it) is removed at service start. */
+    fun cancelLeftovers(ctx: Context) {
+        val nm = ctx.getSystemService(NotificationManager::class.java) ?: return
+        val live = synchronized(this) { current?.token }
+        nm.activeNotifications.filter { it.id == NOTIFICATION_ID && it.tag != live }.forEach {
+            nm.cancel(it.tag, it.id)
+            Log.i(TAG, "removed a pairing prompt left by an earlier start")
+        }
+    }
+
+    /**
+     * Reject / dismissal from the notification (via LinkService), or Reject from the confirmation
+     * screen. Never [ACCEPTED]: only [acceptFromScreen] pins. A stale token does nothing.
+     */
+    fun decide(ctx: Context, token: String?, outcome: String) {
+        if (token != null && outcome != ACCEPTED) finish(ctx, token, outcome)
+    }
+
+    /** Debug provider: the pending request's token (null when none). */
+    fun currentToken(): String? = synchronized(this) { current?.token }
+
+    /** The request the waiting pairing screen should show now: its token, null when none (yet). */
+    fun forScreen(): String? = synchronized(this) {
+        current?.takeIf { it.words != null && System.currentTimeMillis() >= it.visibleFrom }?.token
+    }
+
+    /** What the confirmation screen shows for [token]: (computer name, words), null once it ended. */
+    fun pending(token: String?): Pair<String, List<String>>? = synchronized(this) {
+        current?.takeIf { it.token == token }?.let { s -> s.words?.let { s.name to it } }
+    }
+
+    /** A real tap on Accept in [PairConfirmActivity]; false when the request has ended. */
+    fun acceptFromScreen(ctx: Context, token: String): Boolean {
+        if (pending(token) == null) return false
+        finish(ctx, token, ACCEPTED)
+        return true
+    }
+
+    /** A tap that arrived while the phone was locked: refused, the prompt is shown again. */
+    fun repost(ctx: Context, token: String?) {
+        val s = synchronized(this) { current?.takeIf { it.token == token && it.words != null } } ?: return
+        main.post { if (synchronized(this) { current === s }) notifyPrompt(ctx, s) }
+    }
+
+    /** The connection of [conn] ended; a pending request from it is withdrawn. */
+    fun connectionGone(ctx: Context, conn: Socket) {
+        val s = synchronized(this) { current?.takeIf { it.conn === conn } } ?: return
+        finish(ctx, s.token, GONE)
+    }
+
+    private fun finish(ctx: Context, token: String, outcome: String) {
+        val s = synchronized(this) {
+            val c = current
+            if (c == null || c.token != token) return
+            if (outcome == ACCEPTED && c.words == null) return // nothing was shown, nothing to accept
+            current = null
+            lastEnd = System.currentTimeMillis()
+            c
+        }
+        // a computer that already hung up gets nothing pinned
+        val result = if (outcome == ACCEPTED && (s.conn.isClosed || s.conn.isInputShutdown)) GONE else outcome
+        val accepted = result == ACCEPTED
+        if (accepted) {
+            Pins.add(ctx, s.fp, s.name) // pinned before pair_wait answers
+            PairingGate.closeWindow() // one pairing per "Pair a computer"
+        }
+        s.outcome = result
+        s.done.countDown()
+        ctx.getSystemService(NotificationManager::class.java)?.cancel(s.token, NOTIFICATION_ID)
+        synchronized(s.intents) {
+            s.intents.forEach { it.cancel() } // an old notification's buttons are dead
+            if (BuildConfig.DEBUG) staleAccept = s.accept
+        }
+        Log.i(TAG, "pair request from \"${s.name}\" ended: $result")
+        LinkServer.leavePairing(s.conn, accepted, s.fp)
+    }
+
+    /** Test hook (debug provider): forget the rate window, the cool-down and the handshake counts. */
+    @Synchronized
+    fun resetRateLimit() {
+        recent.clear()
+        lastEnd = 0L
+        PairingGate.resetHandshakes()
+    }
+
+    /**
+     * Test hook (debug provider): fire the Review action of the last ended session (`stale`, must be
+     * dead) or of the pending one (`current`: opens the confirmation screen, pins nothing), as an
+     * app with notification access could.
+     */
+    fun fireAccept(which: String): String {
+        val pi = (if (which == "current") synchronized(this) { current?.accept } else staleAccept) ?: return "none"
+        return try {
+            pi.send()
+            "sent"
+        } catch (_: PendingIntent.CanceledException) {
+            "canceled"
+        }
+    }
+
+    /**
+     * Opens the pairing screen in front with [s] (the home screen is showing, so Android lets the
+     * home app start it). False when it cannot be started: the caller posts the notification.
+     */
+    private fun openScreen(ctx: Context, s: Session): Boolean = try {
+        ctx.startActivity(
+            Intent(ctx, PairConfirmActivity::class.java)
+                .putExtra(EXTRA_TOKEN, s.token)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP),
+        )
+        Log.i(TAG, "pair request from \"${s.name}\" shown on the pairing screen")
+        true
+    } catch (e: Exception) {
+        Log.w(TAG, "could not open the pairing screen; posting the notification", e)
+        false
+    }
+
+    private fun notifyPrompt(ctx: Context, s: Session) {
+        val nm = ctx.getSystemService(NotificationManager::class.java) ?: return
+        val words = s.words ?: return
+        // below Android 12 actions cannot demand an unlock: keep the prompt off the lock screen
+        val lockVisibility = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            Notification.VISIBILITY_PRIVATE
+        } else {
+            Notification.VISIBILITY_SECRET
+        }
+        nm.createNotificationChannel(
+            NotificationChannel(CHANNEL, "Homa Lawn pairing", NotificationManager.IMPORTANCE_HIGH).apply {
+                description = "Asks before a computer may control this phone through Homa Lawn"
+                lockscreenVisibility = lockVisibility
+                setShowBadge(false)
+            },
+        )
+        val actions = synchronized(s.intents) {
+            s.intents.forEach { it.cancel() }
+            s.intents.clear()
+            fun action(action: String): PendingIntent {
+                val code = synchronized(this) { ++codeSeq }
+                return PendingIntent.getService(
+                    ctx,
+                    code,
+                    Intent(ctx, LinkService::class.java).setAction(action).putExtra(EXTRA_TOKEN, s.token),
+                    PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_CANCEL_CURRENT,
+                ).also { s.intents.add(it) }
+            }
+            // Review opens the confirmation screen; the notification itself cannot accept
+            val review = PendingIntent.getActivity(
+                ctx,
+                synchronized(this) { ++codeSeq },
+                Intent(ctx, PairConfirmActivity::class.java)
+                    .putExtra(EXTRA_TOKEN, s.token)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP),
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_CANCEL_CURRENT,
+            ).also { s.intents.add(it) }
+            Triple(review, action(ACTION_REJECT), action(ACTION_DISMISS)).also { s.accept = it.first }
+        }
+        val text = words.joinToString(" ")
+        // what the lock screen shows when the user hides sensitive content: no name, no words, no buttons
+        val public = NotificationCompat.Builder(ctx, CHANNEL)
+            .setSmallIcon(R.drawable.ic_home_screen)
+            .setContentTitle("Homa Lawn pairing request")
+            .setContentText("Unlock the phone to answer")
+            .build()
+        val n = NotificationCompat.Builder(ctx, CHANNEL)
+            .setSmallIcon(R.drawable.ic_home_screen)
+            .setContentTitle("Pair with ${s.name}? $text")
+            .setContentText(text)
+            .setSubText("Homa Lawn")
+            .setStyle(
+                NotificationCompat.BigTextStyle().bigText(
+                    "$text\n\nTap Review and accept only if the computer shows the same four words. " +
+                        "A paired computer can change this phone's home screen and, with screen control on, " +
+                        "see and operate the screen.",
+                ),
+            )
+            .setPriority(NotificationCompat.PRIORITY_HIGH)
+            .setVisibility(
+                if (lockVisibility == Notification.VISIBILITY_SECRET) NotificationCompat.VISIBILITY_SECRET
+                else NotificationCompat.VISIBILITY_PRIVATE,
+            )
+            .setPublicVersion(public)
+            .setOnlyAlertOnce(true)
+            .setAutoCancel(false)
+            .setDeleteIntent(actions.third)
+            .setContentIntent(actions.first)
+            .addAction(NotificationCompat.Action.Builder(0, "Reject", actions.second).setAuthenticationRequired(true).build())
+            .addAction(NotificationCompat.Action.Builder(0, "Review", actions.first).setAuthenticationRequired(true).build())
+            .build()
+        nm.notify(s.token, NOTIFICATION_ID, n) // tagged per session: a new request never reuses an old one's
+    }
+}
diff --git a/lawnchair/src/app/lawnchair/omalawn/link/PairingGate.kt b/lawnchair/src/app/lawnchair/omalawn/link/PairingGate.kt
new file mode 100644
index 0000000000..113529b66a
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/link/PairingGate.kt
@@ -0,0 +1,136 @@
+package app.lawnchair.omalawn.link
+
+import android.app.KeyguardManager
+import android.content.Context
+import android.os.SystemClock
+import android.provider.Settings
+import com.android.launcher3.BuildConfig
+import java.net.InetAddress
+import java.net.NetworkInterface
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * Who may even ask to pair, and when (spec D5, final review C2/I3):
+ *
+ * - **When**: `link.pair_request` is refused (`pairing_closed`) unless the home screen is showing
+ *   ([homeShowing]: Lawnchair's launcher activity resumed and the phone not locked; the Flux model,
+ *   spec N5 of new-phone setup) or the user opened the **pairing window**. "Pair a computer" in
+ *   the Homa Lawn notification opens the pairing screen ([PairConfirmActivity]), which keeps the
+ *   window open while it shows, at most [SCREEN_WINDOW_MS], and closes it when it is left; the
+ *   debug hook opens it for [WINDOW_MS]. A successful pairing closes it again.
+ * - **Local requests** (loopback, or one of the phone's own addresses: an app on this phone) are
+ *   refused (`local_pairing`) unless the debug build's shell-only toggle `debug_allow_local_pairing`
+ *   is on. The toggle lasts until it is switched off or the phone reboots (it stores the boot
+ *   count). Tests need it: `adb forward` arrives as loopback.
+ * - A **handshake limit** per remote address: at most [MAX_HANDSHAKES] connection attempts per
+ *   [HANDSHAKE_WINDOW_MS] that did not turn out to be a paired computer (a paired computer's
+ *   handshake is given back). Loopback is exempt while the local toggle is on (the test suite
+ *   dials everything through one forwarded port).
+ */
+object PairingGate {
+    const val WINDOW_MS = 120_000L
+    /** The pairing screen keeps the window open while it shows, for at most this long. */
+    const val SCREEN_WINDOW_MS = 300_000L
+    const val MAX_HANDSHAKES = 10
+    const val HANDSHAKE_WINDOW_MS = 60_000L
+    const val PAIRING_CLOSED = "pairing_closed"
+    const val LOCAL_PAIRING = "local_pairing"
+    private const val KEY_LOCAL_BOOT = "allow_local_pairing_boot"
+
+    @Volatile private var windowUntil = 0L // elapsedRealtime; 0 = closed
+    private val listeners = CopyOnWriteArrayList<() -> Unit>()
+
+    // -- the pairing window ---------------------------------------------------------------------
+
+    fun openWindow(ms: Long = WINDOW_MS) {
+        windowUntil = SystemClock.elapsedRealtime() + ms
+        changed()
+    }
+
+    fun closeWindow() {
+        if (windowUntil == 0L) return
+        windowUntil = 0L
+        changed()
+    }
+
+    /** Milliseconds the window stays open, 0 when closed. */
+    fun windowLeftMs(): Long = (windowUntil - SystemClock.elapsedRealtime()).coerceAtLeast(0)
+
+    fun isWindowOpen() = windowLeftMs() > 0
+
+    fun onChange(l: () -> Unit) = listeners.add(l)
+    fun removeListener(l: () -> Unit) = listeners.remove(l)
+    private fun changed() = listeners.forEach { runCatching { it() } }
+
+    // -- the home screen showing ------------------------------------------------------------------
+
+    @Volatile private var launcherResumed = false
+
+    /** From the launcher activity's onResume / onPause. */
+    fun launcherResumed(resumed: Boolean) {
+        launcherResumed = resumed
+    }
+
+    /** Lawnchair's home screen is in front and the phone is unlocked: a pair request may come in. */
+    fun homeShowing(ctx: Context): Boolean =
+        launcherResumed && ctx.getSystemService(KeyguardManager::class.java)?.isKeyguardLocked == false
+
+    // -- local requests ---------------------------------------------------------------------------
+
+    /** Loopback, any-local, or an address one of this phone's own interfaces has. */
+    fun isLocal(a: InetAddress?): Boolean {
+        if (a == null) return true
+        if (a.isLoopbackAddress || a.isAnyLocalAddress) return true
+        return try {
+            NetworkInterface.getByInetAddress(a) != null
+        } catch (_: Exception) {
+            false
+        }
+    }
+
+    private fun bootCount(ctx: Context) = Settings.Global.getInt(ctx.contentResolver, Settings.Global.BOOT_COUNT, -1)
+
+    fun localAllowed(ctx: Context): Boolean {
+        if (!BuildConfig.DEBUG) return false
+        val p = ctx.getSharedPreferences(LinkService.DEBUG_PREFS, Context.MODE_PRIVATE)
+        val stored = p.getInt(KEY_LOCAL_BOOT, -2)
+        return stored >= 0 && stored == bootCount(ctx)
+    }
+
+    /** Debug provider only (shell uid). */
+    fun setLocalAllowed(ctx: Context, on: Boolean) {
+        val e = ctx.getSharedPreferences(LinkService.DEBUG_PREFS, Context.MODE_PRIVATE).edit()
+        if (on) e.putInt(KEY_LOCAL_BOOT, bootCount(ctx)) else e.remove(KEY_LOCAL_BOOT)
+        e.commit()
+    }
+
+    // -- handshake limit --------------------------------------------------------------------------
+
+    private val attempts = HashMap<String, ArrayDeque<Long>>() // address -> attempt times, oldest first
+
+    /**
+     * A new connection from [a]: false when it is over the limit (close it without a handshake).
+     * The caller gives the attempt back with [refund] once the computer turns out to be paired.
+     */
+    fun admitHandshake(ctx: Context, a: InetAddress?): Boolean {
+        if (a != null && a.isLoopbackAddress && localAllowed(ctx)) return true
+        val key = a?.hostAddress ?: "?"
+        val now = SystemClock.elapsedRealtime()
+        synchronized(attempts) {
+            val q = attempts.getOrPut(key) { ArrayDeque() }
+            while (q.isNotEmpty() && now - q.first() >= HANDSHAKE_WINDOW_MS) q.removeFirst()
+            if (q.size >= MAX_HANDSHAKES) return false
+            q.addLast(now)
+            if (attempts.size > 256) attempts.entries.removeAll { it.value.isEmpty() } // bounded
+            return true
+        }
+    }
+
+    fun refund(a: InetAddress?) {
+        val key = a?.hostAddress ?: "?"
+        synchronized(attempts) { attempts[key]?.removeLastOrNull() }
+    }
+
+    /** Debug provider (`debug_pair_reset`): forget every address's attempts. */
+    fun resetHandshakes() = synchronized(attempts) { attempts.clear() }
+}
diff --git a/lawnchair/src/app/lawnchair/omalawn/link/Pins.kt b/lawnchair/src/app/lawnchair/omalawn/link/Pins.kt
new file mode 100644
index 0000000000..43d40ecdde
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/link/Pins.kt
@@ -0,0 +1,76 @@
+package app.lawnchair.omalawn.link
+
+import android.content.Context
+import android.system.Os
+import java.io.File
+import java.util.concurrent.CopyOnWriteArrayList
+import org.json.JSONObject
+
+/**
+ * Computers allowed to use the link: certificate SHA-256 (lowercase hex) → name, kept in
+ * app-private no-backup storage (`no_backup/omalawn_link_pins.json`, 0600). Checked on every request,
+ * so forgetting a computer takes effect on its open connection too.
+ */
+object Pins {
+    private val FP = Regex("[0-9a-f]{64}")
+    private val listeners = CopyOnWriteArrayList<() -> Unit>()
+    private var cache: JSONObject? = null
+
+    private fun file(ctx: Context) = File(ctx.noBackupFilesDir, "omalawn_link_pins.json")
+
+    @Synchronized
+    private fun load(ctx: Context): JSONObject = cache ?: run {
+        val f = file(ctx)
+        val o = try {
+            if (f.isFile) JSONObject(f.readText()) else JSONObject()
+        } catch (_: Exception) {
+            JSONObject()
+        }
+        cache = o
+        o
+    }
+
+    @Synchronized
+    private fun save(ctx: Context, o: JSONObject) {
+        val f = file(ctx)
+        val tmp = File(f.path + ".tmp")
+        tmp.writeText(o.toString())
+        Os.chmod(tmp.absolutePath, 0b110_000_000)
+        if (!tmp.renameTo(f)) error("cannot save pins")
+        cache = o
+    }
+
+    fun isPinned(ctx: Context, fp: String) = synchronized(this) { load(ctx).has(fp) }
+
+    fun count(ctx: Context) = synchronized(this) { load(ctx).length() }
+
+    fun name(ctx: Context, fp: String): String? = synchronized(this) { load(ctx).optJSONObject(fp)?.optString("name") }
+
+    fun add(ctx: Context, fp: String, name: String) {
+        require(FP.matches(fp)) { "fingerprint must be 64 lowercase hex characters" }
+        synchronized(this) {
+            val o = JSONObject(load(ctx).toString())
+            o.put(fp, JSONObject().put("name", name.take(64)).put("added", System.currentTimeMillis()))
+            save(ctx, o)
+        }
+        changed()
+    }
+
+    fun remove(ctx: Context, fp: String) {
+        synchronized(this) {
+            val o = JSONObject(load(ctx).toString())
+            o.remove(fp)
+            save(ctx, o)
+        }
+        changed()
+    }
+
+    fun clear(ctx: Context) {
+        synchronized(this) { save(ctx, JSONObject()) }
+        changed()
+    }
+
+    fun onChange(l: () -> Unit) = listeners.add(l)
+    fun removeListener(l: () -> Unit) = listeners.remove(l)
+    private fun changed() = listeners.forEach { runCatching { it() } }
+}
