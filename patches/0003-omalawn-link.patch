+package app.lawnchair.omalawn.link
+
+import java.io.ByteArrayOutputStream
+import java.io.EOFException
+import java.io.InputStream
+import java.io.OutputStream
+import org.json.JSONObject
+
+/** A frame that breaks the protocol; the connection cannot continue after it. */
+class FrameError(val code: String, message: String) : Exception(message)
+
+/**
+ * Wire format (spec D6): newline-delimited JSON; a binary payload is announced by a line
+ * `{"id":n,"blob":len}` (optionally with `"result":{…}` metadata) followed by exactly `len` raw
+ * bytes. Lines are capped at [maxLine] bytes (newline excluded), blobs at [maxBlob].
+ */
+class FrameReader(
+    input: InputStream,
+    private val maxLine: Int = MAX_LINE,
+    private val maxBlob: Int = MAX_BLOB,
+) {
+    private val inp = input.buffered(64 * 1024)
+
+    /** The next line as JSON, or null at a clean end of stream (between frames). */
+    fun readJson(): JSONObject? {
+        val line = readLine() ?: return null
+        return try {
+            JSONObject(line)
+        } catch (e: Exception) {
+            throw FrameError(BAD_FRAME, "not a JSON object")
+        }
+    }
+
+    private fun readLine(): String? {
+        val buf = ByteArrayOutputStream()
+        while (true) {
+            val b = inp.read()
+            if (b < 0) {
+                if (buf.size() == 0) return null
+                throw EOFException("stream ended inside a line")
+            }
+            if (b == '\n'.code) break
+            if (buf.size() >= maxLine) throw FrameError(FRAME_TOO_LARGE, "line longer than $maxLine bytes")
+            buf.write(b)
+        }
+        return buf.toString(Charsets.UTF_8.name()).trimEnd('\r')
+    }
+
+    /** Reads the blob frame that must follow request [id]. */
+    fun readBlob(id: Any?): ByteArray {
+        val head = readJson() ?: throw EOFException("stream ended before the blob")
+        if (!head.has("blob") || head.opt("id")?.toString() != id?.toString()) {
+            throw FrameError(BAD_FRAME, "expected a blob frame for id $id")
+        }
+        val len = head.optLong("blob", -1)
+        if (len < 0) throw FrameError(BAD_FRAME, "bad blob length")
+        if (len > maxBlob) throw FrameError(FRAME_TOO_LARGE, "blob of $len bytes exceeds $maxBlob")
+        val out = ByteArray(len.toInt())
+        var off = 0
+        while (off < out.size) {
+            val n = inp.read(out, off, out.size - off)
+            if (n < 0) throw EOFException("stream ended inside a blob")
+            off += n
+        }
+        return out
+    }
+
+    companion object {
+        const val MAX_LINE = 1 shl 20 // 1 MiB
+        const val MAX_BLOB = 32 shl 20 // 32 MiB
+        const val FRAME_TOO_LARGE = "frame_too_large"
+        const val BAD_FRAME = "bad_frame"
+    }
+}
+
+class FrameWriter(output: OutputStream) {
+    private val out = output.buffered(64 * 1024)
+
+    @Synchronized
+    fun json(o: JSONObject) {
+        out.write(o.toString().toByteArray(Charsets.UTF_8))
+        out.write('\n'.code)
+        out.flush()
+    }
+
+    fun result(id: Any?, r: Any) = json(JSONObject().put("id", id ?: JSONObject.NULL).put("result", r))
+
+    fun error(id: Any?, code: String, message: String) = json(
+        JSONObject().put("id", id ?: JSONObject.NULL)
+            .put("error", JSONObject().put("code", code).put("message", message)),
+    )
+
+    @Synchronized
+    fun blob(id: Any?, bytes: ByteArray, meta: JSONObject? = null) {
+        val head = JSONObject().put("id", id ?: JSONObject.NULL).put("blob", bytes.size)
+        if (meta != null) head.put("result", meta)
+        out.write(head.toString().toByteArray(Charsets.UTF_8))
+        out.write('\n'.code)
+        out.write(bytes)
+        out.flush()
+    }
+}
