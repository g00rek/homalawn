--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/link/Nsd.kt
@@ -0,0 +1,60 @@
+package app.lawnchair.omalawn.link
+
+import android.content.Context
+import android.net.nsd.NsdManager
+import android.net.nsd.NsdServiceInfo
+import android.util.Log
+
+/**
+ * Advertises the link on the LAN as `_omalawn._tcp`, instance "OmaLawn", TXT `v=1` only: no
+ * model, no fingerprint, nothing that tells this phone apart from another Homa Lawn phone or
+ * follows it from network to network. Only a hint for the desktop, which tries each hit and lets
+ * the pinned certificate decide. The system answers mDNS even when our sockets are unreachable,
+ * and it renames the instance on conflicts ("OmaLawn (2)").
+ */
+object Nsd {
+    const val TYPE = "_omalawn._tcp"
+    private const val TAG = "OmalawnLink"
+    private var listener: NsdManager.RegistrationListener? = null
+
+    @Synchronized
+    fun register(ctx: Context, port: Int) {
+        if (listener != null) return
+        val nsd = ctx.getSystemService(NsdManager::class.java) ?: return
+        val info = NsdServiceInfo().apply {
+            serviceName = "OmaLawn" // kept: wire compatibility
+            serviceType = TYPE
+            this.port = port
+            setAttribute("v", "1")
+        }
+        val l = object : NsdManager.RegistrationListener {
+            override fun onServiceRegistered(i: NsdServiceInfo) {
+                Log.i(TAG, "mDNS registered as '${i.serviceName}'")
+            }
+            override fun onRegistrationFailed(i: NsdServiceInfo, code: Int) {
+                Log.w(TAG, "mDNS registration failed: $code")
+                synchronized(this@Nsd) { if (listener === this) listener = null }
+            }
+            override fun onServiceUnregistered(i: NsdServiceInfo) {
+                Log.i(TAG, "mDNS unregistered")
+            }
+            override fun onUnregistrationFailed(i: NsdServiceInfo, code: Int) {
+                Log.w(TAG, "mDNS unregister failed: $code")
+            }
+        }
+        listener = l
+        try {
+            nsd.registerService(info, NsdManager.PROTOCOL_DNS_SD, l)
+        } catch (e: Exception) {
+            listener = null
+            Log.w(TAG, "mDNS registration threw", e)
+        }
+    }
+
+    @Synchronized
+    fun unregister(ctx: Context) {
+        val l = listener ?: return
+        listener = null
+        runCatching { ctx.getSystemService(NsdManager::class.java)?.unregisterService(l) }
+    }
+}
diff --git a/lawnchair/src/app/lawnchair/omalawn/link/PairConfirmActivity.kt b/lawnchair/src/app/lawnchair/omalawn/link/PairConfirmActivity.kt
