+++ b/lawnchair/src/app/lawnchair/omalawn/link/PairConfirmActivity.kt
@@ -0,0 +1,290 @@
+package app.lawnchair.omalawn.link
+
+import android.annotation.SuppressLint
+import android.app.Activity
+import android.app.KeyguardManager
+import android.content.Intent
+import android.graphics.Typeface
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.accessibility.AccessibilityNodeInfo
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.TextView
+
+/**
+ * Lawnchair's pairing screen, and the only place a pairing can be accepted (final review C2).
+ * Not exported, so only Lawnchair's own PendingIntents reach it. Two ways in:
+ *
+ * - "Pair a computer" in the Homa Lawn notification ([ACTION_WAIT]): the screen says "Waiting for a
+ *   computer…" and keeps the pairing window ([PairingGate]) open while it shows, at most
+ *   [PairingGate.SCREEN_WINDOW_MS]; leaving it (Cancel, Back, Home, screen off) closes the window.
+ *   Tapping "Pair a computer" again only brings this one screen forward (singleTop). When a
+ *   computer's request arrives, the same screen switches in place to its name and four words
+ *   with Reject / Accept, and no notification is posted for it. A request still open when the
+ *   screen is left gets its notification after all.
+ * - Review on the "Pair with <name>?" notification, or a request taken while the home screen was
+ *   showing ([Pairing.EXTRA_TOKEN]): the request at once. Leaving the screen with that request
+ *   still open (re)posts its notification (Review / Reject), the same fallback as above.
+ *
+ * Accept pins the computer only on a real tap:
+ * - touches are filtered while another window covers it (`filterTouchesWhenObscured`), a touch
+ *   that Android marks as (partially) obscured is ignored, and other apps' overlays are hidden
+ *   while it shows (Android 12+);
+ * - Accept answers only to a finger lifted on it: an accessibility "click" (or any performClick
+ *   without that touch) does nothing; a finger that went down before the words had been shown
+ *   for [ARM_MS] does nothing either (a tap meant for Cancel cannot land on Accept);
+ * - not shown over the lock screen, and Accept is refused while the phone is locked.
+ *
+ * Reject works any way it is pressed. The request view closes by itself when the request ends
+ * (back to waiting while the window is still open).
+ */
+class PairConfirmActivity : Activity() {
+
+    private val main = Handler(Looper.getMainLooper())
+    private var token: String? = null // the request on screen, null while waiting
+    private var holding = false // this screen opened the pairing window and keeps it open
+    private var shownAt = 0L // uptimeMillis when the current request's words appeared
+    private var touchDownAt = 0L // uptimeMillis of the finger-down of the current gesture on Accept
+    private var touchUpAt = 0L // uptimeMillis of the last unobscured finger-up on Accept
+    private var status: TextView? = null
+
+    private val watch = object : Runnable {
+        override fun run() {
+            val t = token
+            if (t != null) {
+                if (Pairing.pending(t) == null) { // the request ended without an Accept here
+                    token = null
+                    if (holding && PairingGate.isWindowOpen()) showWaiting("That request ended.") else finish()
+                }
+            } else if (holding) {
+                val next = Pairing.forScreen()
+                when {
+                    next != null -> showRequest(next)
+                    !PairingGate.isWindowOpen() -> finish() // the 5 minutes are over
+                }
+            }
+            if (!isFinishing) main.postDelayed(this, WATCH_MS)
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) window.setHideOverlayWindows(true)
+        handle(intent)
+    }
+
+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        setIntent(intent)
+        handle(intent)
+    }
+
+    private fun handle(intent: Intent) {
+        if (intent.action == ACTION_WAIT) {
+            if (!holding) {
+                holding = true
+                PairingGate.openWindow(PairingGate.SCREEN_WINDOW_MS)
+                Log.i(TAG, "pairing opened on the pairing screen (at most ${PairingGate.SCREEN_WINDOW_MS / 1000} s)")
+            }
+            Pairing.screenWaiting = true
+            if (token == null) showWaiting(null)
+            return
+        }
+        val t = intent.getStringExtra(Pairing.EXTRA_TOKEN)
+        when {
+            Pairing.pending(t) != null -> showRequest(t!!)
+            token == null && !holding -> finish()
+        }
+    }
+
+    private fun pad() = (24 * resources.displayMetrics.density).toInt()
+
+    private fun showWaiting(note: String?) {
+        token = null
+        val pad = pad()
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(pad, pad, pad, pad)
+            filterTouchesWhenObscured = true
+        }
+        root.addView(TextView(this).apply {
+            text = "Waiting for a computer…"
+            textSize = 26f
+            setTypeface(typeface, Typeface.BOLD)
+        })
+        root.addView(TextView(this).apply {
+            text = "On the computer run: homalawn pair"
+            textSize = 16f
+            setPadding(0, pad / 2, 0, 0)
+        })
+        status = TextView(this).apply {
+            text = note ?: ""
+            setPadding(0, pad / 2, 0, 0)
+        }
+        root.addView(status)
+        val buttons = LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.START // never where Accept will appear
+        }
+        buttons.addView(Button(this).apply {
+            text = "Cancel"
+            setOnClickListener { finish() }
+        })
+        root.addView(buttons)
+        setContentView(root)
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    private fun showRequest(t: String) {
+        val (name, words) = Pairing.pending(t) ?: return
+        token = t
+        shownAt = SystemClock.uptimeMillis()
+        touchDownAt = 0L
+        touchUpAt = 0L
+        val pad = pad()
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(pad, pad, pad, pad)
+            filterTouchesWhenObscured = true
+        }
+        root.addView(TextView(this).apply {
+            text = "Pair with $name?"
+            textSize = 20f
+            setTypeface(typeface, Typeface.BOLD)
+        })
+        root.addView(TextView(this).apply {
+            text = words.joinToString(" ")
+            textSize = 30f
+            setTypeface(Typeface.MONOSPACE, Typeface.BOLD)
+            gravity = Gravity.CENTER
+            setPadding(0, pad / 2, 0, pad / 2)
+        })
+        root.addView(TextView(this).apply {
+            text = "Accept only if the computer shows the same four words. A paired computer can change this " +
+                "phone's home screen and, with screen control on, see and operate the screen."
+        })
+        status = TextView(this).apply { setPadding(0, pad / 2, 0, 0) }
+        root.addView(status)
+        val buttons = LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.END
+            filterTouchesWhenObscured = true
+        }
+        buttons.addView(Button(this).apply {
+            text = "Reject"
+            filterTouchesWhenObscured = true
+            setOnClickListener {
+                Pairing.decide(applicationContext, token, Pairing.REJECTED)
+                finish()
+            }
+        })
+        val accept = Button(this).apply {
+            text = "Accept"
+            filterTouchesWhenObscured = true
+            setOnTouchListener { _, e -> onAcceptTouch(e) }
+            setOnClickListener { onAcceptClick() }
+            // an accessibility service's "click" is not the user's finger: offer no click action
+            setAccessibilityDelegate(object : View.AccessibilityDelegate() {
+                override fun performAccessibilityAction(host: View, action: Int, args: Bundle?): Boolean =
+                    if (action == AccessibilityNodeInfo.ACTION_CLICK) false else super.performAccessibilityAction(host, action, args)
+            })
+        }
+        buttons.addView(accept)
+        root.addView(buttons)
+        setContentView(root)
+    }
+
+    private fun obscured(e: MotionEvent): Boolean {
+        if (e.flags and MotionEvent.FLAG_WINDOW_IS_OBSCURED != 0) return true
+        return Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q &&
+            e.flags and MotionEvent.FLAG_WINDOW_IS_PARTIALLY_OBSCURED != 0
+    }
+
+    /** Remembers a finger lifted on Accept with nothing covering the screen; never consumes. */
+    private fun onAcceptTouch(e: MotionEvent): Boolean {
+        if (obscured(e)) {
+            touchUpAt = 0L
+            status?.text = "Another app is covering this screen; close it, then tap Accept."
+            Log.w(TAG, "pairing Accept ignored: the touch was obscured")
+            return true // swallowed: no click either
+        }
+        when (e.actionMasked) {
+            MotionEvent.ACTION_DOWN -> touchDownAt = e.downTime
+            MotionEvent.ACTION_UP -> touchUpAt = if (touchDownAt >= shownAt + ARM_MS) SystemClock.uptimeMillis() else 0L
+        }
+        return false
+    }
+
+    private fun onAcceptClick() {
+        val real = touchUpAt != 0L && SystemClock.uptimeMillis() - touchUpAt < TOUCH_TO_CLICK_MS
+        touchUpAt = 0L
+        if (!real) {
+            Log.w(TAG, "pairing Accept ignored: not a finger on the screen, or too soon after the words appeared")
+            return
+        }
+        if (getSystemService(KeyguardManager::class.java)?.isKeyguardLocked == true) {
+            status?.text = "Unlock the phone first."
+            return
+        }
+        val t = token ?: return finish()
+        if (!Pairing.acceptFromScreen(applicationContext, t)) status?.text = "This request has ended."
+        finish()
+    }
+
+    override fun onResume() {
+        super.onResume()
+        main.post(watch)
+    }
+
+    override fun onPause() {
+        main.removeCallbacks(watch)
+        super.onPause()
+    }
+
+    override fun onStop() {
+        super.onStop()
+        val shownToken = token
+        if (!holding && shownToken != null && Pairing.pending(shownToken) != null) {
+            // a request shown without the waiting screen (home screen or Review) and still open
+            Pairing.repost(applicationContext, shownToken)
+        }
+        if (holding) { // leaving the screen closes pairing; the screen itself goes away (noHistory)
+            holding = false
+            Pairing.screenWaiting = false
+            PairingGate.closeWindow()
+            Log.i(TAG, "pairing closed: the pairing screen was left")
+            // a request still open gets its notification after all (Review / Reject)
+            Pairing.repost(applicationContext, Pairing.currentToken())
+            if (!isFinishing) finish()
+        }
+    }
+
+    override fun onDestroy() {
+        main.removeCallbacks(watch)
+        if (holding) {
+            holding = false
+            Pairing.screenWaiting = false
+            PairingGate.closeWindow()
+            Pairing.repost(applicationContext, Pairing.currentToken())
+        }
+        super.onDestroy()
+    }
+
+    companion object {
+        private const val TAG = "OmalawnLink"
+        private const val WATCH_MS = 500L
+        private const val TOUCH_TO_CLICK_MS = 1000L
+        /** Accept ignores a finger that went down sooner than this after the words appeared. */
+        private const val ARM_MS = 1000L
+        /** "Pair a computer": open pairing and wait on this screen. */
+        const val ACTION_WAIT = "app.lawnchair.omalawn.link.PAIR_WAIT"
+    }
+}
