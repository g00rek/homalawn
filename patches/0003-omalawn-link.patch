new file mode 100644
index 0000000000..e2dde1f5f1
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/link/NotifyPermission.kt
@@ -0,0 +1,45 @@
+package app.lawnchair.omalawn.link
+
+import android.Manifest
+import android.app.Activity
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.Build
+
+/**
+ * The link's notification ("Forget all computers", later the pairing prompt) is invisible on
+ * Android 13+ without POST_NOTIFICATIONS. The launcher asks once per app version, and again when
+ * something the user must answer (a pair request) arrived while it was missing.
+ */
+object NotifyPermission {
+    private const val PREFS = "omalawn_link"
+    private const val KEY_ASKED = "notify_asked_version"
+    private const val KEY_NEEDED = "notify_needed"
+    const val REQUEST_CODE = 47100
+
+    fun missing(ctx: Context) = Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
+        ctx.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
+
+    /** Task 5: a pair request came in while notifications are off; the next launcher resume asks. */
+    fun neededNow(ctx: Context) {
+        if (missing(ctx)) prefs(ctx).edit().putBoolean(KEY_NEEDED, true).apply()
+    }
+
+    /** Called from the launcher when it comes to the front. */
+    fun maybeAsk(activity: Activity) {
+        if (!missing(activity)) return
+        val p = prefs(activity)
+        val version = version(activity)
+        if (p.getString(KEY_ASKED, null) == version && !p.getBoolean(KEY_NEEDED, false)) return
+        // recorded before asking: the dialog pauses and resumes the launcher, which must not ask again
+        p.edit().putString(KEY_ASKED, version).putBoolean(KEY_NEEDED, false).commit()
+        activity.requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), REQUEST_CODE)
+    }
+
+    private fun prefs(ctx: Context) = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    private fun version(ctx: Context): String {
+        val i = ctx.packageManager.getPackageInfo(ctx.packageName, 0)
+        return "${i.longVersionCode}/${i.versionName}"
+    }
+}
