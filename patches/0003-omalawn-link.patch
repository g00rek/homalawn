+package app.lawnchair.omalawn.link
+
+import android.annotation.SuppressLint
+import android.app.KeyguardManager
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.ForegroundServiceStartNotAllowedException
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.net.Uri
+import android.os.Build
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import android.os.PowerManager
+import android.os.SystemClock
+import android.provider.Settings
+import android.util.Log
+import androidx.core.app.NotificationCompat
+import app.lawnchair.omalawn.LayoutIo
+import com.android.launcher3.BuildConfig
+import com.android.launcher3.R
+
+/**
+ * Foreground service (type connectedDevice) that owns the link server and the mDNS advert. Its
+ * foreground state is what keeps the launcher's network open behind other apps and in Doze.
+ *
+ * It shares the launcher's process, so nothing may throw out of its lifecycle: when Android
+ * refuses the foreground start (e.g. ForegroundServiceStartNotAllowedException for a sticky
+ * restart while another app is in front), the service logs it and stops itself; the next start
+ * (home screen shown, boot, update, crash alarm) tries again.
+ *
+ * Its notification is also the phone's view of the link: how many computers are paired, which
+ * one is connected right now, whether screen control was used in the last [SCREEN_SHOWN_MS],
+ * and "Pair a computer", which opens Lawnchair's pairing screen ([PairConfirmActivity]); the
+ * screen keeps the pairing window ([PairingGate]) open while it shows.
+ */
+class LinkService : Service() {
+
+    private val main = Handler(Looper.getMainLooper())
+    private val refresh = Runnable { notifyStatus() }
+    private val changed: () -> Unit = {
+        main.removeCallbacks(refresh)
+        main.post(refresh)
+    }
+    private var refused = false // Android would not let this instance run in the foreground
+
+    override fun onCreate() {
+        super.onCreate()
+        createdAt = SystemClock.elapsedRealtime() // CrashExit: a crash soon after this is backed off by Android
+        if (BuildConfig.DEBUG) debugCrashHook()
+        val nm = getSystemService(NotificationManager::class.java)!!
+        nm.createNotificationChannel(
+            NotificationChannel(CHANNEL, "Homa Lawn link", NotificationManager.IMPORTANCE_LOW).apply {
+                description = "Shows that computers can reach this phone over the Homa Lawn link"
+                setShowBadge(false)
+            },
+        )
+        if (!goForeground()) {
+            refused = true
+            stopSelf()
+            return
+        }
+        Pairing.cancelLeftovers(this)
+        Pins.onChange(changed)
+        LinkServer.onChange(changed)
+        PairingGate.onChange(changed)
+        // a process started for this service (after a crash, an update, a boot without the home
+        // activity) would never load the home screen; give the launcher activity time to come first
+        main.postDelayed({ LayoutIo.kickLoad(this) }, LOAD_KICK_DELAY_MS)
+        Thread({
+            try {
+                Identity.ensure()
+                LinkServer.start(this)
+                Nsd.register(this, LinkServer.PORT)
+            } catch (e: Exception) {
+                Log.e(TAG, "link start failed", e)
+            }
+        }, "omalawn-link-start").start()
+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (refused) { // onCreate could not go foreground: this instance is on its way out
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        when (intent?.action) {
+            ACTION_FORGET_ALL -> {
+                Pins.clear(this)
+                Log.i(TAG, "all computers forgotten")
+            }
+            ACTION_OPEN_PAIRING -> { // the notification's action before the pairing screen; kept for old ones
+                PairingGate.openWindow()
+                Log.i(TAG, "pairing opened for ${PairingGate.WINDOW_MS / 1000} s")
+            }
+            Pairing.ACTION_REJECT -> {
+                val token = intent.getStringExtra(Pairing.EXTRA_TOKEN)
+                // on every Android version: no answer from a locked phone (12+ also asks for the
+                // unlock itself, via setAuthenticationRequired)
+                if (getSystemService(KeyguardManager::class.java)?.isKeyguardLocked == true) {
+                    Log.i(TAG, "pairing answer refused: the phone is locked")
+                    Pairing.repost(this, token)
+                } else {
+                    Pairing.decide(this, token, Pairing.REJECTED)
+                }
+            }
+            // the notification's old Accept: pins nothing any more (only PairConfirmActivity does)
+            Pairing.LEGACY_ACCEPT -> Log.w(TAG, "a pairing Accept sent to the service was ignored")
+            Pairing.ACTION_DISMISS -> Pairing.decide(this, intent.getStringExtra(Pairing.EXTRA_TOKEN), Pairing.DISMISSED)
+        }
+        // every startForegroundService() must be answered with startForeground(), even when the
+        // service already runs; it also refreshes "Keep connected" after the user granted it
+        if (!goForeground()) {
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        return START_STICKY
+    }
+
+    override fun onDestroy() {
+        main.removeCallbacksAndMessages(null)
+        Pins.removeListener(changed)
+        LinkServer.removeListener(changed)
+        PairingGate.removeListener(changed)
+        if (!refused) {
+            Nsd.unregister(this)
+            LinkServer.stop()
+        }
+        super.onDestroy()
+    }
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    /** Debug build: provider `debug_crash_link_start <n>` makes the next n service starts crash. */
+    private fun debugCrashHook() {
+        val p = getSharedPreferences(DEBUG_PREFS, MODE_PRIVATE)
+        val n = p.getInt(KEY_CRASH_STARTS, 0)
+        if (n > 0) {
+            p.edit().putInt(KEY_CRASH_STARTS, n - 1).commit()
+            throw IllegalStateException("debug_crash_link_start: deliberate crash ($n left)")
+        }
+    }
+
+    /** startForeground, or false (logged) when Android refuses it; never throws. */
+    private fun goForeground(): Boolean = try {
+        if (BuildConfig.DEBUG) debugRefuseHook()
+        val n = notification()
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            startForeground(NOTIFICATION_ID, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_CONNECTED_DEVICE)
+        } else {
+            startForeground(NOTIFICATION_ID, n)
+        }
+        true
+    } catch (e: Exception) { // ForegroundServiceStartNotAllowedException, SecurityException, ...
+        Log.w(TAG, "foreground start refused, stopping the link service: ${e.javaClass.simpleName}: ${e.message}")
+        false
+    }
+
+    /** Debug build: provider `debug_refuse_foreground <n>` makes the next n foreground starts fail as Android's would. */
+    private fun debugRefuseHook() {
+        val p = getSharedPreferences(DEBUG_PREFS, MODE_PRIVATE)
+        val n = p.getInt(KEY_REFUSE_FOREGROUND, 0)
+        if (n <= 0) return
+        p.edit().putInt(KEY_REFUSE_FOREGROUND, n - 1).commit()
+        val msg = "debug_refuse_foreground: deliberate refusal (${n - 1} left)"
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) throw ForegroundServiceStartNotAllowedException(msg)
+        throw IllegalStateException(msg)
+    }
+
+    private fun notifyStatus() {
+        if (refused) return
+        runCatching { getSystemService(NotificationManager::class.java)!!.notify(NOTIFICATION_ID, notification()) }
+        // the "in use" line and the pairing window end on their own: look again when they do
+        val next = listOf(LinkServer.screenShownLeftMs(SCREEN_SHOWN_MS), PairingGate.windowLeftMs()).filter { it > 0 }.minOrNull()
+        main.removeCallbacks(refresh)
+        if (next != null) main.postDelayed(refresh, next + 200)
+    }
+
+    private fun notification(): Notification {
+        val n = Pins.count(this)
+        val lines = mutableListOf<String>()
+        val connected = LinkServer.connectedNames(this)
+        if (connected.isNotEmpty()) lines.add("Connected: ${connected.joinToString(", ")}")
+        if (LinkServer.screenShownLeftMs(SCREEN_SHOWN_MS) > 0) lines.add("Screen control in use")
+        val window = PairingGate.windowLeftMs()
+        if (window > 0) lines.add("Pairing open for ${(window + 999) / 1000} s: run homalawn pair on the computer")
+        val b = NotificationCompat.Builder(this, CHANNEL)
+            .setSmallIcon(R.drawable.ic_home_screen)
+            .setContentTitle("Homa Lawn link · $n ${if (n == 1) "computer" else "computers"} paired")
+            .setOngoing(true)
+            .setShowWhen(false)
+            .setPriority(NotificationCompat.PRIORITY_LOW)
+            .setCategory(NotificationCompat.CATEGORY_SERVICE)
+        // opens Lawnchair's pairing screen, which keeps pairing open while it shows; tapped again,
+        // it brings the same screen forward
+        val open = PendingIntent.getActivity(
+            this,
+            3,
+            Intent(this, PairConfirmActivity::class.java)
+                .setAction(PairConfirmActivity.ACTION_WAIT)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+        b.addAction(0, "Pair a computer", open)
+        if (n > 0) {
+            val forget = PendingIntent.getService(
+                this,
+                1,
+                Intent(this, LinkService::class.java).setAction(ACTION_FORGET_ALL),
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            )
+            b.addAction(0, "Forget all computers", forget)
+        }
+        val pm = getSystemService(PowerManager::class.java)!!
+        if (!pm.isIgnoringBatteryOptimizations(packageName)) {
+            @SuppressLint("BatteryLife") // sideloaded build; the link must survive Doze
+            val ask = Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, Uri.parse("package:$packageName"))
+            val keep = PendingIntent.getActivity(this, 2, ask, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+            b.addAction(0, "Keep connected", keep)
+            lines.add("Tap \"Keep connected\" so the phone stays reachable while asleep")
+        }
+        if (lines.isNotEmpty()) {
+            b.setContentText(lines.first())
+            b.setStyle(NotificationCompat.BigTextStyle().bigText(lines.joinToString("\n")))
+        }
+        return b.build()
+    }
+
+    companion object {
+        private const val TAG = "OmalawnLink"
+        private const val CHANNEL = "omalawn_link"
+        private const val NOTIFICATION_ID = 47100
+        const val ACTION_FORGET_ALL = "app.lawnchair.omalawn.link.FORGET_ALL"
+        const val ACTION_OPEN_PAIRING = "app.lawnchair.omalawn.link.OPEN_PAIRING"
+        /** How long "Screen control in use" stays after the last screen.* call. */
+        const val SCREEN_SHOWN_MS = 30_000L
+        private const val LOAD_KICK_DELAY_MS = 5000L
+        /** elapsedRealtime of this process's LinkService.onCreate, 0 if none yet. */
+        @Volatile var createdAt = 0L
+        const val DEBUG_PREFS = "omalawn_debug"
+        const val KEY_CRASH_STARTS = "crash_link_start"
+        const val KEY_REFUSE_FOREGROUND = "refuse_foreground"
+
+        /** Starts (or pokes) the link service; false when Android refuses a start right now. */
+        fun start(ctx: Context): Boolean = try {
+            ctx.startForegroundService(Intent(ctx, LinkService::class.java))
+            true
+        } catch (e: Exception) { // ForegroundServiceStartNotAllowedException / IllegalStateException
+            Log.w(TAG, "link service not started now: ${e.javaClass.simpleName}: ${e.message}")
+            false
+        }
+    }
+}
