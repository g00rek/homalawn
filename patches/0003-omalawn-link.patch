diff --git a/lawnchair/src/app/lawnchair/omalawn/CrashExit.kt b/lawnchair/src/app/lawnchair/omalawn/CrashExit.kt
new file mode 100644
index 0000000000..1497f5d812
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/CrashExit.kt
@@ -0,0 +1,143 @@
+package app.lawnchair.omalawn
+
+import android.app.AlarmManager
+import android.app.Application
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.Process
+import android.os.SystemClock
+import android.util.Log
+import app.lawnchair.omalawn.link.BootReceiver
+import app.lawnchair.omalawn.link.LinkService
+import kotlin.system.exitProcess
+
+/**
+ * Makes sure a crashed launcher process really ends.
+ *
+ * Android's own handler (RuntimeInit.KillApplicationHandler) reports the crash to the system and
+ * only kills the process after `handleApplicationCrash` returns. When the system shows "Lawnchair
+ * keeps stopping" that call blocks until the dialog is answered (or its 5 minute timeout).
+ * Meanwhile the crashed main thread is stuck, but binder and link threads live on: the link
+ * answers `ping` while every layout call waits on the dead main thread and ends `busy`. So: let
+ * Android record the crash as usual, and if the process is still alive [GRACE_MS] later, end it
+ * ourselves; the system then restarts the link service (START_STICKY) in a fresh process.
+ *
+ * Order: installed from `LawnchairApp.attachBaseContext`, before any other handler, so it sits
+ * directly above Android's: Lawnchair's bug reporter (installed later, from the provider's process
+ * initializer) wraps it and writes its report before this handler starts the timer; Android's
+ * handler registers the crash right after. Trade-off of the grace: long enough on a slow phone for
+ * that registration (an ordinary crash is killed by Android well within it, so the timer never
+ * fires), but in the stuck-dialog case the link stays dead that much longer.
+ *
+ * Restart: a crash within 60 s of the service's previous (re)start makes Android wait 30 min or
+ * more (ActiveServices: BOUND_SERVICE_CRASH_RESTART_DURATION * (crashCount - 1)); any other crash
+ * Android restarts in about a second by itself. So a plain alarm ~10 s ahead that starts the link
+ * service again is set only in the two cases where Android will not: the crash came less than
+ * [RECENT_MS] after this process created the link service, or the timer had to end a stuck
+ * process. Bounds, so a crash loop is never fed: at most [RESTART_MAX] alarms per
+ * [RESTART_WINDOW_MS], each armed alarm counted (no sliding, no merging); and none at all within
+ * [SELF_MS] of a start by our own alarm (whatever process crashes then: the restart it caused
+ * failed, so Android's own back-off takes over). That background FGS start went
+ * through on the API 35 AVD without the battery exemption (reason not logged); with the exemption
+ * ("Keep connected") it is always allowed.
+ */
+object CrashExit {
+    private const val TAG = "OmalawnCrashExit"
+    const val GRACE_MS = 8000L
+
+    private const val RESTART_DELAY_MS = 10_000L
+    private const val RESTART_WINDOW_MS = 10 * 60 * 1000L
+    private const val RESTART_MAX = 3
+    private const val SELF_MS = 60_000L
+    private const val RECENT_MS = 60_000L
+
+    // its own file: read only here and by BootReceiver's restart path
+    private const val PREFS = "omalawn_crash_restart"
+    private const val KEY_ARMED = "armed_at"
+    private const val KEY_RESTART_AT = "restart_at"
+    const val EXTRA_FROM_CRASH = "app.lawnchair.omalawn.from_crash_exit"
+
+    @Volatile private var installed = false
+    @Volatile private var armedHere = false
+
+    fun install(app: Application) {
+        if (installed) return
+        installed = true
+        val previous = Thread.getDefaultUncaughtExceptionHandler()
+        Log.i(TAG, "installed over ${previous?.javaClass?.name}")
+        Thread.setDefaultUncaughtExceptionHandler { thread, error ->
+            val created = LinkService.createdAt
+            if (created > 0 && SystemClock.elapsedRealtime() - created < RECENT_MS) {
+                // Android will postpone the restart by 30 min or more
+                tryArm(app, "crash ${SystemClock.elapsedRealtime() - created}ms after the link service started")
+            }
+            val exit = Thread({
+                try {
+                    Thread.sleep(GRACE_MS)
+                } catch (_: InterruptedException) {
+                }
+                // still alive: Android's crash call is blocked (crash dialog); end it ourselves
+                Log.w(TAG, "process still alive ${GRACE_MS}ms after an uncaught exception in ${thread.name}; ending it")
+                if (!armedHere) tryArm(app, "stuck process ended")
+                Process.killProcess(Process.myPid())
+                exitProcess(10)
+            }, "omalawn-crash-exit")
+            exit.isDaemon = true
+            exit.start()
+            if (previous != null) {
+                previous.uncaughtException(thread, error)
+            } else {
+                Process.killProcess(Process.myPid())
+                exitProcess(10)
+            }
+        }
+    }
+
+    /** Called by BootReceiver when our alarm fired: no alarm is armed again within [SELF_MS]. */
+    fun onRestartAlarm(ctx: Context) {
+        ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+            .putLong(KEY_RESTART_AT, SystemClock.elapsedRealtime())
+            .commit()
+    }
+
+    private fun tryArm(ctx: Context, why: String) {
+        try {
+            armRestart(ctx, why)
+        } catch (t: Throwable) {
+            Log.w(TAG, "no restart alarm: $t")
+        }
+    }
+
+    /** Debug hook (provider, shell only): forget armed alarms and the restart marker. */
+    fun resetBudget(ctx: Context) {
+        ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().clear().commit()
+    }
+
+    private fun armRestart(ctx: Context, why: String) {
+        armedHere = true
+        val prefs = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val sinceAlarm = SystemClock.elapsedRealtime() - prefs.getLong(KEY_RESTART_AT, Long.MIN_VALUE / 2)
+        if (sinceAlarm in 0 until SELF_MS) {
+            Log.w(TAG, "no restart alarm ($why): our last restart alarm fired only ${sinceAlarm}ms ago")
+            return
+        }
+        val now = System.currentTimeMillis()
+        val armed = prefs.getString(KEY_ARMED, "").orEmpty().split(',')
+            .mapNotNull { it.toLongOrNull() }.filter { it in (now - RESTART_WINDOW_MS)..now }
+        if (armed.size >= RESTART_MAX) {
+            Log.w(TAG, "no restart alarm ($why): already $RESTART_MAX in the last ${RESTART_WINDOW_MS / 60000} min")
+            return
+        }
+        prefs.edit().putString(KEY_ARMED, (armed + now).joinToString(",")).commit() // the process is about to die
+        val pi = PendingIntent.getBroadcast(
+            ctx,
+            47100,
+            Intent(ctx, BootReceiver::class.java).setAction(BootReceiver.ACTION_RESTART).putExtra(EXTRA_FROM_CRASH, true),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+        ctx.getSystemService(AlarmManager::class.java)!!
+            .set(AlarmManager.ELAPSED_REALTIME_WAKEUP, SystemClock.elapsedRealtime() + RESTART_DELAY_MS, pi)
+        Log.i(TAG, "link restart alarm set for ${RESTART_DELAY_MS}ms from now (${armed.size + 1}/$RESTART_MAX; $why)")
+    }
+}
