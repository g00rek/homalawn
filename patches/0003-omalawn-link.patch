+            .setCertificateSerialNumber(BigInteger.valueOf(now))
+            .setCertificateNotBefore(Date(now - 24L * 3600 * 1000))
+            .setCertificateNotAfter(Date(now + YEARS * 365L * 24 * 3600 * 1000))
+            .build()
