diff --git a/lawnchair/AndroidManifest.xml b/lawnchair/AndroidManifest.xml
index 4b00c3eff8..8317c106cc 100644
--- a/lawnchair/AndroidManifest.xml
+++ b/lawnchair/AndroidManifest.xml
@@ -23,6 +23,13 @@
     <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
     <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
     <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
+    <!-- Homa Lawn link: FGS type connectedDevice needs this plus one network permission
+         (developer.android.com/develop/background-work/services/fgs/service-types#connected-device) -->
+    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
+    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
+    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
+    <!-- the pairing confirmation screen hides other apps' overlays while it shows (12+) -->
+    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
     <uses-permission android:name="com.google.android.apps.nexuslauncher.permission.QSB" />
     <uses-permission android:name="com.kieronquinn.app.smartspacer.permission.ACCESS_SMARTSPACER"/>
     <uses-permission android:name="android.permission.READ_CONTACTS" />
@@ -170,6 +177,31 @@
             android:authorities="${applicationId}.omalawn"
             android:exported="true" />
 
+        <service
+            android:name="app.lawnchair.omalawn.link.LinkService"
+            android:exported="false"
+            android:foregroundServiceType="connectedDevice" />
+
+        <!-- system broadcasts reach a non-exported receiver; nothing else can trigger it -->
+        <receiver
+            android:name="app.lawnchair.omalawn.link.BootReceiver"
+            android:exported="false">
+            <intent-filter>
+                <action android:name="android.intent.action.BOOT_COMPLETED" />
+                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
+            </intent-filter>
+        </receiver>
+
+        <!-- Homa Lawn: the pairing screen ("Pair a computer") and the only place a pairing can be accepted -->
+        <activity
+            android:name="app.lawnchair.omalawn.link.PairConfirmActivity"
+            android:exported="false"
+            android:launchMode="singleTop"
+            android:excludeFromRecents="true"
+            android:noHistory="true"
+            android:taskAffinity=""
+            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />
+
         <provider
             android:name="app.lawnchair.search.LawnchairRecentSuggestionProvider"
             android:authorities="${applicationId}.search.LawnchairRecentSuggestionProvider"
