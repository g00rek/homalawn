+    /**
+     * The model, loaded. A process started without the launcher activity (by the link service after
+     * a crash, by a provider call, after an update) never loads the home screen on its own: in this
+     * Launcher3 the loader only runs for registered callbacks (LauncherModel.startLoader). So when
+     * nothing is loaded or loading, [ensureLoaded] registers a headless no-op callback, which starts
+     * the same LoaderTask the launcher would; the callback goes away once loaded.
+     */
+    private fun loadedModel(ctx: Context): LauncherModel {
+        if (!ensureLoaded(ctx, LOAD_WAIT_S)) {
+            throw fail(BUSY, "the launcher has not finished loading its home screen within ${LOAD_WAIT_S}s")
+        }
+        return current()!!
+    }
+
+    private fun current(): LauncherModel? = LauncherAppState.getInstance(app.lawnchair.LawnchairApp.instance).model
+
+    /** Loaded within [waitS] seconds? Starts a headless load if needed. Off the main thread only. */
+    fun ensureLoaded(ctx: Context, waitS: Long): Boolean {
+        if (current()?.isModelLoaded() == true) return true
+        kickLoad(ctx)
+        val end = System.currentTimeMillis() + waitS * 1000
+        while (current()?.isModelLoaded() != true && System.currentTimeMillis() < end) Thread.sleep(100)
+        return current()?.isModelLoaded() == true
+    }
+
+    private const val LOAD_WAIT_S = 30L
+    private val headless = object : BgDataModel.Callbacks {}
+    @Volatile private var headlessOn = false
+
+    /**
+     * Start loading the home screen if no launcher is there to do it; returns at once. Everything,
+     * the app state included, is touched on the main thread, so a caller never blocks on it.
+     */
+    fun kickLoad(ctx: Context) {
+        val app = ctx.applicationContext
+        MAIN_EXECUTOR.execute {
+            val model = LauncherAppState.getInstance(app).model
+            if (model.isModelLoaded()) {
+                dropHeadless(model)
+            } else if (!model.hasCallbacks()) {
+                Log.i(TAG, "no launcher activity: loading the home screen headless")
+                headlessOn = true
+                model.addCallbacksAndLoad(headless)
+                // drop the no-op callback once the load has finished (checked on the model thread,
+                // after the queued LoaderTask), so it never receives later binds
+                MODEL_EXECUTOR.execute { MAIN_EXECUTOR.execute { dropHeadless(model) } }
+            }
+        }
+    }
+
+    private fun dropHeadless(model: LauncherModel) {
+        if (headlessOn && model.isModelLoaded()) {
+            headlessOn = false
+            model.removeCallbacks(headless)
+        }
