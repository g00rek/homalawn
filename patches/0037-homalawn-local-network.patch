diff --git a/lawnchair/src/app/lawnchair/omalawn/link/LocalNetwork.kt b/lawnchair/src/app/lawnchair/omalawn/link/LocalNetwork.kt
new file mode 100644
index 0000000000..4ca7e6769e
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/link/LocalNetwork.kt
@@ -0,0 +1,103 @@
+package app.lawnchair.omalawn.link
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import android.os.Bundle
+import android.os.SystemClock
+import android.provider.Settings
+import android.util.Log
+
+/**
+ * Local network (patch 0037). Android 17 (API 37) blocks every local-network packet of an app that
+ * targets 37 (Homa Lawn does) unless it holds the runtime permission ACCESS_LOCAL_NETWORK (group
+ * Nearby devices): the computer's TLS handshake on the link's port never completes and the mDNS
+ * advert is refused with a SecurityException. Without it no computer can reach the phone at all.
+ * Before Android 17 nothing is enforced and the permission is never asked for.
+ *
+ * Asked for once per install with the home screen's first prompt ([firstAsk]), then by
+ * [LocalNetworkActivity], opened from Settings › Permissions › Local network, the "Setup
+ * reminders" notification ([LinkAsks]) and "Pair a computer" ([PairConfirmActivity]);
+ * `homalawn setup` grants it over adb. Once it is granted while the process runs, the mDNS advert
+ * that was refused at the link's start is registered ([advertise]); a revoke kills the process,
+ * whose next start registers it again.
+ */
+object LocalNetwork {
+    private const val TAG = "OmalawnLink"
+    // Manifest.permission.ACCESS_LOCAL_NETWORK and Build.VERSION_CODES.CINNAMON_BUN (37): spelled out,
+    // since Launcher3's prebuilt framework-16.jar comes first on the compile classpath and lacks them
+    const val PERMISSION = "android.permission.ACCESS_LOCAL_NETWORK"
+    private const val ANDROID_17 = 37
+    const val REQUEST_CODE = 47104
+    private const val PREFS = "omalawn_link"
+    private const val KEY_ASKED = "local_network_asked"
+
+    /** Android enforces it: Android 17 and later. */
+    fun applies(): Boolean = Build.VERSION.SDK_INT >= ANDROID_17
+
+    /** The phone lets Homa Lawn use the local network (always before Android 17). */
+    fun allowed(ctx: Context): Boolean =
+        !applies() || ctx.checkSelfPermission(PERMISSION) == PackageManager.PERMISSION_GRANTED
+
+    fun missing(ctx: Context): Boolean = !allowed(ctx)
+
+    /**
+     * True once per install, when Local network is missing on Android 17+: the home screen's first
+     * prompt asks for it ([NotifyPermission.maybeAsk]); recorded before asking, so the resume after
+     * the prompt does not ask again. Later it is asked for by Pair a computer, the Setup reminders
+     * notification and Settings › Permissions.
+     */
+    fun firstAsk(ctx: Context): Boolean {
+        if (allowed(ctx)) return false
+        val p = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        if (p.getBoolean(KEY_ASKED, false)) return false
+        p.edit().putBoolean(KEY_ASKED, true).commit()
+        return true
+    }
+
+    /** Opens the system prompt (or App info, where Android no longer shows it). */
+    fun askIntent(ctx: Context): Intent = Intent(ctx, LocalNetworkActivity::class.java)
+
+    /** The link's mDNS advert, now that it may go out; nothing when already registered or not allowed. */
+    fun advertise(ctx: Context) {
+        if (allowed(ctx)) Nsd.retry(ctx.applicationContext)
+    }
+
+    internal fun log(msg: String) = Log.i(TAG, msg)
+}
+
+/**
+ * Invisible, not exported: shows Android's Local network prompt. When Android answers at once
+ * without showing it (denied for good), opens App info, where the person allows it under
+ * Permissions › Nearby devices. Granted: the link's mDNS advert goes out.
+ */
+class LocalNetworkActivity : Activity() {
+    private var askedAt = 0L
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (LocalNetwork.allowed(this)) {
+            LocalNetwork.advertise(this)
+            finish()
+            return
+        }
+        askedAt = SystemClock.elapsedRealtime()
+        requestPermissions(arrayOf(LocalNetwork.PERMISSION), LocalNetwork.REQUEST_CODE)
+    }
+
+    override fun onRequestPermissionsResult(requestCode: Int, permissions: Array<out String>, grantResults: IntArray) {
+        super.onRequestPermissionsResult(requestCode, permissions, grantResults)
+        if (LocalNetwork.allowed(this)) {
+            LocalNetwork.log("local network allowed")
+            LocalNetwork.advertise(this)
+            LinkAsks.refresh(this)
+        } else if (SystemClock.elapsedRealtime() - askedAt < 400) {
+            // answered at once: Android did not show the prompt, so only App info can grant it now
+            startActivity(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.fromParts("package", packageName, null)))
+        }
+        finish()
+    }
+}
diff --git a/lawnchair/src/app/lawnchair/omalawn/link/NotifyPermission.kt b/lawnchair/src/app/lawnchair/omalawn/link/NotifyPermission.kt
index ecb234c348..e6bef0adec 100644
--- a/lawnchair/src/app/lawnchair/omalawn/link/NotifyPermission.kt
+++ b/lawnchair/src/app/lawnchair/omalawn/link/NotifyPermission.kt
@@ -12,6 +12,10 @@ import android.os.Build
  * longer again after every update), and again when a notification the person needs (a pair
  * request, a photo-access request, an app update) came while it was missing. Settings ›
  * Permissions › Notifications shows the state and opens Android's page at any time.
+ *
+ * The same request carries Local network the first time it is due ([LocalNetwork.firstAsk],
+ * Android 17+, patch 0037): Android shows one request at a time, and without it no computer can
+ * reach the phone, not even to pair.
  */
 object NotifyPermission {
     private const val PREFS = "omalawn_link"
@@ -30,12 +34,21 @@ object NotifyPermission {
 
     /** Called from the launcher when it comes to the front. */
     fun maybeAsk(activity: Activity) {
-        if (!missing(activity)) return
-        val p = prefs(activity)
-        if (p.contains(KEY_ASKED) && !p.getBoolean(KEY_NEEDED, false)) return
-        // recorded before asking: the dialog pauses and resumes the launcher, which must not ask again
-        p.edit().putString(KEY_ASKED, version(activity)).putBoolean(KEY_NEEDED, false).commit()
-        activity.requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), REQUEST_CODE)
+        val perms = buildList {
+            if (due(activity)) {
+                // recorded before asking: the dialog pauses and resumes the launcher, which must not ask again
+                prefs(activity).edit().putString(KEY_ASKED, version(activity)).putBoolean(KEY_NEEDED, false).commit()
+                add(Manifest.permission.POST_NOTIFICATIONS)
+            }
+            if (LocalNetwork.firstAsk(activity)) add(LocalNetwork.PERMISSION)
+        }
+        if (perms.isNotEmpty()) activity.requestPermissions(perms.toTypedArray(), REQUEST_CODE)
+    }
+
+    private fun due(ctx: Context): Boolean {
+        if (!missing(ctx)) return false
+        val p = prefs(ctx)
+        return !p.contains(KEY_ASKED) || p.getBoolean(KEY_NEEDED, false)
     }
 
     private fun prefs(ctx: Context) = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
