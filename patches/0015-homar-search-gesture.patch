diff --git a/lawnchair/src/app/lawnchair/omalawn/HomarSearchGesture.kt b/lawnchair/src/app/lawnchair/omalawn/HomarSearchGesture.kt
new file mode 100644
index 0000000000..092ef22640
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/HomarSearchGesture.kt
@@ -0,0 +1,89 @@
+package app.lawnchair.omalawn
+
+import app.lawnchair.LawnchairLauncher
+import com.android.launcher3.LauncherState
+import com.android.launcher3.allapps.ActivityAllAppsContainerView
+import com.android.launcher3.statemanager.StateManager
+
+/**
+ * "Search (instant)" gesture (serial name `homarSearch`): the app search screen and keyboard at
+ * once, Nova-style, instead of upstream's "Open app search", which slides up the A-Z drawer first
+ * and focuses the search field only after it.
+ *
+ * The drawer is switched into its search mode while it is still off-screen (an empty result list
+ * makes it show the search results page; upstream's search transition is instant), then shown
+ * without the slide, and the search field is focused, which raises the keyboard. While the query
+ * is empty the page stays empty (or shows recent searches, if Lawnchair keeps them) instead of
+ * upstream's A-Z list, see [keepSearchPage]. Back from a search opened this way goes home, also
+ * with a query typed (upstream clears the query and drops to the A-Z list). With the keyboard up,
+ * Android's keyboard takes the first Back and only hides itself, as everywhere.
+ */
+object HomarSearchGesture {
+    // the launcher whose drawer we opened in search mode, until it leaves ALL_APPS
+    private var session: LawnchairLauncher? = null
+
+    fun open(launcher: LawnchairLauncher) {
+        val appsView = launcher.appsView
+        val input = appsView.searchUiManager.editText
+        if (input == null) {
+            // the drawer's search bar is hidden or not ours: behave like "Open app drawer"
+            launcher.stateManager.goToState(LauncherState.ALL_APPS)
+            return
+        }
+        if (!appsView.isSearching) appsView.setSearchResults(ArrayList())
+        session = launcher
+        launcher.stateManager.goToState(LauncherState.ALL_APPS, false)
+        watchSession(launcher)
+        // Upstream's controller sets the listener once; ours repeats its rule (a query is
+        // cleared) for searches not opened by this gesture, so it can stay installed.
+        input.setOnBackKeyListener {
+            if (session === launcher) {
+                launcher.stateManager.goToState(LauncherState.NORMAL)
+                true
+            } else if (input.text.isNullOrBlank()) {
+                false
+            } else {
+                appsView.searchUiManager.resetSearch()
+                true
+            }
+        }
+        input.showKeyboard()
+    }
+
+    /**
+     * Hook in LawnchairLauncher.onStateBack: Back once the search field has lost focus (the
+     * keyboard is down) reaches the launcher, not the field. Upstream would reset the search,
+     * which in our session keeps the empty search page, so every further Back would do the same.
+     * In our session Back goes home. Returns true when it did.
+     */
+    fun onStateBack(launcher: LawnchairLauncher): Boolean {
+        if (session !== launcher || !launcher.isInState(LauncherState.ALL_APPS)) return false
+        launcher.stateManager.goToState(LauncherState.NORMAL)
+        return true
+    }
+
+    /**
+     * Hook in AllAppsSearchInput.clearSearchResult: upstream answers an empty query (the zero
+     * state, or a query deleted back to nothing) with the A-Z list. In our session the drawer
+     * shows its empty search page instead. Returns true when it did, so the A-Z list is skipped.
+     */
+    fun keepSearchPage(appsView: ActivityAllAppsContainerView<*>): Boolean {
+        val launcher = session ?: return false
+        if (launcher.appsView !== appsView || !launcher.isInState(LauncherState.ALL_APPS)) return false
+        appsView.setSearchResults(ArrayList())
+        return true
+    }
+
+    private val watched = mutableSetOf<Int>()
+
+    private fun watchSession(launcher: LawnchairLauncher) {
+        if (!watched.add(System.identityHashCode(launcher))) return
+        launcher.stateManager.addStateListener(
+            object : StateManager.StateListener<LauncherState> {
+                override fun onStateTransitionComplete(finalState: LauncherState) {
+                    if (finalState != LauncherState.ALL_APPS && session === launcher) session = null
+                }
+            },
+        )
+    }
+}
