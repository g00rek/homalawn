+    /** The profile the home screen uses upright, whatever way the phone is held right now. */
+    private fun portrait(ctx: Context): DeviceProfile {
+        val idp = InvariantDeviceProfile.INSTANCE.get(ctx)
+        val now = idp.getDeviceProfile(ctx)
+        val p = now.deviceProperties
+        if (!p.isLandscape) return now
+        return idp.getBestMatch(
+            min(p.widthPx, p.heightPx).toFloat(), max(p.widthPx, p.heightPx).toFloat(), Surface.ROTATION_0,
+        )
     }
 
-    /** A cell layout's grid of cells, on the screen. */
-    private fun cells(c: CellLayout): JSONObject {
-        val content = c.shortcutsAndWidgets
-        val p = IntArray(2)
-        content.getLocationOnScreen(p)
-        // the space between cells, from what the layout itself measured
-        val gx = if (c.countX > 1) (content.width - c.countX * c.cellWidth) / (c.countX - 1) else 0
-        val gy = if (c.countY > 1) (content.height - c.countY * c.cellHeight) / (c.countY - 1) else 0
-        return JSONObject().put("x", p[0]).put("y", p[1]).put("w", content.width).put("h", content.height)
-            .put("cell_w", c.cellWidth).put("cell_h", c.cellHeight)
-            .put("gap_x", maxOf(0, gx)).put("gap_y", maxOf(0, gy))
+    private fun measure(ctx: Context, dp: DeviceProfile): JSONObject {
+        val w = dp.deviceProperties.widthPx
+        val h = dp.deviceProperties.heightPx
+        val ins = dp.insets
+        val cols = dp.inv.numColumns
+        val rows = dp.inv.numRows
+
+        // Workspace: full screen, padded by workspacePadding; PagedView lays its pages out inside
+        // the insets (getPageWidthSize, onMeasure); each CellLayout pads by cellLayoutPaddingPx.
+        val wp = dp.workspacePadding
+        val clp = dp.cellLayoutPaddingPx
+        val pageW = (w - ins.left - ins.right - wp.left - wp.right) / dp.panelCount
+        val pageH = h - ins.top - ins.bottom - wp.top - wp.bottom
+        val gridW = pageW - clp.left - clp.right
+        val gridH = pageH - clp.top - clp.bottom
+        val bx = dp.cellLayoutBorderSpacePx.x
+        val by = dp.cellLayoutBorderSpacePx.y
+        val cellW = DeviceProfile.calculateCellWidth(gridW, bx, cols)
+        val cellH = DeviceProfile.calculateCellHeight(gridH, by, rows)
+        val workspace = JSONObject()
+            .put("x", ins.left + wp.left + clp.left).put("y", ins.top + wp.top + clp.top)
+            .put("w", gridW).put("h", gridH).put("cell_w", cellW).put("cell_h", cellH)
+            .put("gap_x", bx).put("gap_y", by)
+        // ShortcutAndWidgetContainer.measureChild: an icon's top padding in its workspace cell
+        val iconTop = if (dp.cellYPaddingPx >= 0) dp.cellYPaddingPx
+        else max(0f, (cellH - min(gridH, dp.getCellContentHeight(CellLayout.WORKSPACE))) / 2f).toInt()
+
+        // Hotseat: hotseatBarSizePx at the screen's bottom, padded by getHotseatLayoutPadding; its
+        // pages (Lawnchair: numHotseatPages, each numShownHotseatIcons x numHotseatRows) fill it,
+        // less the dots below them when there is more than one page.
+        val hp = dp.getHotseatLayoutPadding(ctx)
+        val barY = h - dp.hotseatBarSizePx
+        val dots = if (dp.numHotseatPages > 1) (DOCK_PAGE_INDICATOR_HEIGHT_DP * ctx.resources.displayMetrics.density).roundToInt() else 0
+        val dockW = w - hp.left - hp.right
+        val dockH = max(0, dp.hotseatBarSizePx - hp.top - hp.bottom - dots)
+        val n = max(1, dp.numShownHotseatIcons)
+        val dockCellW = DeviceProfile.calculateCellWidth(dockW, dp.hotseatBorderSpace, n)
+        val dockCellH = DeviceProfile.calculateCellHeight(dockH, dp.hotseatBorderSpace, max(1, dp.numHotseatRows))
+        val dockIconTop = max(0f, (dockCellH - min(dockH, dp.getCellContentHeight(CellLayout.HOTSEAT))) / 2f).toInt()
+
+        return JSONObject()
+            .put("screen", JSONObject().put("w", w).put("h", h).put("density", ctx.resources.displayMetrics.density))
+            .put("insets", rect(ins))
+            .put("grid", JSONObject().put("cols", cols).put("rows", rows))
+            .put("workspace", workspace)
+            .put(
+                "icon",
+                JSONObject().put("size", dp.iconSizePx).put("text_size", dp.iconTextSizePx)
+                    .put("drawable_padding", dp.iconDrawablePaddingPx).put("top", iconTop)
+                    .put("labels", dp.iconTextSizePx > 0),
+            )
+            .put(
+                "hotseat",
+                JSONObject().put("x", hp.left).put("y", barY + hp.top).put("w", dockW).put("h", dockH)
+                    .put("cell_w", dockCellW).put("cell_h", dockCellH).put("gap_x", dp.hotseatBorderSpace)
+                    .put("count", dp.numShownHotseatIcons)
+                    .put("icon_size", dp.iconSizePx).put("icon_top", dockIconTop),
+            )
+            .put("folder_icon_size", dp.folderIconSizePx)
+            .put("widget_padding", rect(dp.widgetPadding))
     }
 
+    /**
+     * Debug builds only (the provider's `debug_home_views`): the same numbers read back from the
+     * Launcher's laid-out views (positions on the screen), for the device test that proves [read]
+     * equals them. Null while there is no launcher activity or its views are not laid out.
+     */
+    fun views(): JSONObject? = onMain {
+        val launcher = Launcher.ACTIVITY_TRACKER.getCreatedContext<Launcher>() ?: return@onMain null
+        val ws = launcher.workspace ?: return@onMain null
+        val page = (ws.getPageAt(ws.currentPage) ?: ws.getPageAt(0)) as? CellLayout ?: return@onMain null
+        val dock = launcher.hotseat?.let { it.currentPageLayout ?: it.getPageAt(0) } ?: return@onMain null
+        if (page.shortcutsAndWidgets.width <= 0 || dock.shortcutsAndWidgets.width <= 0) return@onMain null
+        fun firstIcon(c: CellLayout) = (0 until c.shortcutsAndWidgets.childCount)
+            .map { c.shortcutsAndWidgets.getChildAt(it) }.firstOrNull { it is BubbleTextView } as BubbleTextView?
+        fun iconOf(v: BubbleTextView?): JSONObject? = v?.let {
+            val b = Rect()
+            it.getIconBounds(b)
+            JSONObject().put("size", it.iconSize).put("top", b.top).put("cell", box(it))
+        }
+        JSONObject()
+            .put("workspace", cells(page)).put("icon", iconOf(firstIcon(page)))
+            .put("hotseat", cells(dock)).put("dock_icon", iconOf(firstIcon(dock)))
+            .put("insets", rect(launcher.deviceProfile.insets))
+    }
+
+    private fun cells(c: CellLayout): JSONObject = box(c.shortcutsAndWidgets)
+        .put("cell_w", c.cellWidth).put("cell_h", c.cellHeight).put("cols", c.countX).put("rows", c.countY)
+
     private fun box(v: View): JSONObject {
         val p = IntArray(2)
         v.getLocationOnScreen(p)
         return JSONObject().put("x", p[0]).put("y", p[1]).put("w", v.width).put("h", v.height)
     }
 
