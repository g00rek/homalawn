+import androidx.navigation.compose.composable
+import app.lawnchair.ui.preferences.components.layout.PreferenceGroup
+import app.lawnchair.ui.preferences.components.layout.PreferenceLayout
+import app.lawnchair.ui.preferences.components.layout.PreferenceTemplate
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+
+/** The settings route of the "Computers" screen (patch 0030). */
+@Serializable
+data object HomarComputers
+
+/** Registers the screen in Lawnchair's settings graph (one line in PreferenceNavigation). */
+fun NavGraphBuilder.homarComputers() {
+    composable<HomarComputers> { ComputersScreen() }
+}
+
+/**
+ * Every paired computer with its state, "Pair a computer", and Forget (one, or all) behind a
+ * confirmation. Forgetting closes that computer's connections through [Pins]' removal listener, so
+ * nothing more is done here. The list follows [Pins] and [LinkServer] as they change.
+ */
+@Composable
+fun ComputersScreen() {
+    val ctx = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var tick by remember { mutableIntStateOf(0) }
+    DisposableEffect(Unit) {
+        val l: () -> Unit = { tick++ }
+        Pins.onChange(l)
+        LinkServer.onChange(l)
+        onDispose {
+            Pins.removeListener(l)
+            LinkServer.removeListener(l)
+        }
+    }
+    val computers = remember(tick) { Pins.list(ctx) }
+    val online = remember(tick) { LinkServer.connectedFps() }
+    // only the fingerprint is held: the computer shown is always the live one, and a dialog for a
+    // computer forgotten elsewhere closes
+    var open by remember { mutableStateOf<String?>(null) }
+    var forgetting by remember { mutableStateOf<String?>(null) }
+    var forgettingAll by remember { mutableStateOf(false) }
+    // forgetting closes sockets and deletes files: off the main thread
+    fun inBackground(work: () -> Unit) {
+        scope.launch {
+            withContext(Dispatchers.IO) { work() }
+            tick++
+        }
+    }
+
+    PreferenceLayout(label = "Computers", backArrowVisible = true) {
+        PreferenceGroup(heading = "Paired computers") {
+            if (computers.isEmpty()) Text("No computer is paired.", Modifier.padding(16.dp))
+            computers.forEach { c ->
+                PreferenceTemplate(
+                    title = { Text(c.name.ifEmpty { "Computer" }) },
+                    description = { Text(statusLine(c, c.fp in online) + " · Paired " + date(c.added)) },
+                    startWidget = { if (c.fp in online) OnlineDot() },
+                    modifier = Modifier.clickable { open = c.fp },
+                )
+            }
+        }
+        PreferenceGroup {
+            PreferenceTemplate(
+                title = { Text("Pair a computer") },
+                modifier = Modifier.clickable {
+                    ctx.startActivity(
+                        Intent(ctx, PairConfirmActivity::class.java)
+                            .setAction(PairConfirmActivity.ACTION_WAIT)
+                            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP),
+                    )
+                },
+            )
+            if (computers.isNotEmpty()) {
+                PreferenceTemplate(
+                    title = { Text("Forget all computers", color = MaterialTheme.colorScheme.error) },
+                    modifier = Modifier.clickable { forgettingAll = true },
+                )
+            }
+        }
+    }
+
+    open?.let { fp -> computers.firstOrNull { it.fp == fp } }?.let { c ->
+        AlertDialog(
+            onDismissRequest = { open = null },
+            title = { Text(c.name.ifEmpty { "Computer" }) },
+            text = {
+                Text(
+                    statusLine(c, c.fp in online) + "\nPaired " + date(c.added) + "\nFingerprint " + c.fp.take(16),
+                )
+            },
+            confirmButton = {
+                TextButton({ open = null; forgetting = c.fp }) {
+                    Text("Forget", color = MaterialTheme.colorScheme.error)
+                }
+            },
+            dismissButton = { TextButton({ open = null }) { Text("Close") } },
+        )
+    }
+    forgetting?.let { fp -> computers.firstOrNull { it.fp == fp } }?.let { c ->
+        val name = c.name.ifEmpty { "Computer" }
+        AlertDialog(
+            onDismissRequest = { forgetting = null },
+            title = { Text("Forget $name?") },
+            text = { Text("$name can no longer use this phone. It will be told the next time it connects.") },
+            confirmButton = {
+                TextButton({
+                    forgetting = null
+                    inBackground { Pins.forget(ctx.applicationContext, c.fp) }
+                }) { Text("Forget") }
+            },
+            dismissButton = { TextButton({ forgetting = null }) { Text("Cancel") } },
+        )
+    }
+    if (forgettingAll) {
+        AlertDialog(
+            onDismissRequest = { forgettingAll = false },
+            title = { Text("Forget all computers?") },
+            text = {
+                val n = computers.size
+                Text(
+                    "${if (n == 1) "The paired computer" else "All $n paired computers"} will no longer reach " +
+                        "this phone until paired again.",
+                )
+            },
+            confirmButton = {
+                TextButton({
+                    forgettingAll = false
+                    inBackground { Pins.forgetAll(ctx.applicationContext) }
+                }) { Text("Forget") }
+            },
+            dismissButton = { TextButton({ forgettingAll = false }) { Text("Cancel") } },
+        )
+    }
+}
+
+@Composable
+private fun OnlineDot() {
+    Box(Modifier.size(10.dp).background(Color(0xFF34A853), CircleShape))
+}
+
+private fun statusLine(c: Computer, online: Boolean): String = when {
+    online -> "Online now"
+    c.seen == 0L -> "Not seen yet"
+    else -> "Last seen " + ago(c.seen)
+}
+
+// English whatever the phone's language is (getRelativeTimeSpanString follows the language)
+private fun ago(ms: Long): String {
+    val m = (System.currentTimeMillis() - ms) / 60_000
+    return when {
+        m < 1 -> "just now"
+        m < 60 -> "$m min ago"
+        m < 1440 -> "${m / 60} h ago"
+        else -> "${m / 1440} days ago"
+    }
+}
+
+private fun date(ms: Long): String = if (ms == 0L) {
+    "?"
+} else {
+    java.text.DateFormat.getDateInstance(java.text.DateFormat.MEDIUM, java.util.Locale.ENGLISH).format(java.util.Date(ms))
+}
