+// Adapted from Flux (https://github.com/bjarneo/flux), MIT License, Copyright (c) 2026 Bjarne Oeverli
+// (android/.../ui/ComputersScreen.kt and ui/ScreenKit.kt): a list of the paired computers with each one's
+// state and an unpair per computer; "last seen" in the words of Flux's agoText. Differences: Lawnchair's
+// preference rows instead of Flux's cards, Forget in a details dialog and a confirmation instead of a long press.
+package app.lawnchair.omalawn.link
+
+import android.content.Intent
+import androidx.compose.foundation.background
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.size
