+package app.lawnchair.omalawn
+
+import android.content.Context
+import android.content.res.Resources
+import android.util.DisplayMetrics
+import androidx.datastore.preferences.core.floatPreferencesKey
+import app.lawnchair.preferences2.PreferenceManager2
+import app.lawnchair.preferences2.ReloadHelper
+import com.android.launcher3.testing.shared.ResourceUtils
+import com.patrykmichalik.opto.core.PreferenceImpl
+import com.patrykmichalik.opto.core.firstBlocking
+
+/**
+ * Space between a home-screen icon and its label, in dp, on top of upstream's gap.
+ *
+ * Upstream subtracts the icon's invisible margin from the label padding, so larger icons
+ * (home_icon_size_factor > 1) push the label against the icon. 0 keeps upstream's layout; a
+ * negative gap (down to [MIN_DP]) pulls the label that much closer, for small icons or tall labels.
+ * DeviceProfile adds [extraPx] to the workspace padding before it fits the cell, so a short cell
+ * gives the space back from border spacing / cell padding rather than cutting the label; on the
+ * fixed grid [fixedCellPadding] keeps the label off the icon when the cell is short.
+ * Set from the desktop with `homalawn prefs set homar_label_gap_dp 6`.
+ */
+object HomarLabelGap {
+    private const val MIN_DP = -8f
+    private const val MAX_DP = 32f
+
+    // a literal, so scripts/gen-prefs-catalog.py lists it for `homalawn prefs set`
+    private val key = floatPreferencesKey(name = "homar_label_gap_dp")
+
+    /** The setting, as Lawnchair's own preferences are declared: a change reloads the grid. */
+    fun preference(context: Context): PreferenceImpl<Float, Float> {
+        val app = context.applicationContext
+        return PreferenceManager2.getInstance(app).preference(
+            key = key,
+            defaultValue = 0f,
+            onSet = { ReloadHelper(app).reloadGrid() },
+        )
+    }
+
+    private fun gapDp(prefs2: PreferenceManager2): Float =
+        prefs2.preference(key = key, defaultValue = 0f).firstBlocking().coerceIn(MIN_DP, MAX_DP)
+
+    /** Extra label padding in px for DeviceProfile (0 when unset, negative for a negative gap). */
+    @JvmStatic
+    fun extraPx(prefs2: PreferenceManager2, metrics: DisplayMetrics): Int =
+        px(gapDp(prefs2), metrics)
+
+    /** pxFromDp answers -1 (an invalid resource) for any negative size; negate around it. */
+    private fun px(dp: Float, metrics: DisplayMetrics): Int =
+        if (dp < 0f) -ResourceUtils.pxFromDp(-dp, metrics) else ResourceUtils.pxFromDp(dp, metrics)
+
+    /**
+     * Label padding for upstream's fixed (non-scalable) grid. Upstream clamps the padding to half
+     * the cell's free height, which goes negative when the cell is shorter than icon + label
+     * (4x8 with larger icons), pulling the label up into the icon by far more than the cell
+     * needs. With a gap set: the [wanted] padding (gap included), shrunk to the [roomPx] the cell
+     * really has below the icon and label (negative when even padding 0 would cut the label's
+     * descenders), never below upstream's own value. Gap 0 keeps upstream's value; a negative gap
+     * takes its dp off upstream's value.
+     */
+    @JvmStatic
+    fun fixedCellPadding(prefs2: PreferenceManager2, upstream: Int, wanted: Int, roomPx: Int): Int {
+        val gap = gapDp(prefs2)
+        return when {
+            gap == 0f -> upstream
+            gap < 0f -> upstream + px(gap, Resources.getSystem().displayMetrics)
+            else -> maxOf(upstream, minOf(wanted, roomPx))
+        }
+    }
+}
