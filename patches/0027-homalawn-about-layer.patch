From e96c26567f04e17d6a3d6ed498073f7b9bc35711 Mon Sep 17 00:00:00 2001
From: homar <homar@local>
Date: Sun, 18 Oct 2026 10:07:21 +0200
Subject: [PATCH] homalawn about layer: About says what Homa Lawn is for and
 what it adds on top of Lawnchair

Homa Lawn's About, under the name and version:

- "What Homa Lawn is": the phone as part of the Omarchy desktop
  (following its theme, arranged from the computer, operable by AI
  assistants once allowed, a direct connection with no Homa Lawn server
  in between), with rows to omarchy.org and Omarchy on GitHub
  (omacom/omarchy, where basecamp/omarchy redirects).
- "Built on Lawnchair": Homa Lawn is Lawnchair with a layer on top, what
  Lawnchair's team made, what Homa Lawn adds, and that Homa Lawn
  problems go to us, not to the Lawnchair team; rows to lawnchair.app,
  Lawnchair on GitHub and the open-source licences.
---
 lawnchair/res/values/homar_strings.xml        | 12 +++-
 .../app/lawnchair/omalawn/HomaLawnAbout.kt    | 64 +++++++++++++++----
 2 files changed, 64 insertions(+), 12 deletions(-)

diff --git a/lawnchair/res/values/homar_strings.xml b/lawnchair/res/values/homar_strings.xml
index 9b821a2b21..99708b14d2 100644
--- a/lawnchair/res/values/homar_strings.xml
+++ b/lawnchair/res/values/homar_strings.xml
@@ -41,6 +41,16 @@
     <!-- settings › About (patch 0026) -->
     <string name="homalawn_about_built_on">Built on Lawnchair</string>
     <string name="homalawn_about_lawnchair">Lawnchair</string>
-    <string name="homalawn_about_lawnchair_description">The open-source launcher Homa Lawn is built on</string>
+    <string name="homalawn_about_lawnchair_description">lawnchair.app</string>
+    <!-- settings › About (patch 0027): what Homa Lawn is for, and what it is on top of Lawnchair -->
+    <string name="homalawn_about_what">What Homa Lawn is</string>
+    <string name="homalawn_about_what_text">Homa Lawn makes your Android phone part of your Omarchy desktop. Omarchy is a Linux setup built on Arch and Hyprland, where one theme sets the look of everything.\n\nWith Homa Lawn the phone follows that theme: when you switch themes on the computer, the phone\'s wallpapers, colours and icon tint follow. From the computer you can also arrange this home screen, move apps and widgets, and let AI assistants on the computer read and operate the phone, after you allow it here.\n\nThe phone and the computer talk to each other directly, over your own network (or your Tailscale network); there is no Homa Lawn server in between.</string>
+    <string name="homalawn_about_omarchy">Omarchy</string>
+    <string name="homalawn_about_omarchy_description">omarchy.org</string>
+    <string name="homalawn_about_omarchy_github">Omarchy on GitHub</string>
+    <string name="homalawn_about_omarchy_github_description">omacom/omarchy</string>
+    <string name="homalawn_about_layer">Homa Lawn is Lawnchair with a layer on top. Lawnchair is a free, open-source Android launcher made by the Lawnchair team and its contributors: the home screen, the app drawer, the icons and most of the settings here are their work.\n\nHoma Lawn adds what ties this phone to your computer: pairing, wallpapers and colours from your Omarchy theme, and letting the Homa Lawn app on the computer arrange this home screen.\n\nHoma Lawn is not made by the Lawnchair team. Report Homa Lawn problems to us, not to them.</string>
+    <string name="homalawn_about_github">Lawnchair on GitHub</string>
+    <string name="homalawn_about_github_description">Source code and the people who made it</string>
     <string name="homalawn_about_licences">Open-source licences</string>
 </resources>
diff --git a/lawnchair/src/app/lawnchair/omalawn/HomaLawnAbout.kt b/lawnchair/src/app/lawnchair/omalawn/HomaLawnAbout.kt
index 19d1a31b78..050f77cede 100644
--- a/lawnchair/src/app/lawnchair/omalawn/HomaLawnAbout.kt
+++ b/lawnchair/src/app/lawnchair/omalawn/HomaLawnAbout.kt
@@ -34,8 +34,10 @@ import com.android.launcher3.R
 
 /**
