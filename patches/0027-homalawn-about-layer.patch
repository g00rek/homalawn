- * the launcher and Android's Settings show), its name and version, then one "Built on Lawnchair"
- * group with a row to lawnchair.app and the open-source licences. Lawnchair's links, team list,
+ * the launcher and Android's Settings show), its name and version, then (patch 0027) "What Homa
+ * Lawn is" (what it is for, with Omarchy's site and repository) and "Built on Lawnchair" (what
+ * Homa Lawn adds on top of Lawnchair and who made what, with lawnchair.app and Lawnchair's
+ * GitHub), and the open-source licences. Lawnchair's links, team list,
  * nightly updater and privacy policy are Lawnchair's, not ours, so they are not shown here.
  */
 @Composable
@@ -80,17 +82,31 @@ fun HomaLawnAbout(modifier: Modifier = Modifier) {
             )
         }
         item { Spacer(modifier = Modifier.height(16.dp)) }
-        item { PreferenceGroupHeading(stringResource(R.string.homalawn_about_built_on)) }
+        item { PreferenceGroupHeading(stringResource(R.string.homalawn_about_what)) }
+        item { Paragraph(R.string.homalawn_about_what_text) }
         item {
             PreferenceGroupItem(cutTop = false, cutBottom = true) {
-                ClickablePreference(
-                    label = stringResource(R.string.homalawn_about_lawnchair),
-                    subtitle = stringResource(R.string.homalawn_about_lawnchair_description),
-                    onClick = {
-                        val intent = Intent(Intent.ACTION_VIEW, LAWNCHAIR_SITE.toUri())
-                        if (intent.resolveActivity(context.packageManager) != null) context.startActivity(intent)
-                    },
-                )
+                LinkRow(R.string.homalawn_about_omarchy, R.string.homalawn_about_omarchy_description, OMARCHY_SITE)
+            }
+        }
+        item { Spacer(Modifier.height(3.dp)) }
+        item {
+            PreferenceGroupItem(cutTop = true, cutBottom = false) {
+                LinkRow(R.string.homalawn_about_omarchy_github, R.string.homalawn_about_omarchy_github_description, OMARCHY_GITHUB)
+            }
+        }
+        item { Spacer(Modifier.height(8.dp)) }
+        item { PreferenceGroupHeading(stringResource(R.string.homalawn_about_built_on)) }
+        item { Paragraph(R.string.homalawn_about_layer) }
+        item {
+            PreferenceGroupItem(cutTop = false, cutBottom = true) {
+                LinkRow(R.string.homalawn_about_lawnchair, R.string.homalawn_about_lawnchair_description, LAWNCHAIR_SITE)
+            }
+        }
+        item { Spacer(Modifier.height(3.dp)) }
+        item {
+            PreferenceGroupItem(cutTop = true, cutBottom = true) {
+                LinkRow(R.string.homalawn_about_github, R.string.homalawn_about_github_description, LAWNCHAIR_GITHUB)
             }
         }
         item { Spacer(Modifier.height(3.dp)) }
@@ -105,4 +121,30 @@ fun HomaLawnAbout(modifier: Modifier = Modifier) {
     }
 }
 
+@Composable
+private fun Paragraph(text: Int) {
+    Text(
+        text = stringResource(text),
+        style = MaterialTheme.typography.bodyLarge,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+        modifier = Modifier.fillMaxWidth().padding(start = 16.dp, end = 16.dp, bottom = 16.dp),
+    )
+}
+
+@Composable
+private fun LinkRow(label: Int, subtitle: Int, url: String) {
+    val context = LocalContext.current
+    ClickablePreference(
+        label = stringResource(label),
+        subtitle = stringResource(subtitle),
+        onClick = {
+            val intent = Intent(Intent.ACTION_VIEW, url.toUri())
+            if (intent.resolveActivity(context.packageManager) != null) context.startActivity(intent)
+        },
+    )
+}
+
+private const val OMARCHY_SITE = "https://omarchy.org/"
+private const val OMARCHY_GITHUB = "https://github.com/omacom/omarchy" // basecamp/omarchy redirects here
 private const val LAWNCHAIR_SITE = "https://lawnchair.app/"
+private const val LAWNCHAIR_GITHUB = "https://github.com/LawnchairLauncher/lawnchair"
