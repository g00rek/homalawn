+/**
+ * The look book as the screens need it, read once per change: the scope, the last change, the
+ * source, what is on the screen and each paired computer's entry.
+ */
+class StyleView(
+    val scope: String?,
+    val last: String?,
+    val source: String?,
+    val applied: LookBook.Applied?,
+    val entries: Map<String, LookBook.Entry>,
+) {
+    /** Whose wallpaper & style the phone shows once [gone] is forgotten: the last change, else the newest of the others. */
+    fun nextSource(gone: String): String? =
+        last?.takeIf { it != gone && it in entries } ?: entries.values.filter { it.fp != gone }.maxByOrNull { it.changedAt }?.fp
+}
+
+object StyleSource {
+    /** The Source choice "Latest change" (the scope is then empty). */
+    const val LATEST = "latest"
+
+    /** The book, or null when it cannot be read (the screen says so and "Forget all computers" clears it). */
+    fun read(ctx: Context): StyleView? = try {
+        val entries = Pins.list(ctx).mapNotNull { c -> LookBook.entry(ctx, c.fp)?.let { c.fp to it } }.toMap()
+        StyleView(LookBook.scope(ctx), LookBook.last(ctx), LookBook.source(ctx), LookBook.applied(ctx), entries)
+    } catch (e: OmalawnError) {
+        if (e.code != LookBook.UNREADABLE) throw e
+        null
+    }
+
+    /** "On screen: Laptop's wallpaper & style (Tokyo Night), since 21:45" / "On screen: not from a computer". */
+    fun onScreenLine(view: StyleView, computers: List<Computer>): String {
+        val a = view.applied ?: return "On screen: not from a computer"
+        val name = computers.firstOrNull { it.fp == a.fp }?.label() ?: "A forgotten computer"
+        val theme = view.entries[a.fp]?.theme?.ifEmpty { null }
+        return "On screen: $name's wallpaper & style" + (theme?.let { " ($it)" } ?: "") + ", since " + HomaLawnDates.moment(a.at)
+    }
+
+    /** [fp]'s current wallpaper & style is the one on the screen already. */
+    private fun isShown(ctx: Context, fp: String): Boolean =
+        LookBook.applied(ctx)?.let { it.fp == fp && it.key == LookBook.entry(ctx, fp)?.key } == true
+
+    /** Following [want] (null = latest change) would replace a picture something else set since the book last showed one. */
+    fun wouldReplace(ctx: Context, want: String?): Boolean {
+        val next = want ?: LookBook.last(ctx) ?: return false
+        return LookBook.entry(ctx, next) != null && !isShown(ctx, next) && LookBook.needsReplace(ctx, next)
+    }
+
+    /** The Source becomes [fp] (null = latest change) and its wallpaper & style goes on the screen. */
+    fun applyScope(ctx: Context, fp: String?) {
+        OmalawnCommands.serially {
+            LookBook.setScope(ctx, fp)
+            showSource(ctx)
+        }
+    }
+
+    /** The source's wallpaper & style goes on the screen unless it is there already; a source that sent none leaves the screen alone. */
+    fun showSource(ctx: Context) {
+        OmalawnCommands.serially {
+            val src = LookBook.source(ctx) ?: return@serially
+            if (LookBook.entry(ctx, src) != null && !isShown(ctx, src)) LookBook.show(ctx, src)
+        }
+    }
+
+    /** What a person reads of a failure: the message without its machine code ("no_look: …"). */
+    fun plain(e: Exception): String = (e.message ?: e.javaClass.simpleName).replace(Regex("^[a-z_]+: "), "")
+}
