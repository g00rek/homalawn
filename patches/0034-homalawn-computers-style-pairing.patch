+/**
+ * What Homa Lawn's own screens share (patch 0034): one way to write dates, the one "Replace
+ * current wallpaper?" question, the online dot, and the wallpaper & style source as the Computers
+ * and Wallpaper & style screens read and change it.
+ */
+object HomaLawnDates {
+    // English whatever the phone's language is: Homa Lawn's screens are English on every phone
+    private val EN = Locale.ENGLISH
+
+    /** "just now", "5 min ago", "3 h ago", "1 day ago", "4 days ago". */
+    fun ago(ms: Long, now: Long = System.currentTimeMillis()): String {
+        val m = (now - ms) / 60_000
+        return when {
+            m < 1 -> "just now"
+            m < 60 -> "$m min ago"
+            m < 1440 -> "${m / 60} h ago"
+            m < 2880 -> "1 day ago"
+            else -> "${m / 1440} days ago"
+        }
+    }
+
+    /** "10 Nov", with the year when it is not this year: "10 Nov 2025". */
+    fun day(ms: Long, now: Long = System.currentTimeMillis()): String =
+        SimpleDateFormat(if (sameYear(ms, now)) "d MMM" else "d MMM yyyy", EN).format(Date(ms))
+
+    /** "21:45" today, else the day and the time: "10 Nov, 21:45" (with the year when not this year). */
+    fun moment(ms: Long, now: Long = System.currentTimeMillis()): String {
+        val time = SimpleDateFormat("HH:mm", EN).format(Date(ms))
+        return if (ms >= startOfDay(now) && ms < startOfDay(now) + 86_400_000L) time else day(ms, now) + ", " + time
+    }
+
+    /** The date as a phone screen shows it in the previews: "Thu, 12 Nov" (short) or "Thursday, 12 Nov". */
+    fun screenDate(ms: Long, long: Boolean): String = SimpleDateFormat(if (long) "EEEE, d MMM" else "EEE, d MMM", EN).format(Date(ms))
+
+    private fun sameYear(a: Long, b: Long): Boolean =
+        Calendar.getInstance().apply { timeInMillis = a }.get(Calendar.YEAR) == Calendar.getInstance().apply { timeInMillis = b }.get(Calendar.YEAR)
+
+    private fun startOfDay(ms: Long): Long = Calendar.getInstance().apply {
+        timeInMillis = ms
+        set(Calendar.HOUR_OF_DAY, 0)
+        set(Calendar.MINUTE, 0)
+        set(Calendar.SECOND, 0)
+        set(Calendar.MILLISECOND, 0)
+    }.timeInMillis
+}
