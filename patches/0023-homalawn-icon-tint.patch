diff --git a/lawnchair/src/app/lawnchair/omalawn/HomarIconTint.kt b/lawnchair/src/app/lawnchair/omalawn/HomarIconTint.kt
new file mode 100644
index 0000000000..971e686cab
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/HomarIconTint.kt
@@ -0,0 +1,91 @@
+package app.lawnchair.omalawn
+
+import android.content.ComponentCallbacks
+import android.content.Context
+import android.content.SharedPreferences
+import android.content.res.Configuration
+import android.graphics.Color
+import app.lawnchair.theme.color.tokens.ColorTokens
+import com.android.launcher3.LauncherPrefs
+import com.android.launcher3.Utilities
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * The colours of themed (monochrome) icons, and when they change.
+ *
+ * Lawnchair tints themed icons from its accent (ColorTokens) when an icon is drawn, but nothing
+ * told the icon machinery that the colours had changed: home-screen icons kept the old tint until
+ * something else rebuilt them, and icons that bake the colours in (icon-pack and clock icons) kept
+ * it in the icon cache, across restarts. [stateKey] goes into the launcher's icon state, so a new
+ * accent, colour style, light/dark mode or icon colour makes Launcher3 drop its cached icons and
+ * reload the home screen at once ([onChange] asks it to look).
+ *
+ * Two shared settings, written by the desktop ("#rrggbb", or "#aarrggbb"), override the colours;
+ * empty or missing keeps Lawnchair's accent-derived colour for that part:
+ * `homalawn_icon_color` the symbol, `homalawn_icon_bg_color` the plate behind it.
+ */
+object HomarIconTint {
+    // named like Lawnchair's shared settings, so scripts/gen-prefs-catalog.py lists them
+    private fun StringPref(key: String) = key
+    val KEY_ICON = StringPref("homalawn_icon_color")
+    val KEY_BG = StringPref("homalawn_icon_bg_color")
+    private const val KEY_THEME = "pref_launcherTheme"
+
+    private val listeners = CopyOnWriteArrayList<() -> Unit>()
+    private var watched = false
+
+    // held here: SharedPreferences keeps its listeners only weakly
+    private val prefListener = SharedPreferences.OnSharedPreferenceChangeListener { _, key ->
+        if (key == KEY_ICON || key == KEY_BG || key == KEY_THEME) onChange()
+    }
+
+    /** ThemedIconDrawable.COLORS_LOADER: [base]'s (plate, symbol), with our overrides on top. */
+    fun wrap(base: (Context) -> IntArray): (Context) -> IntArray = { ctx ->
+        val colors = base(ctx)
+        val prefs = LauncherPrefs.getPrefs(ctx)
+        parse(prefs.getString(KEY_BG, null))?.let { colors[0] = it }
+        parse(prefs.getString(KEY_ICON, null))?.let { colors[1] = it }
+        colors
+    }
+
+    /** Everything the themed colours depend on, for the icon state's unique id. */
+    fun stateKey(context: Context): String {
+        val ctx = context.applicationContext ?: context
+        val prefs = LauncherPrefs.getPrefs(ctx)
+        val accents = listOf(
+            ColorTokens.Accent1_100, ColorTokens.Accent1_200, ColorTokens.Accent1_700, ColorTokens.Accent2_800,
+        ).joinToString(",") { Integer.toHexString(it.resolveColor(ctx)) }
+        return "tint:$accents;dark=${Utilities.isDarkTheme(ctx)};" +
+            "${prefs.getString(KEY_ICON, "")};${prefs.getString(KEY_BG, "")}"
+    }
+
+    /** Runs [listener] (on any thread) whenever [stateKey] may have changed. */
+    fun watch(context: Context, listener: () -> Unit) {
+        listeners.add(listener)
+        synchronized(this) {
+            if (watched) return
+            watched = true
+        }
+        val app = context.applicationContext ?: context
+        LauncherPrefs.getPrefs(app).registerOnSharedPreferenceChangeListener(prefListener)
+        app.registerComponentCallbacks(object : ComponentCallbacks {
+            override fun onConfigurationChanged(newConfig: Configuration) = onChange() // night mode
+            @Deprecated("Deprecated in Java")
+            override fun onLowMemory() = Unit
+        })
+    }
+
+    /** Hook in ThemeProvider: the accent, colour style or wallpaper colours changed. */
+    fun onChange() {
+        listeners.forEach { it() }
+    }
+
+    private fun parse(s: String?): Int? {
+        if (s.isNullOrBlank()) return null
+        return try {
+            Color.parseColor(s.trim())
+        } catch (_: IllegalArgumentException) {
+            null
+        }
+    }
+}
