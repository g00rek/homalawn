+    /** Redraws every chip's picture of its page (the pages themselves stay in place). */
+    private fun refreshThumbnails() {
+        val ws = workspace ?: return
+        val starts = ws.reorderablePageGroupStarts
+        pageStripAdapter.updateThumbnails { screenId ->
+            (0 until starts.size()).firstOrNull { ws.getScreenIdForPageIndex(starts[it]) == screenId }
+                ?.let { renderThumbnail(ws, starts[it]) }
+        }
+    }
+
+    /**
+     * A small picture of the page group starting at [groupStart]: what its CellLayouts hold, side
+     * by side for two panels. Recorded into a [Picture] and rendered by the GPU, so widgets with
+     * hardware bitmaps draw too.
+     */
+    private fun renderThumbnail(ws: Workspace<*>, groupStart: Int): Bitmap? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.P) return null
+        val panels = (0 until ws.panelCount).mapNotNull { offset ->
+            ws.getScreenWithId(ws.getScreenIdForPageIndex(groupStart + offset))
+        }
+        val first = panels.firstOrNull() ?: return null
+        val pageWidth = first.width
+        val pageHeight = first.height
+        if (pageWidth <= 0 || pageHeight <= 0) return null
+        val targetHeight = resources.getDimensionPixelSize(R.dimen.edit_mode_page_strip_thumb_height)
+        val scale = targetHeight.toFloat() / pageHeight
+        val width = maxOf(1, (pageWidth * panels.size * scale).toInt())
+        val height = maxOf(1, (pageHeight * scale).toInt())
+        val picture = Picture()
+        val canvas = picture.beginRecording(width, height)
+        canvas.scale(scale, scale)
+        panels.forEachIndexed { index, cellLayout ->
+            val content = cellLayout.shortcutsAndWidgets
+            canvas.save()
+            canvas.translate((index * pageWidth + content.left).toFloat(), content.top.toFloat())
+            content.draw(canvas)
+            canvas.restore()
+        }
+        picture.endRecording()
+        return Bitmap.createBitmap(picture, width, height, Bitmap.Config.HARDWARE)
+    }
+
