-    private fun wallpaperInfo(ctx: Context): JSONObject {
-        val wm = WallpaperManager.getInstance(ctx)
-        return JSONObject()
-            .put("system_id", wm.getWallpaperId(WallpaperManager.FLAG_SYSTEM))
-            .put("lock_id", wm.getWallpaperId(WallpaperManager.FLAG_LOCK))
-            .put("live", wm.wallpaperInfo != null)
+    /**
+     * Which wallpaper a call is about: "home" (FLAG_SYSTEM, the default, so older desktops keep
+     * working), "lock" (FLAG_LOCK) or, for wallpaper_set only, "both".
+     */
+    private fun which(p: JSONObject, allowBoth: Boolean): Int = when (val w = str(p, "which") ?: "home") {
+        "home" -> WallpaperManager.FLAG_SYSTEM
+        "lock" -> WallpaperManager.FLAG_LOCK
+        "both" -> if (allowBoth) WallpaperManager.FLAG_SYSTEM or WallpaperManager.FLAG_LOCK else badWhich(w)
+        else -> badWhich(w)
     }
 
-    /** Saves the current system wallpaper as PNG under files/omalawn/ and returns its path. */
-    private fun wallpaperBackup(ctx: Context): JSONObject {
+    private fun badWhich(w: String): Nothing =
+        throw OmalawnError("bad_params", "bad_params: which must be home, lock or both, not $w")
+
+    /**
+     * lock_id is negative while the lock screen has no wallpaper of its own and shows the home
+     * one (lock_follows_home). width x height: the whole screen in pixels, portrait.
+     */
+    private fun wallpaperInfo(ctx: Context): JSONObject {
+        val wm = WallpaperManager.getInstance(ctx)
+        val lockId = wm.getWallpaperId(WallpaperManager.FLAG_LOCK)
+        val dm = android.util.DisplayMetrics()
+        @Suppress("DEPRECATION")
+        ctx.getSystemService(android.hardware.display.DisplayManager::class.java)
+            ?.getDisplay(android.view.Display.DEFAULT_DISPLAY)?.getRealMetrics(dm)
+        return JSONObject()
+            .put("system_id", wm.getWallpaperId(WallpaperManager.FLAG_SYSTEM))
+            .put("lock_id", lockId)
+            .put("lock_follows_home", lockId < 0)
+            .put("live", wm.wallpaperInfo != null)
+            .put("width", minOf(dm.widthPixels, dm.heightPixels))
+            .put("height", maxOf(dm.widthPixels, dm.heightPixels))
+    }
+
+    /**
+     * Saves the current home ([which] FLAG_SYSTEM) or lock screen (FLAG_LOCK) wallpaper as PNG
+     * under files/omalawn/ and returns its path. A lock screen that shows the home wallpaper has
+     * no picture of its own: that is refused with lock_follows_home (wallpaper_info says so first).
+     */
+    private fun wallpaperBackup(ctx: Context, which: Int): JSONObject {
         val dir = privateDir(ctx)
         val now = System.currentTimeMillis()
         // A backup is read and deleted by its caller within seconds of this call; only one older
@@ -338,10 +373,20 @@ object OmalawnCommands {
         }
         val out = File(dir, "wp-backup-$now-${UUID.randomUUID().toString().take(8)}.png")
         val wm = WallpaperManager.getInstance(ctx)
-        if (wm.wallpaperInfo != null) error("live wallpaper: the current wallpaper is a live wallpaper and cannot be saved")
+        val lock = which == WallpaperManager.FLAG_LOCK
+        if (lock && wm.getWallpaperId(WallpaperManager.FLAG_LOCK) < 0) {
+            throw OmalawnError(
+                "lock_follows_home",
+                "lock_follows_home: the lock screen shows the home wallpaper and has none of its own",
+            )
+        }
+        if (!lock && wm.wallpaperInfo != null) error("live wallpaper: the current wallpaper is a live wallpaper and cannot be saved")
+        if (lock && Build.VERSION.SDK_INT >= 34 && wm.getWallpaperInfo(WallpaperManager.FLAG_LOCK) != null) {
+            error("live wallpaper: the current lock screen wallpaper is a live wallpaper and cannot be saved")
+        }
         val failures = mutableListOf<String>()
         try {
-            val pfd = wm.getWallpaperFile(WallpaperManager.FLAG_SYSTEM)
+            val pfd = wm.getWallpaperFile(which)
             if (pfd == null) {
                 failures.add("getWallpaperFile returned null")
             } else {
@@ -354,7 +399,11 @@ object OmalawnCommands {
             failures.add("getWallpaperFile: ${e.javaClass.simpleName}: ${e.message}")
         }
         try {
-            val d = wm.drawable ?: error("no drawable")
+            val d = (
+                if (!lock) wm.drawable
+                else if (Build.VERSION.SDK_INT >= 34) wm.getDrawable(WallpaperManager.FLAG_LOCK)
+                else error("no lock screen drawable before Android 14")
+                ) ?: error("no drawable")
             val bmp = android.graphics.Bitmap.createBitmap(
                 d.intrinsicWidth.coerceAtLeast(1),
                 d.intrinsicHeight.coerceAtLeast(1),
@@ -372,17 +421,23 @@ object OmalawnCommands {
         error("cannot back up the current wallpaper (${failures.joinToString("; ")})")
     }
 
-    private fun wallpaperSet(ctx: Context, path: String) {
+    /** [which]: FLAG_SYSTEM (home screen), FLAG_LOCK (lock screen) or both. */
+    private fun wallpaperSet(ctx: Context, path: String, which: Int) {
         // The desktop copies the image in with run-as (umask 0): lock it down before reading it.
         privateDir(ctx)
         File(path).takeIf { it.parentFile?.canonicalFile == File(ctx.filesDir, "omalawn").canonicalFile }
             ?.let { if (it.exists()) private600(it) }
-        // Home wallpaper only: the lock screen is never touched (and never backed up).
         File(path).inputStream().use {
-            WallpaperManager.getInstance(ctx).setStream(it, null, true, WallpaperManager.FLAG_SYSTEM)
+            WallpaperManager.getInstance(ctx).setStream(it, null, true, which)
         }
     }
 
+    /** Drops the lock screen's own wallpaper, so the lock screen shows the home one again. */
+    private fun wallpaperLockReset(ctx: Context) {
+        val wm = WallpaperManager.getInstance(ctx)
+        if (wm.getWallpaperId(WallpaperManager.FLAG_LOCK) >= 0) wm.clear(WallpaperManager.FLAG_LOCK)
+    }
+
