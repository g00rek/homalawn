+        if (app.lawnchair.omalawn.link.LinkService.start(this) && !askingHome) {
             app.lawnchair.omalawn.link.NotifyPermission.maybeAsk(this)
         }
 
diff --git a/lawnchair/src/app/lawnchair/omalawn/HomeRole.kt b/lawnchair/src/app/lawnchair/omalawn/HomeRole.kt
new file mode 100644
index 0000000000..2763ebc8db
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/HomeRole.kt
@@ -0,0 +1,52 @@
+package app.lawnchair.omalawn
+
+import android.app.Activity
+import android.app.role.RoleManager
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.util.Log
+import app.lawnchair.LawnchairLauncher
+import com.android.launcher3.util.ApiWrapper
+
+/**
+ * First run as the default home screen. On a fresh install the launcher shows Android's own
+ * "set as default home app" dialog once (upstream's [ApiWrapper.assignDefaultHomeRole], which
+ * also toasts where to change it if the person declines). After that it asks again only when the
+ * person taps "Make Homa Lawn your home screen" in the link notification, which opens the launcher
+ * with [ACTION_REQUEST_HOME].
+ */
+object HomeRole {
+    private const val TAG = "OmalawnHome"
+    private const val PREFS = "omalawn_home"
+    private const val KEY_ASKED = "home_role_asked" // kept across updates, gone with an uninstall
+    const val ACTION_REQUEST_HOME = "app.lawnchair.omalawn.REQUEST_HOME"
+
+    /** The HOME role exists on this phone and another app holds it (or none does). */
+    fun missing(ctx: Context): Boolean {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return false
+        val rm = ctx.getSystemService(RoleManager::class.java) ?: return false
+        return rm.isRoleAvailable(RoleManager.ROLE_HOME) && !rm.isRoleHeld(RoleManager.ROLE_HOME)
+    }
+
+    /**
+     * Called when the launcher comes to the front. Shows the dialog when this install has not
+     * asked yet ([explicit] = false) or the person asked for it ([explicit] = true). Returns true
+     * when the dialog is on its way, so the caller leaves other prompts for the next resume.
+     */
+    fun maybeAsk(activity: Activity, explicit: Boolean): Boolean {
+        if (!missing(activity)) return false
+        val p = activity.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        if (!explicit && p.getBoolean(KEY_ASKED, false)) return false
+        // recorded before asking: the dialog pauses and resumes the launcher, which must not ask again
+        p.edit().putBoolean(KEY_ASKED, true).commit()
+        Log.i(TAG, "asking to become the default home app (${if (explicit) "from the notification" else "first run"})")
+        ApiWrapper.INSTANCE.get(activity).assignDefaultHomeRole(activity)
+        return true
+    }
+
+    /** The notification action's intent: brings the launcher forward, which then asks. */
+    fun requestIntent(ctx: Context): Intent = Intent(ctx, LawnchairLauncher::class.java)
+        .setAction(ACTION_REQUEST_HOME)
+        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+}
