+<?xml version="1.0" encoding="utf-8"?>
+<!-- Homa Lawn's defaults for upstream settings (patch 0026). -->
+<resources>
+    <!-- No announcements from Lawnchair's live information at the top of the settings: they speak
+         about Lawnchair and link to its site. Live information itself stays on (it only sets
+         remote defaults such as the search providers); the switch has no screen, so this default
+         is what every phone gets. -->
+    <bool name="config_default_live_information_show_announcements">false</bool>
+</resources>
