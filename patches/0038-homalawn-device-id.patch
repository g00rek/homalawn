new file mode 100644
index 0000000000..abaa50d380
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/link/DeviceId.kt
@@ -0,0 +1,35 @@
+package app.lawnchair.omalawn.link
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.provider.Settings
+import java.security.MessageDigest
+
+/**
+ * The phone's `device_id` for a paired computer: lowercase hex SHA-256 of "homalawn-device:" +
+ * Settings.Secure.ANDROID_ID. The link certificate is new after Homa Lawn is reinstalled or its
+ * data cleared; this id is not, so the computer can tell the new pairing is the same phone and drop
+ * the old one instead of listing it twice.
+ *
+ * On Android 8+ ANDROID_ID is per app signing key, user and device: it survives reinstalling a
+ * build signed with the same key and changes with a factory reset. A build signed with another key
+ * is a different device to the computer, which is right: it cannot update the other build anyway.
+ * Hashed so the raw ANDROID_ID never leaves the phone. Only a paired computer is told it (`link.hello`
+ * paired, `link.pair_wait` accepted, `launcher.ping`).
+ */
+object DeviceId {
+    @Volatile private var cached: String? = null
+
+    /** Null when Android gives no ANDROID_ID: then the phone reports none, never a shared hash of nothing. */
+    @SuppressLint("HardwareIds")
+    fun get(ctx: Context): String? = cached ?: run {
+        val androidId = Settings.Secure.getString(ctx.contentResolver, Settings.Secure.ANDROID_ID)
+        if (androidId.isNullOrBlank()) return null
+        MessageDigest.getInstance("SHA-256").digest("homalawn-device:$androidId".toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it) }
+            .also { cached = it }
+    }
+
+    /** Puts `device_id` into [o] when there is one. */
+    fun into(ctx: Context, o: org.json.JSONObject): org.json.JSONObject = get(ctx)?.let { o.put("device_id", it) } ?: o
+}
