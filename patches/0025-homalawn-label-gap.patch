@@ -161,6 +171,24 @@ object DeviceGeometry {
         return JSONObject().put("x", p[0]).put("y", p[1]).put("w", v.width).put("h", v.height)
     }
 
+    /**
+     * The label gap as the fixed grid lays it out (patch 0025), null on other grids: `dp` the
+     * visible gap drawn (the setting, held at the maximum), `max_dp` the most the cell has room
+     * for, and the parts of the sum, in px: `shape_margin` (transparent band below the icon's
+     * shape inside its drawable), `cap_inset` (the label line's top to its capitals' top),
+     * `line_height` (the label line), `icon_block` (the icon height the cell centres with the
+     * padding and the label line). With them the desktop computes any gap's padding and icon top:
+     * padding = round(gap * density) - shape_margin - cap_inset, top = (cell_h - min(cell_h,
+     * icon_block + padding + line_height)) / 2.
+     */
+    private fun labelGap(dp: DeviceProfile): JSONObject? {
+        val fit = dp.homarLabelFit ?: return null
+        return JSONObject().put("dp", fit.gapDp.toDouble()).put("max_dp", fit.maxDp)
+            .put("shape_margin", fit.shapeMarginPx).put("cap_inset", fit.label.capInsetPx)
+            .put("line_height", fit.label.lineHeightPx)
+            .put("icon_block", fit.iconBlockPx)
+    }
+
     private fun rect(r: Rect): JSONObject =
         JSONObject().put("left", r.left).put("top", r.top).put("right", r.right).put("bottom", r.bottom)
 }
