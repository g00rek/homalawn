 /**
- * Space between a home-screen icon and its label, in dp, on top of upstream's gap.
+ * The label gap of home-screen icons (patches 0014, 0025): `homar_label_gap_dp` is the VISIBLE
+ * distance, in dp, from the bottom of the icon's visible shape to the top of the label's capital
+ * letters. 0 (also when unset) = the capitals touch the shape, never overlap it.
  *
- * Upstream subtracts the icon's invisible margin from the label padding, so larger icons
- * (home_icon_size_factor > 1) push the label against the icon. 0 keeps upstream's layout; a
- * negative gap (down to [MIN_DP]) pulls the label that much closer, for small icons or tall labels.
- * DeviceProfile adds [extraPx] to the workspace padding before it fits the cell, so a short cell
- * gives the space back from border spacing / cell padding rather than cutting the label; on the
- * fixed grid [fixedCellPadding] keeps the label off the icon when the cell is short.
- * Set from the desktop with `homalawn prefs set homar_label_gap_dp 6`.
+ * The phone turns it into the label view's padding below the icon drawable:
+ * `padding = round(gap * density) - shapeMargin - capInset`, where `shapeMargin` is the
+ * transparent band below the visible shape inside the icon drawable (upstream's model of an icon:
+ * the shape is [ICON_VISIBLE_AREA_FACTOR] of the drawable, centred) and `capInset` is how far the
+ * label's capitals start below the top of its text line, measured with the label's own font at
+ * its own size, the way its one-line TextView lays it out (font padding included).
+ *
+ * It applies to the fixed (non-scalable) grid, the one Homa Lawn's phones use: DeviceProfile
+ * fits it once the cell's final height is known, after upstream sized and fitted everything with
+ * its own padding, so the gap moves the label and nothing else. Every gap from 0 up to
+ * [Fit.maxDp] gives exactly that distance: the most a cell can give is the label line ending at
+ * the cell's bottom with the icon at its top. Beyond that the gap is held at the maximum, which the
+ * phone reports (`launcher.device_profile`, `icon.label_gap`) so the desktop never offers more.
+ * Responsive and scalable grids keep upstream's padding (no `label_gap` reported).
  */
 object HomarLabelGap {
-    private const val MIN_DP = -8f
-    private const val MAX_DP = 32f
+    /** The setting's bounds; the phone's real maximum is [Fit.maxDp], usually much lower. */
+    const val MIN_DP = 0f
+    const val MAX_DP = 32f
+
+    /** "H": its top is the capitals' top, where the gap ends. */
+    private const val CAP = "H"
 
     // a literal, so scripts/gen-prefs-catalog.py lists it for `homalawn prefs set`
     private val key = floatPreferencesKey(name = "homar_label_gap_dp")
@@ -38,34 +64,121 @@ object HomarLabelGap {
         )
     }
 
-    private fun gapDp(prefs2: PreferenceManager2): Float =
+    /** The stored gap in dp, within the setting's bounds (0 when unset). */
+    @JvmStatic
+    fun gapDp(prefs2: PreferenceManager2): Float =
         prefs2.preference(key = key, defaultValue = 0f).firstBlocking().coerceIn(MIN_DP, MAX_DP)
 
-    /** Extra label padding in px for DeviceProfile (0 when unset, negative for a negative gap). */
-    @JvmStatic
-    fun extraPx(prefs2: PreferenceManager2, metrics: DisplayMetrics): Int =
-        px(gapDp(prefs2), metrics)
-
-    /** pxFromDp answers -1 (an invalid resource) for any negative size; negate around it. */
-    private fun px(dp: Float, metrics: DisplayMetrics): Int =
-        if (dp < 0f) -ResourceUtils.pxFromDp(-dp, metrics) else ResourceUtils.pxFromDp(dp, metrics)
+    /** The label's one text line: its height and where its capitals start below its top, in px. */
+    class Label(val lineHeightPx: Int, val capInsetPx: Int)
 
     /**
-     * Label padding for upstream's fixed (non-scalable) grid. Upstream clamps the padding to half
-     * the cell's free height, which goes negative when the cell is shorter than icon + label
-     * (4x8 with larger icons), pulling the label up into the icon by far more than the cell
-     * needs. With a gap set: the [wanted] padding (gap included), shrunk to the [roomPx] the cell
-     * really has below the icon and label (negative when even padding 0 would cut the label's
-     * descenders), never below upstream's own value. Gap 0 keeps upstream's value; a negative gap
-     * takes its dp off upstream's value.
+     * The label line as BubbleTextView draws it: its font (Lawnchair's workspace font, as
+     * FontManager applies it) at [textSizePx]. One line with font padding: the line runs from the
+     * font's top to its bottom, the baseline sits `-top` below the line's top.
      */
     @JvmStatic
-    fun fixedCellPadding(prefs2: PreferenceManager2, upstream: Int, wanted: Int, roomPx: Int): Int {
-        val gap = gapDp(prefs2)
-        return when {
-            gap == 0f -> upstream
-            gap < 0f -> upstream + px(gap, Resources.getSystem().displayMetrics)
-            else -> maxOf(upstream, minOf(wanted, roomPx))
+    fun label(textSizePx: Float): Label {
+        val paint = TextPaint(Paint.ANTI_ALIAS_FLAG)
+        paint.typeface = labelTypeface()
+        paint.textSize = textSizePx
+        val fm = paint.fontMetricsInt
+        val cap = Rect()
+        paint.getTextBounds(CAP, 0, CAP.length, cap)
+        return Label(fm.bottom - fm.top, -fm.top + cap.top)
+    }
+
+    /** The transparent band below the icon's visible shape inside its drawable, in px. */
+    @JvmStatic
+    fun shapeMarginPx(iconSizePx: Int): Int =
+        (iconSizePx - (ICON_VISIBLE_AREA_FACTOR * iconSizePx).roundToInt()) / 2
+
+    /** The label padding (below the icon drawable) that makes the visible gap [gapDp]. */
+    private fun paddingPx(gapDp: Float, metrics: DisplayMetrics, iconSizePx: Int, label: Label): Int =
+        (gapDp * metrics.density).roundToInt() - shapeMarginPx(iconSizePx) - label.capInsetPx
+
+    /**
+     * The fixed grid's icon + label in a cell of [cellHeightPx]: the stored gap, held at the most
+     * the cell gives ([maxDp]: the icon at the cell's top, the label line ending at its bottom).
+     * [paddingPx] is the label view's padding below the icon, [contentHeightPx] the block the cell
+     * centres: [iconBlockPx] (upstream's icon height with its folder overlap), the padding and the
+     * label line, never more than the cell. Where the overlap would make the block taller than the
+     * cell the icon sits at the cell's top either way; held at the cell, the block never tells
+     * DeviceProfile that the grid does not fit (which would shrink the grid, apply the label size
+     * factor a second time, and so change the label's size with the gap).
+     */
+    class Fit(
+        val gapDp: Float,
+        val maxDp: Int,
+        val paddingPx: Int,
+        val contentHeightPx: Int,
+        val iconBlockPx: Int,
+        val label: Label,
+        val shapeMarginPx: Int,
+    )
+
+    @JvmStatic
+    fun fitFixedCell(
+        prefs2: PreferenceManager2,
+        metrics: DisplayMetrics,
+        iconSizePx: Int,
+        iconWithOverlapPx: Int,
+        textSizePx: Float,
+        cellHeightPx: Int,
+    ): Fit {
+        val label = label(textSizePx)
+        val margin = shapeMarginPx(iconSizePx)
+        val roomPx = cellHeightPx - iconSizePx - label.lineHeightPx
+        val maxDp = max(0, floor((roomPx + margin + label.capInsetPx) / metrics.density).toInt())
+        val gap = min(gapDp(prefs2), maxDp.toFloat())
+        val padding = paddingPx(gap, metrics, iconSizePx, label)
+        val content = min(cellHeightPx, iconWithOverlapPx + padding + label.lineHeightPx)
+        return Fit(gap, maxDp, padding, content, iconWithOverlapPx, label, margin)
+    }
+
+    /**
+     * The typeface workspace labels are drawn with: FontManager's font for `font_base_icon` (the
+     * workspace font setting) once FontCache has it, else its fallback, exactly as
+     * FontManager.applyFont sets it on the label. Fonts held in the app (resource, file, system)
+     * load at once; a Google font loads through the font provider, and when it arrives the grid is
+     * reloaded so the label metrics follow it. A change of the workspace font reloads the grid
+     * too (the setting itself only recreates the activity, which keeps the device profile).
+     */
+    private fun labelTypeface(): Typeface {
+        val app = LawnchairApp.instance
+        val prefs = PreferenceManager.getInstance(app)
+        watchFont(app, prefs)
+        val font = prefs.fontWorkspace.get()
+        val cache = FontCache.INSTANCE.get(app)
+        cache.getLoadedFont(font)?.let { return it.typeface }
+        if (font is FontCache.TypefaceFont) return runBlocking { font.load() } ?: Typeface.SANS_SERIF
+        synchronized(this) {
+            arrived[font]?.let { return it }
+            if (loading.add(font)) {
+                MainScope().launch {
+                    val typeface = cache.getTypeface(font) ?: Typeface.SANS_SERIF
+                    synchronized(this@HomarLabelGap) { arrived[font] = typeface }
+                    ReloadHelper(app).reloadGrid()
+                }
+            }
+        }
+        // until the provider answers the label shows no workspace font yet; the reload follows
+        return Typeface.SANS_SERIF
+    }
+
+    /** Provider fonts asked for here, and what they came back as (FontManager's fallback if none). */
+    private val loading = mutableSetOf<FontCache.Font>()
+    private val arrived = mutableMapOf<FontCache.Font, Typeface>()
+
+    @Volatile
+    private var watching = false
+
+    private fun watchFont(app: Context, prefs: PreferenceManager) {
+        if (watching) return
+        synchronized(this) {
+            if (watching) return
+            watching = true
+            prefs.fontWorkspace.addListener { ReloadHelper(app).reloadGrid() }
         }
     }
 }
