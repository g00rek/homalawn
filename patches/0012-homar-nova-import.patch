diff --git a/lawnchair/src/app/lawnchair/omalawn/NovaIo.kt b/lawnchair/src/app/lawnchair/omalawn/NovaIo.kt
new file mode 100644
index 0000000000..1578013964
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/NovaIo.kt
@@ -0,0 +1,111 @@
+package app.lawnchair.omalawn
+
+import android.content.Context
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.system.Os
+import app.lawnchair.DeviceProfileOverrides
+import app.lawnchair.backup.NovaBackupConverter
+import app.lawnchair.preferences2.PreferenceManager2
+import com.patrykmichalik.opto.core.firstBlocking
+import java.io.File
+import kotlinx.coroutines.runBlocking
+import org.json.JSONObject
+
+/**
+ * `launcher.nova_convert` (patch 0012): a Nova Launcher backup (.novabackup zip) turned into a
+ * launcher DB by Lawnchair's own [NovaBackupConverter], without restoring it. The launcher, its
+ * grid and its settings are not touched (only `pin` pins the backup's deep shortcuts, as the
+ * restore does). The computer applies the result itself through the in-process layout import,
+ * after the grid settings the converter would have written, so the link stays up and the change
+ * can be undone; upstream's restore (RestoreDbTask + restart) would kill the process mid-call.
+ *
+ * Params: `path` (the staged backup, inside files/omalawn/; the link sets it), `glance_row`
+ * (true/false: the restore screen's "Add extra row to show At a Glance" switch; missing = the current
+ * At a Glance setting, as upstream reads it), `pin` (true: pin the deep shortcuts).
+ * Result: `path` of the converted DB (the link sends it as the blob) plus what the restore screen
+ * shows and the grid the converted rows need.
+ */
+object NovaIo {
+    const val BAD_BACKUP = "bad_backup"
+    private const val BAD_PATH = "bad_path"
+
+    fun convert(ctx: Context, params: JSONObject): JSONObject {
+        val path = if (params.isNull("path")) throw OmalawnError(BAD_PATH, "$BAD_PATH: path required") else params.getString("path")
+        val dir = OmalawnCommands.privateDir(ctx).canonicalFile
+        val file = File(path).canonicalFile
+        if (file.parentFile != dir) throw OmalawnError(BAD_PATH, "$BAD_PATH: $path is not inside ${dir.path}")
+        try {
+            if (!file.isFile) throw OmalawnError(BAD_PATH, "$BAD_PATH: $path does not exist")
+            Os.chmod(file.absolutePath, 0b110_000_000)
+            val glance = flag(params, "glance_row")
+                ?: PreferenceManager2.getInstance(ctx).enableSmartspace.firstBlocking()
+            val pin = flag(params, "pin") ?: false
+            val converter = NovaBackupConverter(ctx, Uri.fromFile(file))
+            val info = try {
+                runBlocking { converter.parseInfo() }
+            } catch (e: Exception) {
+                throw OmalawnError(BAD_BACKUP, "$BAD_BACKUP: not a Nova backup Lawnchair can read (${e.javaClass.simpleName}: ${e.message})")
+            }
+            val out = File(dir, "export-nova-${System.currentTimeMillis()}.db")
+            val shortcuts = try {
+                runBlocking { converter.stageWorkspaceDb(info, glance, out) }
+            } catch (e: Exception) {
+                out.delete()
+                throw OmalawnError(BAD_BACKUP, "$BAD_BACKUP: Lawnchair could not convert it (${e.javaClass.simpleName}: ${e.message})")
+            } finally {
+                for (suffix in listOf("-journal", "-wal", "-shm")) File(out.path + suffix).delete()
+            }
+            var handedOver = false // the caller takes (and deletes) the DB only from a successful answer
+            try {
+                Os.chmod(out.absolutePath, 0b110_000_000)
+                if (pin) converter.pinDeepShortcuts(shortcuts)
+                val rows = info.rows?.let { if (glance) it + 1 else it }
+                val r = JSONObject()
+                    .put("path", out.absolutePath)
+                    .put("columns", info.columns ?: JSONObject.NULL)
+                    .put("nova_rows", info.rows ?: JSONObject.NULL)
+                    .put("rows", rows ?: JSONObject.NULL)
+                    .put("hotseat", info.hotseatCount ?: JSONObject.NULL)
+                    .put("glance_row", glance)
+                    .put("subgrid", info.isSubgrid)
+                    .put("apps", info.appCount)
+                    .put("widgets", info.widgetCount)
+                    .put("folders", info.folderCount)
+                    .put("shortcuts", info.shortcutCount)
+                    .put("deep_shortcuts", shortcuts.values.sumOf { it.size })
+                    .put("pinned", pin && shortcuts.isNotEmpty())
+                val pack = info.iconPackPackage?.ifEmpty { null }
+                r.put("icon_pack", pack ?: JSONObject.NULL)
+                if (pack != null) {
+                    val installed = try {
+                        ctx.packageManager.getApplicationInfo(pack, 0)
+                        true
+                    } catch (_: PackageManager.NameNotFoundException) {
+                        false
+                    }
+                    r.put("icon_pack_label", info.iconPackLabel ?: pack).put("icon_pack_installed", installed)
+                }
+                if (info.columns != null && rows != null && info.hotseatCount != null) {
+                    r.put("db", DeviceProfileOverrides.DBGridInfo(info.hotseatCount, rows, info.columns).dbFile)
+                }
+                handedOver = true
+                return r
+            } finally {
+                if (!handedOver) out.delete()
+            }
+        } finally {
+            file.delete()
+        }
+    }
+
+    /** true/false as a JSON boolean or its text; missing or null reads as null. */
+    private fun flag(p: JSONObject, k: String): Boolean? {
+        if (p.isNull(k)) return null
+        return when (val v = p.get(k)) {
+            is Boolean -> v
+            else -> v.toString().toBooleanStrictOrNull()
+                ?: throw OmalawnError("bad_params", "bad_params: $k must be true or false, not $v")
+        }
+    }
+}
