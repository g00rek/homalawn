+/** The darken (+) / lighten (-) layer the computer lays over the wallpaper. */
+@Composable
+private fun Layer(amount: Int) {
+    if (amount == 0) return
+    val c = if (amount > 0) Color.Black else Color.White
+    Box(Modifier.fillMaxSize().background(c.copy(alpha = (kotlin.math.abs(amount) / 100f).coerceAtMost(1f))))
+}
