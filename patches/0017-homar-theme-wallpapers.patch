+/**
+ * Keep current, Theme wallpapers, Gradients. A dot marks where the choice is. Each tab is as wide
+ * as its label needs (a row of equal tabs cuts "Theme wallpapers" on a phone).
+ */
+@Composable
+private fun SourceTabs(tab: Int, selected: Sel?, hasGradients: Boolean, onTab: (Int) -> Unit) {
+    val tabs = listOf(
+        stringResource(R.string.homar_wallpapers_tab_keep),
+        stringResource(R.string.homar_wallpapers_tab_wallpapers),
+        stringResource(R.string.homar_wallpapers_tab_gradients),
+    )
+    val chosen = tabOf(selected)
+    val accent = MaterialTheme.colorScheme.primary
+    Column(Modifier.fillMaxWidth().padding(horizontal = 8.dp)) {
+        Row(Modifier.fillMaxWidth().selectableGroup()) {
+            tabs.forEachIndexed { i, label ->
+                val on = tab == i
+                val enabled = i != TAB_GRADIENTS || hasGradients
+                val color = when {
+                    !enabled -> MaterialTheme.colorScheme.onSurface.copy(alpha = 0.38f)
+                    on -> accent
+                    else -> MaterialTheme.colorScheme.onSurfaceVariant
+                }
+                Column(
+                    horizontalAlignment = Alignment.CenterHorizontally,
+                    modifier = Modifier
+                        .weight(label.length + 6f)
+                        .clip(RoundedCornerShape(topStart = 12.dp, topEnd = 12.dp))
+                        .selectable(selected = on, enabled = enabled, role = Role.Tab, onClick = { onTab(i) }),
+                ) {
+                    Row(
+                        verticalAlignment = Alignment.CenterVertically,
+                        modifier = Modifier.height(48.dp),
+                    ) {
+                        Text(
+                            label,
+                            maxLines = 1,
+                            softWrap = false,
+                            color = color,
+                            style = MaterialTheme.typography.labelLarge,
+                            fontWeight = if (on) FontWeight.SemiBold else FontWeight.Medium,
+                        )
+                        if (chosen == i) {
+                            Spacer(Modifier.width(5.dp))
+                            Box(Modifier.size(6.dp).clip(CircleShape).background(accent))
+                        }
+                    }
+                    Box(
+                        Modifier
+                            .fillMaxWidth(0.8f)
+                            .height(3.dp)
+                            .clip(RoundedCornerShape(topStart = 3.dp, topEnd = 3.dp))
+                            .background(if (on) accent else Color.Transparent),
+                    )
+                }
+            }
+        }
+        Box(Modifier.fillMaxWidth().height(1.dp).background(MaterialTheme.colorScheme.outlineVariant))
+    }
+    Spacer(Modifier.height(12.dp))
+}
