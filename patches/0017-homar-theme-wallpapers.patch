+++ b/lawnchair/src/app/lawnchair/omalawn/ThemeWallpapers.kt
@@ -0,0 +1,420 @@
+package app.lawnchair.omalawn
+
+import android.content.Context
+import android.util.Base64
+import java.io.File
+import java.util.UUID
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * The "Wallpaper from Omarchy" screen's data (patch 0017): what the computer offers this phone's
+ * lock screen and home screen, and the choice made here.
+ *
+ * `launcher.theme_wallpapers_set {enabled, theme, current_id, message, target, items, gradients,
+ * screens, layer, thumbs}` replaces the list and stores the given thumbnails (base64 JPEG, one file
+ * per key); it answers `{have: [thumb keys of the list held here]}` so the computer sends only the
+ * missing ones, in as many calls as it needs. `items` are the theme's backgrounds and `gradients`
+ * the gradients made from its colours, each `{id, name, thumb}`; `screens` says what each screen
+ * shows now (`{home: {kind, id?}, lock: ...}`, kind keep, wallpaper or gradient); `layer` is the
+ * darken (+) / lighten (-) percentage per screen, laid over the previews here (the thumbnails come
+ * untinted). A computer from before per-screen choices sends `target` and `current_id` instead.
+ * Format 3 (the computer's whole look model, as its window edits it) adds `format: 3` and
+ * `wallpaper: {parallax}` (the home screen's wallpaper scrolling; a `same` there, from computers
+ * before 2026-10-17, is ignored: the two screens are always set separately), and per item a `wide` thumbnail (the home picture as it is sent with parallax on) and, where the
+ * lock screen has its own crop, a `lock` one; then this screen also edits each screen's colour
+ * layer and parallax. A computer from before sends neither, and those controls stay hidden.
+ *
+ * The screen's selection is a draft; its Apply stores one pending choice `{at, format: 3, screens,
+ * layer, wallpaper: {parallax}}` (at: epoch ms; one choice per screen; a computer from before
+ * format 3 reads only `screens`) that the computer reads with `launcher.theme_wallpaper_choice`
+ * (until it says received) and answers with `launcher.theme_wallpaper_ack {at, state: received |
+ * applied | waiting | failed, current_id?, message?, code?}`. The choice read also says `needs_list`
+ * when this process has no list in the current format yet (the home screen restarted, often for an
+ * app update, or the list on disk came from the older format the computer sent an older build): the
+ * computer then sends the whole list again. A failed ack with code `wallpaper_unsaved` (the current
+ * wallpaper cannot be saved first) makes the screen ask "Replace current wallpaper?"; its Replace
+ * stores the same choice again with `overwrite: true`. Everything lives in files/omalawn/walls/, so
+ * the last list and pictures stay on the phone while the computer is away. The change of wallpaper
+ * itself is the computer's: nothing here touches the wallpaper.
+ */
+object ThemeWallpapers {
+    /** Without "received" within this long, the screen says the computer is not reachable. */
+    const val RECEIVE_WAIT_MS = 8_000L
+
+    const val KEEP = "keep"
+    const val WALLPAPER = "wallpaper"
+    const val GRADIENT = "gradient"
+    val SCREENS = listOf("home", "lock")
+    private val PARTS = mapOf("home" to listOf("home"), "lock" to listOf("lock"), "both" to listOf("home", "lock"))
+
+    /** A wallpaper or gradient: its thumbnail, the wide one (parallax) and the lock screen's own cut. */
+    data class Item(val id: String, val name: String, val thumb: String, val wide: String? = null, val lock: String? = null)
+
+    /** The list and choice format with the whole look model. */
+    const val FORMAT = 3
+
+    /** What one screen shows: keep (what it has now), or a wallpaper or gradient by id. */
+    data class Sel(val kind: String, val id: String? = null) {
+        fun encode(): String = if (id == null) kind else "$kind:$id"
+
+        fun toJson(): JSONObject = JSONObject().put("kind", kind).apply { if (id != null) put("id", id) }
+
+        companion object {
+            val Keep = Sel(KEEP)
+
+            fun decode(s: String?): Sel? {
+                if (s == null) return null
+                val kind = s.substringBefore(':')
+                val id = s.substringAfter(':', "").ifEmpty { null }
+                return when {
+                    kind == KEEP -> Keep
+                    (kind == WALLPAPER || kind == GRADIENT) && id != null && KEY.matches(id) -> Sel(kind, id)
+                    else -> null
+                }
+            }
+
+            fun fromJson(o: JSONObject?): Sel? {
+                if (o == null) return null
+                val kind = o.optString("kind")
+                val id = if (o.isNull("id")) null else o.optString("id").takeIf { KEY.matches(it) }
+                return when (kind) {
+                    KEEP -> Keep
+                    WALLPAPER, GRADIENT -> Sel(kind, id) // id null: the computer has no such picture now
+                    else -> null
+                }
+            }
+        }
+    }
+
+    /**
+     * What the screens get: one choice and colour layer (darken +, lighten -) per screen, each set
+     * on its own, and the home screen's parallax.
+     */
+    data class Look(
+        val screens: Map<String, Sel>,
+        val layer: Map<String, Int> = SCREENS.associateWith { 0 },
+        val parallax: Boolean = false,
+    ) {
+        /**
+         * As it is sent: parallax only scrolls a theme wallpaper, so a gradient or a kept home
+         * screen sends it off (the switch itself is remembered in the draft).
+         */
+        fun normal(): Look = if (parallax && screens["home"]?.kind != WALLPAPER) copy(parallax = false) else this
+
+        fun toJson(): JSONObject = JSONObject()
+            .put("screens", screensJson(screens))
+            .put("layer", JSONObject().apply { SCREENS.forEach { put(it, layer[it] ?: 0) } })
+            .put("wallpaper", JSONObject().put("parallax", parallax))
+
+        companion object {
+            fun fromJson(o: JSONObject?): Look? {
+                val screens = screensFrom(o?.optJSONObject("screens")) ?: return null
+                val w = o!!.optJSONObject("wallpaper")
+                return Look(
+                    screens = screens,
+                    layer = layerFrom(o.optJSONObject("layer")),
+                    parallax = w?.optBoolean("parallax") ?: false,
+                )
+            }
+        }
+    }
+
+    /** An Apply not settled yet: what the screens should get. */
+    data class Choice(
+        val look: Look,
+        val at: Long,
+        val received: Boolean = false,
+        val waiting: String? = null,
+        val overwrite: Boolean = false, // Replace in the overwrite question: no backup of the wallpaper
+    )
+
+    data class State(
+        val known: Boolean = false, // the computer has sent a list at least once
+        val enabled: Boolean = false, // this phone's wallpaper sync is on
+        val theme: String? = null,
+        val message: String? = null, // why there is nothing to show (from the computer)
+        val items: List<Item> = emptyList(),
+        val gradients: List<Item> = emptyList(),
+        val look: Look = Look(SCREENS.associateWith { Sel.Keep }),
+        val perScreen: Boolean = false, // the computer takes one choice per screen (sent `screens`)
+        val model: Boolean = false, // the computer takes the whole look model (format 3): layers, parallax
+        val currentId: String? = null,
+        val choice: Choice? = null,
+        val error: String? = null, // the last choice failed: the computer's line
+        val unsaved: Look? = null, // the last choice failed as wallpaper_unsaved: the screen asks to replace
+        val pictures: Int = 0, // bumped whenever thumbnails arrive
+        val applied: Int = 0, // bumped whenever the computer reports a choice applied
+    ) {
+        val screens: Map<String, Sel> get() = look.screens
+        val layer: Map<String, Int> get() = look.layer
+
+        fun item(id: String?): Item? = id?.let { i -> items.firstOrNull { it.id == i } ?: gradients.firstOrNull { it.id == i } }
+
+        /**
+         * `a` asks for something else than `b`, as far as the computer takes it: a computer from
+         * before the look model reads only what each screen shows.
+         */
+        fun differs(a: Look, b: Look): Boolean = if (model) a.normal() != b.normal() else a.screens != b.screens
+
+        /** The list shows this look applied. */
+        fun shows(l: Look): Boolean = !differs(l, look)
+
+        /** The choice can be offered: a keep, or a picture the list has. */
+        fun valid(s: Sel): Boolean = when (s.kind) {
+            KEEP -> true
+            WALLPAPER -> items.any { it.id == s.id }
+            GRADIENT -> gradients.any { it.id == s.id }
+            else -> false
+        }
+    }
+
+    private val _state = MutableStateFlow(State())
+    val state: StateFlow<State> = _state.asStateFlow()
+
+    private val lock = Any()
+    private var loaded = false
+    private var listed = false // a list in the current format (per screen) arrived in this process
+    private val KEY = Regex("[0-9a-f]{16}")
+    private const val INDEX = "index.json"
+    private const val CHOICE = "choice.json"
+    const val UNSAVED = "wallpaper_unsaved"
+
+    private fun dir(ctx: Context): File = File(OmalawnCommands.privateDir(ctx), "walls").apply { mkdirs() }
+
+    fun thumbFile(ctx: Context, key: String): File? = if (KEY.matches(key)) File(dir(ctx), "$key.jpg") else null
+
+    private fun screensFrom(o: JSONObject?): Map<String, Sel>? {
+        if (o == null) return null
+        val out = SCREENS.associateWith { Sel.fromJson(o.optJSONObject(it)) }
+        return if (out.values.any { it == null }) null else out.mapValues { it.value!! }
+    }
+
+    private fun layerFrom(o: JSONObject?): Map<String, Int> = SCREENS.associateWith { (o?.optInt(it) ?: 0).coerceIn(-100, 100) }
+
+    private fun screensJson(m: Map<String, Sel>): JSONObject =
+        JSONObject().apply { SCREENS.forEach { put(it, m.getValue(it).toJson()) } }
+
+    /** Reads what the computer sent last, once per process. */
+    fun load(ctx: Context) {
+        synchronized(lock) {
+            if (loaded) return
+            loaded = true
+            val d = dir(ctx)
+            var st = State()
+            runCatching { JSONObject(File(d, INDEX).readText()) }.getOrNull()?.let { st = fromIndex(it, st) }
+            runCatching { JSONObject(File(d, CHOICE).readText()) }.getOrNull()?.let { c ->
+                // a choice stored by a build from before the look model: layers and parallax as listed
+                val look = Look.fromJson(c)?.let { l ->
+                    if (c.has("wallpaper")) l else l.copy(layer = st.look.layer, parallax = st.look.parallax)
+                }
+                if (look != null && c.optLong("at") > 0) {
+                    st = st.copy(
+                        choice = Choice(
+                            look,
+                            c.optLong("at"),
+                            c.optBoolean("received"),
+                            c.optString("waiting").ifEmpty { null },
+                            c.optBoolean("overwrite"),
+                        ),
+                    )
+                }
+            }
+            _state.value = st
+        }
+    }
+
+    private fun items(arr: JSONArray?): List<Item> {
+        val out = mutableListOf<Item>()
+        val a = arr ?: JSONArray()
+        for (i in 0 until a.length()) {
+            val it = a.optJSONObject(i) ?: continue
+            val id = it.optString("id")
+            val thumb = it.optString("thumb")
+            val wide = it.optString("wide").takeIf { k -> KEY.matches(k) }
+            val lock = it.optString("lock").takeIf { k -> KEY.matches(k) }
+            if (KEY.matches(id) && KEY.matches(thumb)) out.add(Item(id, it.optString("name").take(120), thumb, wide, lock))
+        }
+        return out
+    }
+
+    private fun fromIndex(o: JSONObject, st: State): State {
+        val currentId = text(o, "current_id")?.takeIf { KEY.matches(it) }
+        val sent = screensFrom(o.optJSONObject("screens"))
+        // a computer from before per-screen choices: the screens its target names show its wallpaper
+        val screens = sent ?: run {
+            val parts = PARTS[o.optString("target")] ?: SCREENS
+            SCREENS.associateWith { if (it in parts) Sel(WALLPAPER, currentId) else Sel.Keep }
+        }
+        val model = sent != null && o.optInt("format") >= FORMAT
+        val w = if (model) o.optJSONObject("wallpaper") else null
+        val look = Look(
+            screens = screens,
+            layer = layerFrom(o.optJSONObject("layer")),
+            parallax = w?.optBoolean("parallax") ?: false,
+        ).normal()
+        return st.copy(
+            known = true,
+            enabled = o.optBoolean("enabled"),
+            theme = text(o, "theme"),
+            message = text(o, "message"),
+            items = items(o.optJSONArray("items")),
+            gradients = items(o.optJSONArray("gradients")),
+            look = look,
+            perScreen = sent != null,
+            model = model,
+            currentId = currentId,
+        )
+    }
+
+    private fun text(o: JSONObject, k: String): String? = if (o.isNull(k)) null else o.optString(k).ifEmpty { null }?.take(300)
+
+    private fun write(f: File, data: ByteArray) {
+        val tmp = File(f.parentFile, ".wall-${UUID.randomUUID()}")
+        try {
+            tmp.outputStream().use { it.write(data) }
+            if (!tmp.renameTo(f)) error("cannot write ${f.name}")
+        } finally {
+            tmp.delete()
+        }
+    }
+
+    private fun saveChoice(ctx: Context, c: Choice?) {
+        val f = File(dir(ctx), CHOICE)
+        if (c == null) {
+            f.delete()
+            return
+        }
+        val o = c.look.toJson().put("at", c.at).put("received", c.received)
+        if (c.waiting != null) o.put("waiting", c.waiting)
+        if (c.overwrite) o.put("overwrite", true)
+        write(f, o.toString().toByteArray())
+    }
+
+    /** `launcher.theme_wallpapers_set`. */
+    fun set(ctx: Context, params: JSONObject): JSONObject = synchronized(lock) {
+        load(ctx)
+        val d = dir(ctx)
+        val thumbs = params.optJSONArray("thumbs") ?: JSONArray()
+        var stored = 0
+        for (i in 0 until thumbs.length()) {
+            val t = thumbs.optJSONObject(i) ?: continue
+            val file = thumbFile(ctx, t.optString("key")) ?: throw OmalawnError("bad_params", "bad_params: thumbnail key")
+            val bytes = try {
+                Base64.decode(t.optString("jpeg"), Base64.DEFAULT)
+            } catch (e: IllegalArgumentException) {
+                throw OmalawnError("bad_params", "bad_params: thumbnail is not base64")
+            }
+            write(file, bytes)
+            stored++
+        }
+        val index = JSONObject()
+            .put("enabled", params.optBoolean("enabled"))
+            .put("theme", params.opt("theme") ?: JSONObject.NULL)
+            .put("message", params.opt("message") ?: JSONObject.NULL)
+            .put("current_id", params.opt("current_id") ?: JSONObject.NULL)
+            .put("target", params.opt("target") ?: JSONObject.NULL)
+            .put("items", params.optJSONArray("items") ?: JSONArray())
+            .put("gradients", params.optJSONArray("gradients") ?: JSONArray())
+            .put("screens", params.optJSONObject("screens") ?: JSONObject.NULL)
+            .put("layer", params.optJSONObject("layer") ?: JSONObject.NULL)
+            .put("format", params.optInt("format"))
+            .put("wallpaper", params.optJSONObject("wallpaper") ?: JSONObject.NULL)
+        var st = fromIndex(index, _state.value)
+        listed = st.perScreen
+        val c = st.choice
+        if (c != null && st.shows(c.look)) {
+            st = st.copy(choice = null, error = null) // the list shows the choice done
+        }
+        if (st.choice == null) saveChoice(ctx, null)
+        write(File(d, INDEX), index.toString().toByteArray())
+        val all = (st.items + st.gradients).flatMap { listOfNotNull(it.thumb, it.wide, it.lock) }.distinct()
+        val wanted = all.map { "$it.jpg" }.toSet()
+        val have = all.filter { File(d, "$it.jpg").isFile }
+        if (have.size == all.size) { // the list is complete: pictures of older lists go
+            d.listFiles()?.filter { it.name.endsWith(".jpg") && it.name !in wanted }?.forEach { it.delete() }
+        }
+        _state.value = st.copy(pictures = _state.value.pictures + stored)
+        JSONObject().put("have", JSONArray(have.distinct()))
+    }
+
+    /**
+     * `launcher.theme_wallpaper_choice`: the Apply the computer has not received yet, and
+     * `needs_list` while no list in the current format has arrived in this process.
+     */
+    fun choice(ctx: Context): JSONObject = synchronized(lock) {
+        load(ctx)
+        val c = _state.value.choice
+        JSONObject().put(
+            "choice",
+            if (c == null || c.received) {
+                JSONObject.NULL
+            } else {
+                c.look.toJson().put("at", c.at).put("format", FORMAT).apply { if (c.overwrite) put("overwrite", true) }
+            },
+        ).put("needs_list", !listed)
+    }
+
+    /** The install's time (the package's lastUpdateTime): `installed_at` in launcher.ping. Every
+     *  install changes it, so the computer tells our builds apart though they share one version. */
+    fun installedAt(ctx: Context): Long = ctx.packageManager.getPackageInfo(ctx.packageName, 0).lastUpdateTime
+
+    /** `launcher.theme_wallpaper_ack`. */
+    fun ack(ctx: Context, params: JSONObject): JSONObject = synchronized(lock) {
+        load(ctx)
+        val at = params.optLong("at")
+        val stateName = params.optString("state")
+        val current = text(params, "current_id")?.takeIf { KEY.matches(it) }
+        val message = text(params, "message")
+        val code = text(params, "code")
+        var st = _state.value
+        val c = st.choice
+        if (c != null && c.at == at) {
+            st = when (stateName) {
+                "received" -> st.copy(choice = c.copy(received = true), error = null)
+                "waiting" -> st.copy(choice = c.copy(received = true, waiting = message))
+                "applied" -> st.copy(choice = null, error = null, look = c.look, currentId = current ?: st.currentId, applied = st.applied + 1)
+                // a wallpaper that cannot be saved first: no message, the screen asks to replace it
+                "failed" -> if (code == UNSAVED && !c.overwrite) {
+                    st.copy(choice = null, error = null, unsaved = c.look)
+                } else {
+                    st.copy(choice = null, error = message ?: "The computer could not apply it.")
+                }
+                else -> throw OmalawnError("bad_params", "bad_params: state must be received, applied, waiting or failed")
+            }
+            saveChoice(ctx, st.choice)
+        } else if (stateName == "applied" && current != null) {
+            st = st.copy(currentId = current, applied = st.applied + 1)
+        }
+        _state.value = st
+        JSONObject().put("ok", true)
+    }
+
+    /**
+     * Apply on the screen: what the screens should get, as one pending choice the computer applies
+     * at its next look (within seconds when connected). Nothing is stored when it is what the screens
+     * show already (or what is on its way); a choice the computer has not read yet is replaced.
+     */
+    fun apply(ctx: Context, want: Look, overwrite: Boolean = false): Boolean {
+        synchronized(lock) {
+            load(ctx)
+            val st = _state.value
+            val look = want.normal()
+            if (!st.enabled || !st.perScreen || SCREENS.any { it !in look.screens }) return false
+            if (look.screens.values.any { !st.valid(it) }) return false
+            if (st.differs(look, st.choice?.look ?: st.look).not()) return false
+            val c = Choice(look, System.currentTimeMillis(), overwrite = overwrite)
+            saveChoice(ctx, c)
+            _state.value = st.copy(choice = c, error = null, unsaved = null)
+            return true
+        }
+    }
+
+    /** Cancel in the overwrite question: nothing is sent; the screen keeps the choice as its draft. */
+    fun dismissUnsaved() {
+        synchronized(lock) { _state.value = _state.value.copy(unsaved = null) }
+    }
+}
