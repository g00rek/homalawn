+/**
+ * What a screen shows for a look: a wallpaper or gradient with that screen's colour layer over
+ * it (the home screen with parallax on a theme wallpaper: the left part of the wide picture, its
+ * first page; the lock screen with its own cut whenever it has one); keep shows what the screen has now (what the computer
+ * put there, else the phone's own wallpaper).
+ */
+@Composable
+private fun ScreenPicture(st: ThemeWallpapers.State, shown: Look, base: Look, screen: String, modifier: Modifier = Modifier) {
+    val kept = shown.screens.getValue(screen).kind == ThemeWallpapers.KEEP
+    val look = if (kept && base.screens.getValue(screen).kind != ThemeWallpapers.KEEP) base else shown
+    val sel = look.screens.getValue(screen)
+    Box(modifier = modifier) {
+        if (sel.kind == ThemeWallpapers.KEEP) {
+            SystemWallpaper(screen = screen, applied = st.applied, modifier = Modifier.fillMaxSize())
+        } else {
+            val item = st.item(sel.id)
+            val wide = screen == HOME && look.normal().parallax && item?.wide != null
+            val key = when {
+                wide -> item?.wide
+                screen == LOCK && item?.lock != null -> item.lock
+                else -> item?.thumb
+            }
+            Thumbnail(key, st.pictures, Modifier.fillMaxSize(), alignment = if (wide) Alignment.CenterStart else Alignment.Center)
+            Layer(look.layer[screen] ?: 0)
+        }
+    }
+}
