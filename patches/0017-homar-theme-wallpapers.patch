+/** The draft as text, so it survives a rotation. */
+private fun encode(l: Look): String = l.toJson().toString()
+
+private fun decode(s: String?): Look? = s?.let { runCatching { Look.fromJson(JSONObject(it)) }.getOrNull() }
+
+/**
+ * The screen. On top, the lock screen and the home screen as they will look (the draft; views,
+ * not controls). Below, a Lock screen panel and a Home screen panel: the two screens are always
+ * set separately. Each panel: Keep current, the theme's wallpapers or gradients made from its
+ * colours; its darken / lighten layer; on the Home screen panel, while it shows Theme wallpapers,
+ * the parallax switch. A computer from before the look model takes no layers or parallax: those stay
+ * hidden. Taps only change the draft (it survives a rotation; leaving the screen drops it); Apply
+ * sends it as one choice and the bar shows how it goes; Discard returns to what is applied.
+ */
+@Composable
+fun ThemeWallpapersScreen(modifier: Modifier = Modifier) {
+    val ctx = LocalContext.current
+    LaunchedEffect(Unit) { withContext(Dispatchers.IO) { ThemeWallpapers.load(ctx) } }
+    val st by ThemeWallpapers.state.collectAsState()
+    var now by remember { mutableLongStateOf(System.currentTimeMillis()) }
+    val choice = st.choice
+    LaunchedEffect(choice) {
+        while (choice != null && !choice.received) {
+            now = System.currentTimeMillis()
+            if (now - choice.at > ThemeWallpapers.RECEIVE_WAIT_MS) break
+            delay(500)
+        }
+    }
+    // what is applied, or on its way: the draft is compared with this
+    val base: Look = (choice?.look ?: st.look).normal()
+    var draftText by rememberSaveable { mutableStateOf<String?>(null) }
+    val draft: Look = decode(draftText)?.takeIf { d -> d.screens.values.all { st.valid(it) } } ?: base
+    val dirty = st.differs(draft, base)
+    // a lambda, not a function reference: it captures the current `base`
+    val edit: (Look) -> Unit = { l ->
+        draftText = if (l != base) encode(l) else null
+    }
+    val showPicker = st.known && st.enabled && st.message == null && st.perScreen &&
+        (st.items.isNotEmpty() || st.gradients.isNotEmpty())
+    val status: Pair<ImageVector?, String>? = when {
+        choice != null && choice.waiting != null -> Icons.Rounded.Lock to choice.waiting
+        choice != null && !choice.received && now - choice.at > ThemeWallpapers.RECEIVE_WAIT_MS ->
+            Icons.Rounded.CloudOff to stringResource(R.string.homar_wallpapers_unreachable)
+        choice != null -> null to stringResource(R.string.homar_wallpapers_applying)
+        st.error != null -> Icons.Rounded.ErrorOutline to st.error!!
+        else -> null
+    }
+
+    // the computer cannot save the current wallpaper first: ask, with no other words (owner's rule);
+    // Cancel keeps the refused choice as the draft
+    val unsaved = st.unsaved
+    if (unsaved != null) {
+        val cancel = {
+            edit(unsaved)
+            ThemeWallpapers.dismissUnsaved()
+        }
+        AlertDialog(
+            onDismissRequest = cancel,
+            title = { Text(stringResource(R.string.homar_wallpapers_replace_title)) },
+            confirmButton = {
+                TextButton(onClick = {
+                    if (!ThemeWallpapers.apply(ctx, unsaved, overwrite = true)) cancel()
+                }) { Text(stringResource(R.string.homar_wallpapers_replace)) }
+            },
+            dismissButton = {
+                TextButton(onClick = cancel) { Text(stringResource(R.string.homar_wallpapers_cancel)) }
+            },
+        )
+    }
+
+    PreferenceLayout(
+        label = stringResource(R.string.homar_wallpapers_label),
+        backArrowVisible = !LocalIsExpandedScreen.current,
+        modifier = modifier,
+        verticalArrangement = Arrangement.spacedBy(0.dp),
+        bottomBar = {
+            if (!showPicker) {
+                BottomSpacer()
+            } else {
+                ApplyBar(
+                    dirty = dirty,
+                    status = status,
+                    error = choice == null && st.error != null,
+                    onDiscard = { draftText = null },
+                    onApply = {
+                        if (ThemeWallpapers.apply(ctx, draft)) draftText = null
+                    },
+                )
+            }
+        },
+    ) {
+        when {
+            !st.known -> Notice(Icons.Rounded.Info, stringResource(R.string.homar_wallpapers_nothing_yet))
+            !st.enabled -> Notice(Icons.Rounded.Info, stringResource(R.string.homar_wallpapers_sync_off))
+            st.message != null -> Notice(Icons.Rounded.Info, st.message!!)
+            !st.perScreen -> Notice(Icons.Rounded.Info, stringResource(R.string.homar_wallpapers_update_computer))
+            st.items.isEmpty() && st.gradients.isEmpty() -> Notice(Icons.Rounded.Info, stringResource(R.string.homar_wallpapers_empty))
+            else -> {
+                ThemeLine(st.theme)
+                Previews(st = st, base = base, shown = draft)
+                WallpaperPanel(st, base, draft, LOCK, stringResource(R.string.homar_wallpapers_target_lock), edit = edit)
+                WallpaperPanel(st, base, draft, HOME, stringResource(R.string.homar_wallpapers_target_home), edit = edit)
+                Spacer(Modifier.height(8.dp))
+            }
+        }
+    }
+}
