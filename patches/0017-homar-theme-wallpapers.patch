+/** The theme's wallpapers or its gradients, three to a row. */
+@Composable
+private fun PicturePane(
+    st: ThemeWallpapers.State,
+    items: List<ThemeWallpapers.Item>,
+    kind: String,
+    base: Look,
+    selected: Sel?,
+    prefix: String,
+    empty: String,
+    onPick: (Sel) -> Unit,
+) {
+    if (items.isEmpty()) {
+        Text(
+            text = empty,
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(horizontal = 20.dp, vertical = 8.dp),
+        )
+        return
+    }
+    val gradient = kind == ThemeWallpapers.GRADIENT
+    Column(
+        modifier = Modifier.padding(horizontal = 12.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        items.chunked(3).forEach { row ->
+            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                row.forEach { item ->
+                    val sel = Sel(kind, item.id)
+                    PictureTile(
+                        item = item,
+                        pictures = st.pictures,
+                        named = gradient,
+                        prefix = prefix,
+                        selected = sel == selected,
+                        onLock = base.screens[LOCK] == sel,
+                        onHome = base.screens[HOME] == sel,
+                        modifier = Modifier.weight(1f),
+                        onClick = { onPick(sel) },
+                    )
+                }
+                repeat(3 - row.size) { Spacer(Modifier.weight(1f)) }
+            }
+        }
+    }
+}
+
+/** One wallpaper or gradient: an outline and check when selected; where it is in use now. */
+@Composable
+private fun PictureTile(
+    item: ThemeWallpapers.Item,
+    pictures: Int,
+    named: Boolean,
+    prefix: String,
+    selected: Boolean,
+    onLock: Boolean,
+    onHome: Boolean,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val selectedText = stringResource(R.string.homar_wallpapers_selected)
+    val lockText = stringResource(R.string.homar_wallpapers_on_lock)
+    val homeText = stringResource(R.string.homar_wallpapers_on_home)
+    val gradientText = stringResource(R.string.homar_wallpapers_gradient)
+    Tile(
+        selected = selected,
+        modifier = modifier
+            .selectable(selected = selected, role = Role.RadioButton, onClick = onClick)
+            .clearAndSetSemantics {
+                role = Role.RadioButton
+                this.selected = selected
+                contentDescription = prefix + (if (named) "${item.name} $gradientText" else item.name) +
+                    (if (selected) ", $selectedText" else "") +
+                    (if (onLock) ", $lockText" else "") +
+                    (if (onHome) ", $homeText" else "")
+            },
+    ) {
+        Thumbnail(item.thumb, pictures, Modifier.fillMaxSize())
+        if (named) {
+            Text(
+                text = item.name,
+                color = Color.White,
+                style = MaterialTheme.typography.labelMedium.copy(shadow = textShadow()),
+                textAlign = TextAlign.Center,
+                modifier = Modifier
+                    .align(Alignment.BottomCenter)
+                    .fillMaxWidth()
+                    .background(Brush.verticalGradient(listOf(Color.Transparent, Color.Black.copy(alpha = 0.35f))))
+                    .padding(top = 14.dp, bottom = 8.dp),
+            )
+        }
+        if (onLock || onHome) {
+            Row(
+                horizontalArrangement = Arrangement.spacedBy(2.dp),
+                modifier = Modifier
+                    .align(Alignment.TopStart)
+                    .padding(6.dp)
+                    .clip(CircleShape)
+                    .background(Color.Black.copy(alpha = 0.45f))
+                    .padding(horizontal = 6.dp, vertical = 3.dp),
+            ) {
+                if (onLock) Icon(Icons.Rounded.Lock, null, tint = Color.White, modifier = Modifier.size(12.dp))
+                if (onHome) Icon(Icons.Rounded.Home, null, tint = Color.White, modifier = Modifier.size(12.dp))
+            }
+        }
+    }
+}
+
+/** A tall rounded tile with the selection ring and check mark. */
+@Composable
+private fun Tile(selected: Boolean, modifier: Modifier = Modifier, content: @Composable androidx.compose.foundation.layout.BoxScope.() -> Unit) {
+    val accent = MaterialTheme.colorScheme.primary
+    val shape: Shape = RoundedCornerShape(if (selected) 20.dp else 14.dp)
+    Box(
+        modifier = modifier
+            .aspectRatio(9f / 19.5f)
+            .border(if (selected) 3.dp else 0.dp, if (selected) accent else Color.Transparent, RoundedCornerShape(20.dp))
+            .padding(if (selected) 5.dp else 0.dp)
+            .clip(shape)
+            .background(MaterialTheme.colorScheme.surfaceVariant),
+    ) {
+        content()
+        if (selected) {
+            Box(
+                contentAlignment = Alignment.Center,
+                modifier = Modifier
+                    .align(Alignment.TopEnd)
+                    .padding(6.dp)
+                    .size(22.dp)
+                    .clip(CircleShape)
+                    .background(accent),
+            ) {
+                Icon(Icons.Rounded.Check, null, tint = MaterialTheme.colorScheme.onPrimary, modifier = Modifier.size(15.dp))
+            }
+        }
+    }
+}
+
+/** Darken / lighten: a black (+) or white (-) layer over this panel's screen(s), -100..100 %. */
+@Composable
+private fun LayerSlider(value: Int, enabled: Boolean, description: String, onChange: (Int) -> Unit) {
+    val label = stringResource(R.string.homar_wallpapers_layer)
+    val amount = if (value < 0) "−${-value}%" else "$value%"
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .background(MaterialTheme.colorScheme.surfaceContainer)
+            .padding(start = 20.dp, end = 20.dp, top = 14.dp, bottom = 6.dp),
+    ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Text(
+                text = label,
+                style = MaterialTheme.typography.titleMedium,
+                color = if (enabled) MaterialTheme.colorScheme.onSurface else MaterialTheme.colorScheme.onSurface.copy(alpha = 0.38f),
+                modifier = Modifier.weight(1f),
+            )
+            Text(
+                text = amount,
+                style = MaterialTheme.typography.labelLarge,
+                fontWeight = FontWeight.SemiBold,
+                color = if (enabled) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurface.copy(alpha = 0.38f),
+            )
+        }
+        // the track runs from white (lighter) through clear to black (darker), as the layer does:
+        // drawn under the slider, whose own track is clear
+        val outline = MaterialTheme.colorScheme.outline
+        Box(contentAlignment = Alignment.Center, modifier = Modifier.fillMaxWidth()) {
+            Box(
+                Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 2.dp)
+                    .height(10.dp)
+                    .clip(CircleShape)
+                    .background(Brush.horizontalGradient(listOf(Color.White, Color(0xFF8A8A8A), Color.Black)))
+                    .border(1.dp, outline.copy(alpha = if (enabled) 0.6f else 0.25f), CircleShape),
+            )
+            Slider(
+                value = value.toFloat(),
+                onValueChange = { onChange(it.roundToInt().coerceIn(-100, 100)) },
+                valueRange = -100f..100f,
+                enabled = enabled,
+                colors = SliderDefaults.colors(
+                    activeTrackColor = Color.Transparent,
+                    inactiveTrackColor = Color.Transparent,
+                    disabledActiveTrackColor = Color.Transparent,
+                    disabledInactiveTrackColor = Color.Transparent,
+                    activeTickColor = Color.Transparent,
+                    inactiveTickColor = Color.Transparent,
+                    disabledActiveTickColor = Color.Transparent,
+                    disabledInactiveTickColor = Color.Transparent,
+                ),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .semantics { contentDescription = description },
+            )
+        }
+        Row {
+            Text(
+                stringResource(R.string.homar_wallpapers_lighter),
+                style = MaterialTheme.typography.labelSmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.weight(1f),
+            )
+            Text(
+                stringResource(R.string.homar_wallpapers_darker),
+                style = MaterialTheme.typography.labelSmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+    }
+}
