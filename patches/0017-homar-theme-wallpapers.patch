+/** This phone's dock and a few of its home-screen apps, as the launcher draws their icons. */
+private object HomeIcons {
+    class Set(val dock: List<ImageBitmap>, val apps: List<ImageBitmap>)
+
+    @Volatile private var cached: Set? = null
+
+    suspend fun load(ctx: Context): Set? {
+        cached?.let { return it }
+        val model = runCatching { LauncherAppState.getInstance(ctx).model }.getOrNull() ?: return null
+        val items: List<ItemInfoWithIcon>? = withTimeoutOrNull(3_000) {
+            suspendCancellableCoroutine { cont ->
+                model.loadAsync { data ->
+                    val all = data?.itemsIdMap?.filterIsInstance<ItemInfoWithIcon>().orEmpty()
+                    val dock = all.filter { it.container == LauncherSettings.Favorites.CONTAINER_HOTSEAT }.sortedBy { it.screenId }
+                    val desk = all.filter { it.container == LauncherSettings.Favorites.CONTAINER_DESKTOP }
+                        .sortedWith(compareBy({ it.screenId }, { -it.cellY }, { it.cellX }))
+                    cont.resume(dock.take(4) + desk.take(4))
+                }
+            }
+        }
+        if (items == null) return null
+        val px = (48 * ctx.resources.displayMetrics.density).toInt().coerceAtLeast(48)
+        val bitmaps = withContext(Dispatchers.Default) {
+            items.map { info ->
+                runCatching {
+                    val d = runCatching { info.newIcon(ctx) as android.graphics.drawable.Drawable }
+                        .onFailure { android.util.Log.w("HomarWallpapers", "icon of ${info.targetComponent}", it) }
+                        .getOrNull()
+                        ?: ctx.packageManager.getActivityIcon(info.targetComponent!!)
+                    val bmp = Bitmap.createBitmap(px, px, Bitmap.Config.ARGB_8888)
+                    d.setBounds(0, 0, px, px)
+                    d.draw(Canvas(bmp))
+                    bmp.asImageBitmap()
+                }.getOrNull()
+            }
+        }
+        val dockCount = items.count { it.container == LauncherSettings.Favorites.CONTAINER_HOTSEAT }
+        return Set(bitmaps.take(dockCount).filterNotNull(), bitmaps.drop(dockCount).filterNotNull()).also { cached = it }
+    }
+}
