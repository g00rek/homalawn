+/** A clock and date as the lock screen draws them. */
+@Composable
+private fun LockOverlay() {
+    val ctx = LocalContext.current
+    val time = remember {
+        val d = Date()
+        DateFormat.getTimeFormat(ctx).format(d).replace(Regex("\\s?[AaPp]\\.?[Mm]\\.?$"), "") to
+            DateFormat.format("EEE, d MMM", d).toString()
+    }
+    BoxWithConstraints(Modifier.fillMaxSize()) {
+        val w = maxWidth
+        StatusBar(showTime = false)
+        Icon(
+            Icons.Rounded.Lock,
+            contentDescription = null,
+            tint = Color.White,
+            modifier = Modifier.align(Alignment.TopCenter).padding(top = w * 0.14f).size(w * 0.07f),
+        )
+        Column(
+            horizontalAlignment = Alignment.CenterHorizontally,
+            modifier = Modifier.align(Alignment.TopCenter).padding(top = w * 0.32f),
+        ) {
+            Text(
+                text = time.second,
+                color = Color.White,
+                fontSize = (w.value * 0.075f).sp,
+                fontWeight = FontWeight.Medium,
+                style = MaterialTheme.typography.labelSmall.copy(shadow = textShadow()),
+            )
