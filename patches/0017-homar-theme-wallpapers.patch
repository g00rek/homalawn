+/**
+ * One screen's wallpaper panel. Source tabs; the pictures or the keep line; the darken / lighten
+ * layer and, for the home screen while it shows Theme wallpapers, parallax (only when the computer
+ * takes them).
+ */
+@Composable
+private fun WallpaperPanel(
+    st: ThemeWallpapers.State,
+    base: Look,
+    draft: Look,
+    panel: String,
+    title: String,
+    edit: (Look) -> Unit,
+) {
+    val sel = draft.screens.getValue(panel)
+    var tabPicked by rememberSaveable(panel) { mutableStateOf<Int?>(null) }
+    val tab = tabPicked ?: tabOf(sel) ?: TAB_WALLPAPERS
+    val pick: (Sel) -> Unit = { s -> edit(draft.copy(screens = draft.screens + (panel to s))) }
+    // a tile's description names the screen: there are two panels
+    val prefix = "$title: "
+    val onTab: (Int) -> Unit = { t ->
+        tabPicked = t
+        when {
+            t == TAB_KEEP -> pick(Sel.Keep)
+            // back from Keep current: what this screen had, when it had a picture of this tab
+            sel.kind == ThemeWallpapers.KEEP && tabOf(base.screens.getValue(panel)) == t -> pick(base.screens.getValue(panel))
+        }
+    }
+    PreferenceGroup(heading = title) {
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .background(MaterialTheme.colorScheme.surfaceContainer)
+                .padding(bottom = 12.dp),
+        ) {
+            SourceTabs(tab = tab, selected = sel, hasGradients = st.gradients.isNotEmpty(), onTab = onTab)
+            when (tab) {
+                TAB_KEEP -> KeepLine()
+                TAB_WALLPAPERS -> PicturePane(
+                    st = st,
+                    items = st.items,
+                    kind = ThemeWallpapers.WALLPAPER,
+                    base = base,
+                    selected = sel,
+                    prefix = prefix,
+                    empty = stringResource(R.string.homar_wallpapers_empty),
+                    onPick = pick,
+                )
+                else -> PicturePane(
+                    st = st,
+                    items = st.gradients,
+                    kind = ThemeWallpapers.GRADIENT,
+                    base = base,
+                    selected = sel,
+                    prefix = prefix,
+                    empty = stringResource(R.string.homar_wallpapers_no_gradients),
+                    onPick = pick,
+                )
+            }
+        }
+        if (st.model) {
+            val kept = sel.kind == ThemeWallpapers.KEEP
+            LayerSlider(
+                value = draft.layer[panel] ?: 0,
+                enabled = !kept,
+                description = prefix + stringResource(R.string.homar_wallpapers_layer),
+                onChange = { v -> edit(draft.copy(layer = draft.layer + (panel to v))) },
+            )
+            // parallax scrolls a theme wallpaper only: no switch with a gradient or Keep current
+            if (panel == HOME && sel.kind == ThemeWallpapers.WALLPAPER) {
+                SwitchPreference(
+                    checked = draft.parallax,
+                    onCheckedChange = { edit(draft.copy(parallax = it)) },
+                    label = stringResource(R.string.homar_wallpapers_parallax),
+                    description = stringResource(R.string.homar_wallpapers_parallax_hint),
+                )
+            }
+        }
+    }
+}
