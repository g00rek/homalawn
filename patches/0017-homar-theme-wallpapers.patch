+/** The phone's own wallpaper, when Android lets it be read; else a wash of its colours. */
+@Composable
+private fun SystemWallpaper(screen: String, applied: Int, modifier: Modifier = Modifier) {
+    val ctx = LocalContext.current
+    val picture by produceState<Pair<ImageBitmap?, List<Color>>?>(null, screen, applied) {
+        value = withContext(Dispatchers.IO) { CurrentWallpaper.read(ctx, screen) }
+    }
+    val p = picture
+    val surface = MaterialTheme.colorScheme.surfaceVariant
+    Box(modifier.background(surface)) {
+        when {
+            p?.first != null -> Image(p.first!!, null, contentScale = ContentScale.Crop, modifier = Modifier.fillMaxSize())
+            p != null && p.second.isNotEmpty() -> Box(
+                Modifier
+                    .fillMaxSize()
+                    .background(Brush.verticalGradient(if (p.second.size == 1) p.second + p.second else p.second)),
+            )
+            p != null -> Icon(
+                Icons.Rounded.Wallpaper,
+                contentDescription = null,
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.align(Alignment.Center).size(28.dp),
+            )
+        }
+    }
+}
+
+/** Reads what a screen shows now on this phone. */
+private object CurrentWallpaper {
+    fun read(ctx: Context, screen: String): Pair<ImageBitmap?, List<Color>> {
+        val wm = WallpaperManager.getInstance(ctx)
+        val lock = screen == LOCK && wm.getWallpaperId(WallpaperManager.FLAG_LOCK) >= 0
+        val flag = if (lock) WallpaperManager.FLAG_LOCK else WallpaperManager.FLAG_SYSTEM
+        val bitmap = runCatching {
+            wm.getWallpaperFile(flag)?.use { pfd ->
+                val opts = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+                BitmapFactory.decodeFileDescriptor(pfd.fileDescriptor, null, opts)
+                var sample = 1
+                while (opts.outWidth / (sample * 2) >= 360) sample *= 2
+                android.system.Os.lseek(pfd.fileDescriptor, 0, android.system.OsConstants.SEEK_SET)
+                BitmapFactory.decodeFileDescriptor(pfd.fileDescriptor, null, BitmapFactory.Options().apply { inSampleSize = sample })
+            }
+        }.getOrNull()
+        if (bitmap != null) return bitmap.asImageBitmap() to emptyList()
+        val wc = runCatching { wm.getWallpaperColors(flag) ?: wm.getWallpaperColors(WallpaperManager.FLAG_SYSTEM) }.getOrNull()
+        val colors = listOfNotNull(wc?.primaryColor, wc?.secondaryColor, wc?.tertiaryColor).map { Color(it.toArgb()) }
+        return null to colors
+    }
+}
