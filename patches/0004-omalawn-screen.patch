+/**
+ * `screen.*`: read and operate the screen through Lawnchair's accessibility service, for a paired
+ * computer over the link (the shell-only provider exposes `screen.status` only). Nothing here runs
+ * on its own: every call is one request, and the tree is read on demand (the service takes no
+ * events).
+ *
+ * Node ids ("n0", "n1", …) name the nodes of the last `screen.tree` and are valid until the next.
+ */
+object ScreenCommands {
+    const val SCREEN_OFF = "screen_off"
+    const val RATE_LIMITED = "rate_limited"
+    const val STALE_NODE = "stale_node"
+    const val BAD_PARAMS = "bad_params"
+    const val NO_WINDOW = "no_window"
+    const val NOT_EDITABLE = "not_editable"
+    const val GESTURE_FAILED = "gesture_failed"
+    const val SHOT_FAILED = "shot_failed"
+    const val NOT_FOUND = "not_found"
+    const val BUSY = "busy"
+
+    /** Android refuses screenshots closer than 333 ms apart; a little margin over that. */
+    const val SHOT_INTERVAL_MS = 340L
+    private const val MAX_NODES = 1500
+    private const val MAX_DEPTH = 80
+    private const val MAX_TEXT = 10_000
+    private const val MAX_GESTURE_MS = 10_000L
+    private const val TAP_MS = 50L
+    private const val LONG_PRESS_MS = 800L
+    private const val SWIPE_MS = 300L
+    private const val LOCK_WAIT_S = 15L
+    private const val ROOT_TRIES = 6
+    private const val ROOT_RETRY_MS = 200L
+    private val PACKAGE = Regex("[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)+")
+
+    private val KEYS = mapOf(
+        "back" to AccessibilityService.GLOBAL_ACTION_BACK,
+        "home" to AccessibilityService.GLOBAL_ACTION_HOME,
+        "recents" to AccessibilityService.GLOBAL_ACTION_RECENTS,
+        "notifications" to AccessibilityService.GLOBAL_ACTION_NOTIFICATIONS,
+        "quick_settings" to AccessibilityService.GLOBAL_ACTION_QUICK_SETTINGS,
+    )
+
+    /** One screen action at a time across every connection; the node table belongs to it. */
+    private val lock = ReentrantLock(true)
+    private var nodes: List<AccessibilityNodeInfo> = emptyList()
+    private var lastShot = 0L // elapsedRealtime of the last screenshot request
+    private val shotExecutor = Executors.newSingleThreadExecutor { r ->
+        Thread(r, "omalawn-screen-shot").apply { isDaemon = true }
+    }
+
+    fun dispatch(ctx: Context, method: String, params: JSONObject): Any {
+        if (method == "screen.status") return status(ctx)
+        val svc = LawnchairAccessibilityService.current
+            ?: throw OmalawnError(SCREEN_OFF, "Turn on Lawnchair in Settings › Accessibility")
+        if (!lock.tryLock(LOCK_WAIT_S, TimeUnit.SECONDS)) {
+            throw OmalawnError(BUSY, "$BUSY: another screen action has been running for over ${LOCK_WAIT_S}s")
+        }
+        try {
+            // what changes the screen also waits for (and holds off) launcher writes: a tap never
+            // lands in the middle of a layout import or a reload
+            if (method in ACTIONS) return OmalawnCommands.serially { act(ctx, svc, method, params) }
+            return act(ctx, svc, method, params)
+        } finally {
+            lock.unlock()
+        }
+    }
+
+    private val ACTIONS = setOf("screen.tap", "screen.long_press", "screen.swipe", "screen.type", "screen.key")
+
+    private fun act(ctx: Context, svc: LawnchairAccessibilityService, method: String, params: JSONObject): Any = when (method) {
+        "screen.tree" -> tree(svc)
+        "screen.tap" -> {
+            val (x, y) = point(ctx, params)
+            gesture(svc, Path().apply { moveTo(x, y) }, TAP_MS)
+            JSONObject().put("x", x.toInt()).put("y", y.toInt())
+        }
+        "screen.long_press" -> {
+            val (x, y) = point(ctx, params)
+            gesture(svc, Path().apply { moveTo(x, y) }, ms(params, LONG_PRESS_MS))
+            JSONObject().put("x", x.toInt()).put("y", y.toInt())
+        }
+        "screen.swipe" -> {
+            val (x1, y1) = coords(ctx, params, "x1", "y1")
+            val (x2, y2) = coords(ctx, params, "x2", "y2")
+            gesture(svc, Path().apply { moveTo(x1, y1); lineTo(x2, y2) }, ms(params, SWIPE_MS))
+            JSONObject()
+        }
+        "screen.type" -> type(svc, params)
+        "screen.key" -> key(svc, params)
+        "screen.shot" -> shot(svc)
+        "screen.launch" -> launch(ctx, params)
+        else -> throw OmalawnError("unknown_method", "unknown method $method")
+    }
+
+    // -- status ----------------------------------------------------------------------------
+
+    private fun status(ctx: Context) = JSONObject()
+        .put("enabled", LawnchairAccessibilityService.current != null)
+        .put("restricted", restricted(ctx) ?: JSONObject.NULL)
+
+    /**
+     * Whether Android's "restricted settings" would stop the user from turning the service on,
+     * read from the app op behind App info › ⋮ › "Allow restricted settings": errored → true,
+     * explicitly allowed → false. Never touched: false on Android 13–14 (they mark untrusted
+     * installs errored); null on 15+, where Enhanced Confirmation judges the install source, which
+     * an app cannot ask.
+     */
+    private fun restricted(ctx: Context): Boolean? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return false
+        return try {
+            val ops = ctx.getSystemService(AppOpsManager::class.java)!!
+            when (ops.unsafeCheckOpRawNoThrow(OP_RESTRICTED, Process.myUid(), ctx.packageName)) {
+                AppOpsManager.MODE_ERRORED, AppOpsManager.MODE_IGNORED -> true
+                AppOpsManager.MODE_ALLOWED -> false
+                else -> if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.VANILLA_ICE_CREAM) null else false
+            }
+        } catch (_: Exception) {
+            null
+        }
+    }
+
+    private const val OP_RESTRICTED = "android:access_restricted_settings"
+
+    // -- tree ------------------------------------------------------------------------------
+
+    private fun tree(svc: AccessibilityService): JSONObject {
+        // the service takes no events, so the platform's node cache would go stale between calls
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) svc.clearCache()
+        // while an app opens or closes there is no active window for a moment
+        var root: AccessibilityNodeInfo? = null
+        for (i in 0 until ROOT_TRIES) {
+            root = svc.rootInActiveWindow ?: appWindowRoot(svc)
+            if (root != null) break
+            Thread.sleep(ROOT_RETRY_MS)
+        }
+        if (root == null) throw OmalawnError(NO_WINDOW, "$NO_WINDOW: no window to read (is the screen off or locked?)")
+        val kept = ArrayList<AccessibilityNodeInfo>()
+        val out = JSONArray()
+        walk(root, 0, 0, kept, out)
+        nodes = kept
+        return JSONObject()
+            .put("package", root.packageName?.toString() ?: JSONObject.NULL)
+            .put("nodes", out)
+            .put("truncated", kept.size >= MAX_NODES)
+    }
+
+    private fun appWindowRoot(svc: AccessibilityService): AccessibilityNodeInfo? =
+        svc.windows.firstOrNull { it.type == AccessibilityWindowInfo.TYPE_APPLICATION && it.isActive }?.root
+            ?: svc.windows.firstOrNull { it.type == AccessibilityWindowInfo.TYPE_APPLICATION }?.root
+
+    /** Depth-first; [depth] counts kept ancestors only, so the computer can indent the list. */
+    private fun walk(n: AccessibilityNodeInfo, level: Int, depth: Int, kept: MutableList<AccessibilityNodeInfo>, out: JSONArray) {
+        if (kept.size >= MAX_NODES || level > MAX_DEPTH || !n.isVisibleToUser) return
+        val text = n.text?.toString()?.takeIf { it.isNotBlank() }
+        val desc = n.contentDescription?.toString()?.takeIf { it.isNotBlank() }
+        val keep = text != null || desc != null || n.isClickable || n.isEditable || n.isScrollable || n.isCheckable
+        var childDepth = depth
+        if (keep) {
+            val r = Rect().also { n.getBoundsInScreen(it) }
+            val o = JSONObject()
+                .put("id", "n${kept.size}")
+                .put("class", n.className?.toString()?.substringAfterLast('.') ?: "")
+                .put("bounds", JSONArray(listOf(r.left, r.top, r.right, r.bottom)))
+                .put("click", n.isClickable)
+                .put("focus", n.isFocused)
+                .put("edit", n.isEditable)
+                .put("scroll", n.isScrollable)
+                .put("depth", depth)
+            if (text != null) o.put("text", text)
+            if (desc != null) o.put("desc", desc)
+            if (n.isCheckable) o.put("checkable", true).put("checked", n.isChecked)
+            kept.add(n)
+            out.put(o)
+            childDepth = depth + 1
+        }
+        for (i in 0 until n.childCount) {
+            val c = n.getChild(i) ?: continue
+            walk(c, level + 1, childDepth, kept, out)
+        }
+    }
+
+    private fun node(params: JSONObject): AccessibilityNodeInfo {
+        val id = params.optString("node")
+        val i = id.removePrefix("n").toIntOrNull()
+        val n = i?.let { nodes.getOrNull(it) }
+            ?: throw OmalawnError(STALE_NODE, "$STALE_NODE: no node $id in the last screen.tree; read the tree again")
+        if (!n.refresh()) throw OmalawnError(STALE_NODE, "$STALE_NODE: node $id is gone from the screen; read the tree again")
+        return n
+    }
+
+    // -- gestures --------------------------------------------------------------------------
+
+    private fun screenSize(ctx: Context): Point {
+        val p = Point()
+        @Suppress("DEPRECATION")
+        ctx.getSystemService(DisplayManager::class.java)!!.getDisplay(Display.DEFAULT_DISPLAY).getRealSize(p)
+        return p
+    }
+
+    /** {x, y} or {node}: a node is tapped at the centre of its part that is on the screen. */
+    private fun point(ctx: Context, params: JSONObject): Pair<Float, Float> {
+        if (params.has("node") && !params.isNull("node")) {
+            val r = Rect().also { node(params).getBoundsInScreen(it) }
+            val size = screenSize(ctx)
+            if (!r.intersect(0, 0, size.x, size.y) || r.isEmpty) {
+                throw OmalawnError(STALE_NODE, "$STALE_NODE: node ${params.optString("node")} is not on the screen")
+            }
+            return r.exactCenterX() to r.exactCenterY()
+        }
+        return coords(ctx, params, "x", "y")
+    }
+
+    private fun coords(ctx: Context, params: JSONObject, kx: String, ky: String): Pair<Float, Float> {
+        val x = number(params, kx)
+        val y = number(params, ky)
+        val size = screenSize(ctx)
+        if (x < 0 || y < 0 || x >= size.x || y >= size.y) {
+            throw OmalawnError(BAD_PARAMS, "$BAD_PARAMS: ($kx, $ky) = (${x.toInt()}, ${y.toInt()}) is off the ${size.x}x${size.y} screen")
+        }
+        return x.toFloat() to y.toFloat()
+    }
+
+    private fun number(params: JSONObject, k: String): Double {
+        val v = params.opt(k)
+        val d = when (v) {
+            is Number -> v.toDouble()
+            is String -> v.toDoubleOrNull()
+            else -> null
+        }
+        if (d == null || d.isNaN() || d.isInfinite()) throw OmalawnError(BAD_PARAMS, "$BAD_PARAMS: $k must be a number")
+        return d
+    }
+
+    private fun ms(params: JSONObject, default: Long): Long {
+        if (!params.has("ms") || params.isNull("ms")) return default
+        val v = number(params, "ms").toLong()
+        if (v < 1 || v > MAX_GESTURE_MS) throw OmalawnError(BAD_PARAMS, "$BAD_PARAMS: ms must be 1..$MAX_GESTURE_MS")
+        return v
+    }
+
+    private fun gesture(svc: AccessibilityService, path: Path, ms: Long) {
+        val g = GestureDescription.Builder()
+            .addStroke(GestureDescription.StrokeDescription(path, 0, ms))
+            .build()
+        val done = CountDownLatch(1)
+        var completed = false
+        val cb = object : AccessibilityService.GestureResultCallback() {
+            override fun onCompleted(gestureDescription: GestureDescription?) {
+                completed = true
+                done.countDown()
+            }
+
+            override fun onCancelled(gestureDescription: GestureDescription?) {
+                done.countDown()
+            }
+        }
+        if (!svc.dispatchGesture(g, cb, null)) {
+            throw OmalawnError(GESTURE_FAILED, "$GESTURE_FAILED: Android refused the gesture")
+        }
+        if (!done.await(ms + 5_000, TimeUnit.MILLISECONDS)) {
+            throw OmalawnError(GESTURE_FAILED, "$GESTURE_FAILED: the gesture did not finish")
+        }
+        if (!completed) throw OmalawnError(GESTURE_FAILED, "$GESTURE_FAILED: the gesture was cancelled (a touch on the phone, or the screen changed)")
+    }
+
+    // -- text and keys ---------------------------------------------------------------------
+
+    private fun type(svc: AccessibilityService, params: JSONObject): JSONObject {
+        if (!params.has("text") || params.isNull("text")) throw OmalawnError(BAD_PARAMS, "$BAD_PARAMS: text required")
+        val text = params.get("text").toString()
+        if (text.length > MAX_TEXT) throw OmalawnError(BAD_PARAMS, "$BAD_PARAMS: text longer than $MAX_TEXT characters")
+        val target = if (params.has("node") && !params.isNull("node")) {
+            node(params)
+        } else {
+            svc.findFocus(AccessibilityNodeInfo.FOCUS_INPUT)
+                ?: throw OmalawnError(NOT_EDITABLE, "$NOT_EDITABLE: no text field has the focus; tap one first or pass node")
+        }
+        if (!target.isEditable) throw OmalawnError(NOT_EDITABLE, "$NOT_EDITABLE: that node is not a text field")
+        val args = Bundle().apply {
+            putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, text)
+        }
+        // a field that has only just appeared may refuse once; ask again with fresh node state
+        if (!target.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args)) {
+            Thread.sleep(250)
+            if (!target.refresh() || !target.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args)) {
+                throw OmalawnError(NOT_EDITABLE, "$NOT_EDITABLE: the text field refused the text")
+            }
+        }
+        return JSONObject().put("typed", text.length)
+    }
+
+    private fun key(svc: AccessibilityService, params: JSONObject): JSONObject {
+        val name = params.optString("name")
+        val action = KEYS[name]
+            ?: throw OmalawnError(BAD_PARAMS, "$BAD_PARAMS: key must be one of ${KEYS.keys.joinToString()}")
+        if (!svc.performGlobalAction(action)) throw OmalawnError(GESTURE_FAILED, "$GESTURE_FAILED: Android refused the $name key")
+        return JSONObject().put("key", name)
+    }
+
+    // -- screenshot ------------------------------------------------------------------------
+
+    private fun shot(svc: AccessibilityService): Blob {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+            throw OmalawnError(SHOT_FAILED, "$SHOT_FAILED: screenshots need Android 11 or newer")
+        }
+        val now = SystemClock.elapsedRealtime()
+        val wait = lastShot + SHOT_INTERVAL_MS - now
+        if (lastShot != 0L && wait > 0) {
+            throw OmalawnError(RATE_LIMITED, "$RATE_LIMITED: at most one screenshot every $SHOT_INTERVAL_MS ms; try again in $wait ms")
+        }
+        lastShot = now
+        val done = CountDownLatch(1)
+        var png: ByteArray? = null
+        var w = 0
+        var h = 0
+        var failure: OmalawnError? = null
+        svc.takeScreenshot(
+            Display.DEFAULT_DISPLAY,
+            shotExecutor,
+            object : AccessibilityService.TakeScreenshotCallback {
+                override fun onSuccess(result: AccessibilityService.ScreenshotResult) {
+                    try {
+                        val hb = result.hardwareBuffer
+                        val bmp = try {
+                            Bitmap.wrapHardwareBuffer(hb, result.colorSpace)?.copy(Bitmap.Config.ARGB_8888, false)
+                        } finally {
+                            hb.close()
+                        }
+                        if (bmp == null) {
+                            failure = OmalawnError(SHOT_FAILED, "$SHOT_FAILED: the screenshot could not be read")
+                        } else {
+                            w = bmp.width
+                            h = bmp.height
+                            png = ByteArrayOutputStream().also { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) }.toByteArray()
+                            bmp.recycle()
+                        }
+                    } catch (e: Throwable) {
+                        failure = OmalawnError(SHOT_FAILED, "$SHOT_FAILED: ${e.javaClass.simpleName}: ${e.message}")
+                    } finally {
+                        done.countDown()
+                    }
+                }
+
+                override fun onFailure(errorCode: Int) {
+                    failure = when (errorCode) {
+                        AccessibilityService.ERROR_TAKE_SCREENSHOT_INTERVAL_TIME_SHORT ->
+                            OmalawnError(RATE_LIMITED, "$RATE_LIMITED: Android allows about three screenshots a second; try again shortly")
+                        AccessibilityService.ERROR_TAKE_SCREENSHOT_SECURE_WINDOW ->
+                            OmalawnError(SHOT_FAILED, "$SHOT_FAILED: the app on screen does not allow screenshots")
+                        else -> OmalawnError(SHOT_FAILED, "$SHOT_FAILED: Android refused the screenshot (error $errorCode)")
+                    }
+                    done.countDown()
+                }
+            },
+        )
+        if (!done.await(10, TimeUnit.SECONDS)) throw OmalawnError(SHOT_FAILED, "$SHOT_FAILED: no screenshot within 10 s")
+        failure?.let { throw it }
+        return Blob(png!!, JSONObject().put("width", w).put("height", h).put("format", "png"))
+    }
+
+    // -- apps ------------------------------------------------------------------------------
+
+    private fun launch(ctx: Context, params: JSONObject): JSONObject {
+        val pkg = params.optString("package")
+        if (!PACKAGE.matches(pkg)) throw OmalawnError(BAD_PARAMS, "$BAD_PARAMS: package must be a package name like com.android.settings")
+        val i = ctx.packageManager.getLaunchIntentForPackage(pkg)
+            ?: throw OmalawnError(NOT_FOUND, "$NOT_FOUND: $pkg is not installed or has nothing to open")
+        i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED)
+        ctx.startActivity(i)
+        return JSONObject().put("package", pkg).put("activity", i.component?.className ?: JSONObject.NULL)
+    }
+}
