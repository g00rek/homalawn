diff --git a/lawnchair/src/app/lawnchair/omalawn/MediaPermission.kt b/lawnchair/src/app/lawnchair/omalawn/MediaPermission.kt
new file mode 100644
index 0000000000..f7b19c57cc
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/omalawn/MediaPermission.kt
@@ -0,0 +1,143 @@
+package app.lawnchair.omalawn
+
+import android.Manifest
+import android.app.Activity
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.WallpaperManager
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import android.os.Bundle
+import android.os.SystemClock
+import android.provider.Settings
+import androidx.core.app.NotificationCompat
+import app.lawnchair.omalawn.link.NotifyPermission
+import org.json.JSONObject
+
+/**
+ * Android lets an app read the current wallpaper (for a backup before it is replaced) only with a
+ * storage permission Lawnchair never asks for. `launcher.request_media_permission` asks for it the
+ * only way a request from a computer may: a notification, whose tap opens the system permission
+ * prompt through [MediaPermissionActivity]. Nothing pops up by itself.
+ *
+ * Which permission: the wallpaper service checks READ_EXTERNAL_STORAGE (plus the photo app op), or
+ * "All files access". Android 13+ never grants READ_EXTERNAL_STORAGE to an app that targets 13+
+ * (Lawnchair targets 35): its prompt answers "denied" without showing anything, and the photo
+ * permission it does show is not enough (checked on API 35). There the request answers
+ * `why: not_grantable` and posts nothing; the prompt path is for Android 12 and older.
+ */
+object MediaPermission {
+    private const val CHANNEL = "omalawn_requests"
+    private const val NOTIFICATION_ID = 47102
+    const val REQUEST_CODE = 47102
+    const val EXTRA_PERMISSION = "permission"
+
+    /** What the trampoline may ask for (the debug hook proves the path with the photo permission). */
+    val ASKABLE = setOf(Manifest.permission.READ_EXTERNAL_STORAGE, Manifest.permission.READ_MEDIA_IMAGES)
+
+    /** The real test: can Lawnchair open the current wallpaper right now? */
+    fun canReadWallpaper(ctx: Context): Boolean = try {
+        WallpaperManager.getInstance(ctx).getWallpaperFile(WallpaperManager.FLAG_SYSTEM)?.close()
+        true
+    } catch (_: SecurityException) {
+        false
+    }
+
+    /** The permission whose prompt makes the wallpaper readable, or null when no prompt can. */
+    private fun promptable(ctx: Context): String? =
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU || ctx.applicationInfo.targetSdkVersion < Build.VERSION_CODES.TIRAMISU) {
+            Manifest.permission.READ_EXTERNAL_STORAGE
+        } else {
+            null
+        }
+
+    /**
+     * {granted, asked[, why]}: asked is true when the notification is now on the phone. [force]
+     * (debug hook only) posts the prompt for [force] even where it cannot unlock the wallpaper.
+     */
+    fun request(ctx: Context, force: String? = null): JSONObject {
+        if (force == null && canReadWallpaper(ctx)) {
+            cancel(ctx)
+            return JSONObject().put("granted", true).put("asked", false)
+        }
+        val perm = force ?: promptable(ctx)
+            ?: return JSONObject().put("granted", false).put("asked", false).put("why", "not_grantable")
+        if (force == null && ctx.checkSelfPermission(perm) == PackageManager.PERMISSION_GRANTED) {
+            // granted and still unreadable: another prompt would change nothing
+            return JSONObject().put("granted", false).put("asked", false).put("why", "not_grantable")
+        }
+        if (NotifyPermission.missing(ctx)) {
+            NotifyPermission.neededNow(ctx) // the launcher asks for notifications when it next comes up
+            return JSONObject().put("granted", false).put("asked", false).put("why", "notifications_off")
+        }
+        val nm = ctx.getSystemService(NotificationManager::class.java)!!
+        nm.createNotificationChannel(
+            NotificationChannel(CHANNEL, "Homa Lawn requests", NotificationManager.IMPORTANCE_DEFAULT).apply {
+                description = "Permissions Homa Lawn on your computer needs from you"
+            },
+        )
+        val tap = PendingIntent.getActivity(
+            ctx,
+            REQUEST_CODE,
+            Intent(ctx, MediaPermissionActivity::class.java)
+                .putExtra(EXTRA_PERMISSION, perm)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_NO_HISTORY or Intent.FLAG_ACTIVITY_EXCLUDE_FROM_RECENTS),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+        val n = NotificationCompat.Builder(ctx, CHANNEL)
+            .setSmallIcon(android.R.drawable.ic_menu_gallery)
+            .setContentTitle("Homa Lawn needs access to photos to back up your wallpaper")
+            .setContentText("Tap to allow. Homa Lawn uses it only to read the current wallpaper.")
+            .setContentIntent(tap)
+            .setAutoCancel(true)
+            .setOnlyAlertOnce(true)
+            .build()
+        nm.notify(NOTIFICATION_ID, n)
+        return JSONObject().put("granted", false).put("asked", true)
+    }
+
+    fun cancel(ctx: Context) {
+        ctx.getSystemService(NotificationManager::class.java)?.cancel(NOTIFICATION_ID)
+    }
+}
+
+/**
+ * Invisible, not exported: opened only by [MediaPermission]'s notification. Shows the system
+ * prompt; when Android no longer shows it (denied for good), opens Lawnchair's App info instead.
+ */
+class MediaPermissionActivity : Activity() {
+    private var askedAt = 0L
+    private var perm: String? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val p = intent.getStringExtra(MediaPermission.EXTRA_PERMISSION)?.takeIf { it in MediaPermission.ASKABLE }
+        if (p == null || checkSelfPermission(p) == PackageManager.PERMISSION_GRANTED && MediaPermission.canReadWallpaper(this)) {
+            MediaPermission.cancel(this)
+            finish()
+            return
+        }
+        perm = p
+        askedAt = SystemClock.elapsedRealtime()
+        requestPermissions(arrayOf(p), MediaPermission.REQUEST_CODE)
+    }
+
+    override fun onRequestPermissionsResult(requestCode: Int, permissions: Array<out String>, grantResults: IntArray) {
+        super.onRequestPermissionsResult(requestCode, permissions, grantResults)
+        val p = perm
+        if (p != null && checkSelfPermission(p) == PackageManager.PERMISSION_GRANTED) {
+            MediaPermission.cancel(this)
+        } else if (SystemClock.elapsedRealtime() - askedAt < 400) {
+            // answered at once: Android did not show the prompt, so only App info can grant it now
+            startActivity(
+                Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.fromParts("package", packageName, null))
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+            )
+        }
+        finish()
+    }
+}
