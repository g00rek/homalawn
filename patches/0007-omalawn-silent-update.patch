 object OmalawnUpdate {
     const val NOT_OURS = "not_ours"
@@ -54,6 +68,32 @@ object OmalawnUpdate {
 
     private val lock = Any()
 
+    /** Debug hook: the next sessions ask for the user (to drive the fallback on a device). */
+    @Volatile var forceUserAction = false
+
+    /** A written session waiting for the link's answer to go out before it is committed. */
+    private class PendingCommit(
+        val id: Int,
+        val sha: String,
+        val version: String,
+        val computer: String,
+        val predictedSilent: Boolean,
+    )
+    private var pendingCommit: PendingCommit? = null
+
+    /**
+     * How long a committed session may stay undecided. Google Play Protect can hold a silent
+     * install of a build it does not know indefinitely (no screen to ask on); then the session is
+     * abandoned and the notification offers the installer the old way, where Play Protect asks.
+     */
+    const val STUCK_MS = 45_000L
+    private val givenUp = mutableSetOf<Int>() // sessions abandoned as stuck: their late status is not news
+    private val decided = mutableSetOf<Int>() // sessions Android answered (any status): never stuck
+    const val EXTRA_PREDICTED_SILENT = "predicted_silent"
+
+    /** What [check] found in the offered APK. */
+    private class Checked(val versionCode: Long, val versionName: String, val targetSdk: Int)
+
     fun authority(ctx: Context) = "${ctx.packageName}.omalawn.update"
 
     private fun dir(ctx: Context): File {
@@ -109,25 +149,42 @@ object OmalawnUpdate {
             // only the newest checked update stays
             apk.parentFile?.listFiles()?.filter { it.name.startsWith(PREFIX) && it != apk }?.forEach { it.delete() }
             val canInstall = ctx.packageManager.canRequestPackageInstalls()
-            val notified = notify(ctx, sha, info.second, computer, canInstall)
