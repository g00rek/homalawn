                 .putExtra(UpdateInstallActivity.EXTRA_VERSION, version)
                 .putExtra(UpdateInstallActivity.EXTRA_COMPUTER, computer)
+                .apply { if (confirm != null) putExtra(UpdateInstallActivity.EXTRA_CONFIRM, confirm) }
                 // every tap starts afresh: a left-behind "Install unknown apps" page is not brought back
                 .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK),
-            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            // CANCEL_CURRENT, not UPDATE_CURRENT: an update keeps a live record's old intent flags
+            // (seen on the AVD: a record without CLEAR_TASK brought a left-behind settings page
+            // back) and only swaps extras; the notification is replaced together with it anyway
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_CANCEL_CURRENT,
         )
-        val text = notificationText(version, canInstall)
+        val body = text ?: notificationText(version, canInstall)
         val n = NotificationCompat.Builder(ctx, CHANNEL)
             .setSmallIcon(R.drawable.ic_home_screen)
             .setContentTitle("Homa Lawn update from ${computer.ifEmpty { "your computer" }}")
-            .setContentText(text)
+            .setContentText(body)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(body))
             .setPriority(NotificationCompat.PRIORITY_HIGH)
             .setContentIntent(tap)
             .setGroup(GROUP)
@@ -217,7 +402,12 @@ object OmalawnUpdate {
     /** After this app was replaced: the offered file and its notification are done. */
     fun afterUpdate(ctx: Context) {
         runCatching {
-            synchronized(lock) { dir(ctx).listFiles()?.forEach { it.delete() } }
+            synchronized(lock) {
+                pendingCommit = null
+                dir(ctx).listFiles()?.forEach { it.delete() }
+            }
+            val installer = ctx.packageManager.packageInstaller
+            installer.mySessions.forEach { runCatching { installer.abandonSession(it.sessionId) } }
             ctx.getSystemService(NotificationManager::class.java)?.cancel(NOTIFICATION_TAG, NOTIFICATION_ID)
         }
     }
@@ -275,6 +465,19 @@ class UpdateInstallActivity : Activity() {
     override fun onCreate(savedInstanceState: Bundle?) {
         super.onCreate(savedInstanceState)
         if (savedInstanceState != null) return // back from the settings page: onActivityResult continues
+        val confirm = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            intent.getParcelableExtra(EXTRA_CONFIRM, Intent::class.java)
+        } else {
+            @Suppress("DEPRECATION")
+            intent.getParcelableExtra(EXTRA_CONFIRM)
+        }
+        if (confirm != null) {
+            // Android's own confirmation for the session that could not install by itself
+            val started = runCatching { startActivity(confirm.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) }.isSuccess
+            if (!started) install() // the session is gone: the installer the old way
+            else finish()
+            return
+        }
         if (packageManager.canRequestPackageInstalls()) {
             refreshNotification()
             install()
@@ -333,6 +536,52 @@ class UpdateInstallActivity : Activity() {
         const val EXTRA_SHA = "sha256"
         const val EXTRA_VERSION = "version"
         const val EXTRA_COMPUTER = "computer"
+        const val EXTRA_CONFIRM = "confirm"
         private const val REQ_SOURCES = 1
     }
 }
+
+/** The outcome of [OmalawnUpdate]'s install session (not exported; the installer fills the status). */
+class UpdateResultReceiver : BroadcastReceiver() {
+    override fun onReceive(ctx: Context, intent: Intent) {
+        val status = intent.getIntExtra(PackageInstaller.EXTRA_STATUS, PackageInstaller.STATUS_FAILURE)
+        val sha = intent.getStringExtra(UpdateInstallActivity.EXTRA_SHA) ?: return
+        val version = intent.getStringExtra(UpdateInstallActivity.EXTRA_VERSION) ?: ""
+        val computer = intent.getStringExtra(UpdateInstallActivity.EXTRA_COMPUTER) ?: ""
+        val id = intent.getIntExtra(PackageInstaller.EXTRA_SESSION_ID, -1)
+        val predicted = intent.getBooleanExtra(OmalawnUpdate.EXTRA_PREDICTED_SILENT, false)
+        val outcome = when (status) {
+            PackageInstaller.STATUS_SUCCESS -> "installed"
+            PackageInstaller.STATUS_PENDING_USER_ACTION -> "pending_user_action"
+            else -> "failed"
+        }
+        // a wrong silentAllowed prediction shows here (e.g. a new Android or a vendor policy)
+        // (a success after the person confirmed is expected when not predicted: not flagged)
+        val mismatch = status == PackageInstaller.STATUS_PENDING_USER_ACTION && predicted
+        Log.i(
+            "OmalawnUpdate",
+            "install session $id outcome=$outcome status=$status predicted_silent=$predicted" +
+                (if (mismatch) " PREDICTION_MISMATCH" else "") + " version=$version sdk=${Build.VERSION.SDK_INT}",
+        )
+        if (!OmalawnUpdate.answered(id) && status != PackageInstaller.STATUS_SUCCESS) return
+        when (status) {
+            PackageInstaller.STATUS_PENDING_USER_ACTION -> {
+                val confirm = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                    intent.getParcelableExtra(Intent.EXTRA_INTENT, Intent::class.java)
+                } else {
+                    @Suppress("DEPRECATION")
+                    intent.getParcelableExtra(Intent.EXTRA_INTENT)
+                }
+                OmalawnUpdate.needsUser(ctx, sha, version, computer, confirm)
+            }
+            PackageInstaller.STATUS_SUCCESS -> OmalawnUpdate.afterUpdate(ctx)
+            else -> OmalawnUpdate.failed(
+                ctx,
+                sha,
+                version,
+                computer,
+                intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE) ?: "status $status",
+            )
+        }
+    }
+}
