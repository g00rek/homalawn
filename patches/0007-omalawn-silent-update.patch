-    /** (versionCode, versionName) of [apk] when it may replace this app; refuses otherwise. */
-    private fun check(ctx: Context, apk: File): Pair<Long, String> {
+    /** What [apk] is when it may replace this app; refuses otherwise. */
+    private fun check(ctx: Context, apk: File): Checked {
         val pm = ctx.packageManager
         @Suppress("DEPRECATION")
         val flags = PackageManager.GET_SIGNING_CERTIFICATES or PackageManager.GET_SIGNATURES
@@ -144,7 +201,128 @@ object OmalawnUpdate {
         if (archive.longVersionCode < installed) {
             throw OmalawnError(OLDER, "$OLDER: this APK (${archive.longVersionCode}) is older than the installed one ($installed)")
         }
-        return archive.longVersionCode to (archive.versionName ?: "")
+        return Checked(archive.longVersionCode, archive.versionName ?: "", archive.applicationInfo?.targetSdkVersion ?: 0)
+    }
+
+    /**
+     * Whether Android installs an update without the user for an app targeting [targetSdk] on
+     * [sdk] (PackageInstaller.SessionParams.setRequireUserAction: 29 on 12, 30 on 13, 31 on 14,
+     * 33 on 15; later releases "will advance" — assumed here to stay two behind, as 15 is).
+     */
+    fun silentAllowed(sdk: Int, targetSdk: Int): Boolean = when {
+        sdk < Build.VERSION_CODES.S -> false
+        sdk <= Build.VERSION_CODES.S_V2 -> targetSdk >= 29
+        sdk == Build.VERSION_CODES.TIRAMISU -> targetSdk >= 30
+        sdk == Build.VERSION_CODES.UPSIDE_DOWN_CAKE -> targetSdk >= 31
+        sdk == 35 -> targetSdk >= 33
+        else -> targetSdk >= sdk - 2
+    }
+
+    /**
+     * Writes [apk] into a new install session of this app (abandoning older ones) and keeps it for
+     * [commitPending]. True when Android's rule lets it install without the user.
+     */
+    private fun prepareSession(ctx: Context, apk: File, sha: String, info: Checked, computer: String): Boolean {
+        val installer = ctx.packageManager.packageInstaller
+        installer.mySessions.forEach { runCatching { installer.abandonSession(it.sessionId) } }
+        val requireUser = forceUserAction
+        val params = PackageInstaller.SessionParams(PackageInstaller.SessionParams.MODE_FULL_INSTALL).apply {
+            setAppPackageName(ctx.packageName)
+            setSize(apk.length())
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                setRequireUserAction(
+                    if (requireUser) {
+                        PackageInstaller.SessionParams.USER_ACTION_REQUIRED
+                    } else {
+                        PackageInstaller.SessionParams.USER_ACTION_NOT_REQUIRED
+                    },
+                )
+            }
+        }
+        val id = installer.createSession(params)
+        try {
+            installer.openSession(id).use { s ->
+                s.openWrite("base.apk", 0, apk.length()).use { out ->
+                    apk.inputStream().use { it.copyTo(out, 1 shl 16) }
+                    s.fsync(out)
+                }
+            }
+        } catch (e: Exception) {
+            runCatching { installer.abandonSession(id) }
+            throw e
+        }
+        val predicted = !requireUser && silentAllowed(Build.VERSION.SDK_INT, info.targetSdk)
+        pendingCommit = PendingCommit(id, sha, info.versionName, computer, predicted)
+        return predicted
+    }
+
+    /**
+     * Commits the session [offer] prepared, after the link answered (a silent install replaces this
+     * process). Its outcome arrives at [UpdateResultReceiver].
+     */
+    fun commitPending(ctx: Context) {
+        val p = synchronized(lock) { pendingCommit.also { pendingCommit = null } } ?: return
+        val installer = ctx.packageManager.packageInstaller
+        try {
+            val result = PendingIntent.getBroadcast(
+                ctx,
+                p.id,
+                Intent(ctx, UpdateResultReceiver::class.java)
+                    .putExtra(UpdateInstallActivity.EXTRA_SHA, p.sha)
+                    .putExtra(UpdateInstallActivity.EXTRA_VERSION, p.version)
+                    .putExtra(UpdateInstallActivity.EXTRA_COMPUTER, p.computer)
+                    .putExtra(EXTRA_PREDICTED_SILENT, p.predictedSilent),
+                // the installer fills in the status: mutable (explicit intent, so allowed)
+                PendingIntent.FLAG_MUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            )
+            installer.openSession(p.id).use { it.commit(result.intentSender) }
+            Log.i(TAG, "install session ${p.id} committed (${p.version})")
+            Handler(Looper.getMainLooper()).postDelayed({ giveUpIfStuck(ctx, p) }, STUCK_MS)
+        } catch (e: Exception) {
+            Log.w(TAG, "install session ${p.id} could not be committed", e)
+            runCatching { installer.abandonSession(p.id) }
+            failed(ctx, p.sha, p.version, p.computer, "${e.javaClass.simpleName}: ${e.message}")
+        }
+    }
+
+    private fun giveUpIfStuck(ctx: Context, p: PendingCommit) {
+        val installer = ctx.packageManager.packageInstaller
+        // Android answered (a pending user action included: that session waits for the tap)
+        if (synchronized(lock) { p.id in decided }) return
+        if (installer.getSessionInfo(p.id) == null) return // gone meanwhile
+        Log.w(TAG, "install session ${p.id} undecided after ${STUCK_MS / 1000} s, abandoning it")
+        synchronized(lock) { givenUp.add(p.id) }
+        runCatching { installer.abandonSession(p.id) }
+        failed(ctx, p.sha, p.version, p.computer, "Android is still checking it, likely Google Play Protect")
+    }
+
+    /**
+     * Records that Android answered session [sessionId] (so [giveUpIfStuck] leaves it alone). False
+     * for the status of a session [giveUpIfStuck] abandoned (its notification is up already).
+     */
+    fun answered(sessionId: Int): Boolean = synchronized(lock) {
+        decided.add(sessionId)
+        !givenUp.remove(sessionId)
+    }
+
+    /** Android wants the user for the session: the notification, whose tap opens [confirm]. */
+    fun needsUser(ctx: Context, sha: String, version: String, computer: String, confirm: Intent?) {
+        if (pending(ctx, sha) == null) return
+        notify(ctx, sha, version, computer, ctx.packageManager.canRequestPackageInstalls(), confirm = confirm)
+    }
+
+    /** The session failed: a notification with the reason; its tap opens the installer the old way. */
+    fun failed(ctx: Context, sha: String, version: String, computer: String, reason: String) {
+        if (pending(ctx, sha) == null) return
+        Log.w(TAG, "update $version not installed: $reason")
+        notify(
+            ctx,
+            sha,
+            version,
+            computer,
+            ctx.packageManager.canRequestPackageInstalls(),
+            text = "Version $version did not install by itself (${reason.take(120)}). Tap, then Update.",
+        )
     }
 
     /** The checked update waiting for its tap, or null. */
@@ -169,6 +347,8 @@ object OmalawnUpdate {
